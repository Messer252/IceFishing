      <Item class="ModuleScript" referent="RBX24">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Progression = require(ReplicatedStorage.Shared.Progression)
local Settings = require(script.Parent.ServerSettings)
local Schema = require(script.Parent.ProfileSchema).create(Config, Progression)
local PlayerStore = require(script.Parent.PlayerStore)
local Service = {}
local sandbox = RunService:IsStudio() and not Settings.StudioPersistence
if RunService:IsStudio() and Settings.StudioPersistence then
    assert(Settings.StudioStoreName ~= Settings.LiveStoreName, "Studio must use its separate test DataStore name.")
end
local storage = not sandbox and DataStoreService:GetDataStore(RunService:IsStudio() and Settings.StudioStoreName or Settings.LiveStoreName) or nil
local store = not sandbox and PlayerStore.new({
    store = storage, schema = Schema, clock = os.time, wait = task.wait, spawn = task.spawn,
    token = game.JobId .. ":" .. HttpService:GenerateGUID(false),
    autosaveSeconds = Settings.AutosaveSeconds, leaseSeconds = Settings.LeaseSeconds,
    onLost = function(id)
        local player = Players:GetPlayerByUserId(id)
        if player then player:SetAttribute("ProfileReady", false) player:Kick("Your saved session could not be kept safe. Please rejoin.") end
    end,
    onError = function(id, reason)
        if reason == "ownership" then warn("[PlayerData] Final save refused for " .. id .. ": ownership expired or changed; stored data was protected.")
        else warn("[PlayerData] Save delayed for user " .. id .. "; retrying before the session lease expires.") end
    end,
}) or nil

function Service.load(player)
    if sandbox then
        player:SetAttribute("DataMode", "Studio sandbox · not saved")
        return Schema.new()
    end
    player:SetAttribute("DataMode", RunService:IsStudio() and "Studio test saves" or "Saved progression")
    local profile, problem = store:load(player.UserId)
    if not profile then return nil, problem end
    return profile
end
function Service.release(player)
    if sandbox then return true end
    local ok, problem = store:release(player.UserId)
    if not ok then warn("[PlayerData] Final save failed for " .. player.UserId .. ": " .. tostring(problem)) end
    return ok
end
function Service.step() if store then store:step() end end
function Service.shutdown() if store and not store:shutdown() then warn("[PlayerData] Some profiles could not finish saving before shutdown.") end end
return Service
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX25">
        <Properties>
          <string name="Name">PlayerStore</string>
          <ProtectedString name="Source">-- Storage orchestration is independent of Roblox for fault-injection tests.
local PlayerStore = {}
PlayerStore.__index = PlayerStore

function PlayerStore.new(options)
    return setmetatable({ options = options, entries = {}, loading = {}, failedFinals = {}, writes = 0, closing = false }, PlayerStore)
end

function PlayerStore:_update(id, transform)
    local lastError
    for attempt = 1, 3 do
        local ok, result = pcall(function() return self.options.store:UpdateAsync("player_" .. id, transform) end)
        if ok then return true, result end
        lastError = tostring(result)
        if attempt &lt; 3 then self.options.wait(attempt) end
    end
    return false, lastError
end

function PlayerStore:load(id)
    if self.closing or self.entries[id] or self.loading[id] then return nil, "Profile is already active or server is closing." end
    self.loading[id] = true
    local o, reason = self.options, nil
    local ok, record = self:_update(id, function(old)
        reason = nil
        if old ~= nil and (type(old) ~= "table" or (type(old.version) ~= "number" or old.version % 1 ~= 0 or old.version &lt; 1 or old.version &gt; o.schema.version)) then
            reason = "Unsupported saved profile. No data was overwritten." return nil
        end
        local lease = old and old.lease
        if lease ~= nil and (type(lease) ~= "table" or type(lease.expires) ~= "number" or lease.expires ~= lease.expires
            or math.abs(lease.expires) == math.huge or type(lease.token) ~= "string") then
            reason = "Invalid saved session. No data was overwritten." return nil
        end
        if lease and lease.token ~= o.token and lease.expires &gt; o.clock() then
            reason = "Your previous session is still saving. Please rejoin shortly." return nil
        end
        local data, problem
        if old then data, problem = o.schema.migrate(old.data) else data = o.schema.new() end
        if not data then reason = "Saved profile could not be loaded: " .. tostring(problem) return nil end
        return { version = o.schema.version, data = data, lease = { token = o.token, expires = o.clock() + o.leaseSeconds } }
    end)
    self.loading[id] = nil
    if not ok then return nil, "Saving service is unavailable. Please rejoin later." end
    if not record or not record.lease or record.lease.token ~= o.token then return nil, reason or "Profile is busy. Please rejoin." end
    if self.closing then
        self.entries[id] = { data = record.data, leaseUntil = record.lease.expires, nextSave = 0 }
        self:release(id)
        return nil, "Server is closing. Please rejoin."
    end
    self.entries[id] = { data = record.data, leaseUntil = record.lease.expires,
        nextSave = o.clock() + o.autosaveSeconds + id % 11 }
    self.failedFinals[id] = nil
    return record.data
end

function PlayerStore:save(id, release)
    local entry, o = self.entries[id], self.options
    if not entry or (entry.lost and not release) then return false, "Profile is not owned." end
    if entry.busy then return false, "busy" end
    entry.busy = true
    local snapshot = o.schema.clone(entry.data)
    self.writes = self.writes + 1
    local receipt = o.token .. ":save:" .. self.writes
    local ok, result = self:_update(id, function(old)
        -- A timeout may arrive after Roblox already committed this write.
        if old and old.lastWrite == receipt then return old end
        if not old or not old.lease or old.lease.token ~= o.token or old.lease.expires &lt;= o.clock() then return nil end
        if old.version ~= o.schema.version then return nil end
        return { version = o.schema.version, data = snapshot, lastWrite = receipt,
            lease = not release and { token = o.token, expires = o.clock() + o.leaseSeconds } or nil }
    end)
    entry.busy = false
    if ok and result and result.lastWrite == receipt and (release and not result.lease
        or not release and result.lease and result.lease.token == o.token and result.lease.expires &gt; o.clock() + 5) then
        if release then self.entries[id] = nil else
            entry.leaseUntil, entry.nextSave = result.lease.expires, o.clock() + o.autosaveSeconds
            entry.lost = false
            if entry.releasePending then entry.nextSave = o.clock() end
        end
        return true
    end
    if ok then
        entry.lost = true
        if o.onLost then o.onLost(id) end
    else
        entry.nextSave = o.clock() + 10
        if o.onError then o.onError(id) end
    end
    return false, ok and "Session ownership was lost." or "Saving service is unavailable."
end

function PlayerStore:release(id)
    local entry = self.entries[id]
    if not entry then return true end
    entry.releasing = true
    local deadline = self.options.clock() + 20
    while entry.busy and self.options.clock() &lt; deadline do self.options.wait(0.1) end
    if self.entries[id] ~= entry then return true end
    if entry.busy then
        entry.releasing, entry.releasePending = false, true
        self.failedFinals[id] = true
        return false, "Save did not finish before shutdown."
    end
    local ok, problem = self:save(id, true)
    if not ok and entry.lost then
        if self.entries[id] == entry then self.entries[id] = nil end
        if self.options.onError then self.options.onError(id, "ownership") end
    elseif not ok then
        entry.releasing, entry.releasePending = false, true
        entry.nextSave = self.options.clock() + 10
    end
    self.failedFinals[id] = not ok or nil
    return ok, problem
end

function PlayerStore:step()
    local o = self.options
    for id, entry in pairs(self.entries) do
        if not entry.lost and o.clock() &gt;= entry.leaseUntil - 5 then
            entry.lost = true
            if o.onLost then o.onLost(id) end
        elseif not entry.busy and not entry.lost and not entry.releasing and o.clock() &gt;= entry.nextSave then
            -- Reserve before spawning so consecutive heartbeats cannot queue saves.
            entry.nextSave = o.clock() + o.autosaveSeconds
            o.spawn(function()
                if self.entries[id] ~= entry then return end
                if entry.releasePending then self:release(id) else self:save(id, false) end
            end)
        end
    end
end

function PlayerStore:shutdown()
    self.closing = true
    for id in pairs(self.entries) do self.options.spawn(function() self:release(id) end) end
    local deadline = self.options.clock() + 25
    while (next(self.entries) or next(self.loading)) and self.options.clock() &lt; deadline do self:step() self.options.wait(0.1) end
    return next(self.entries) == nil and next(self.loading) == nil and next(self.failedFinals) == nil
end

return PlayerStore
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX26">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <ProtectedString name="Source">-- Versioned, deterministic migrations; safe to run repeatedly in UpdateAsync.
local ProfileSchema = {}
local function clone(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for k, v in pairs(value) do result[k] = clone(v) end
    return result
end
ProfileSchema.clone = clone
local function finite(value) return type(value) == "number" and value == value and math.abs(value) &lt; math.huge end

function ProfileSchema.create(config, progression)
    local schema = { version = 3, clone = clone }
    function schema.new()
        local profile = { schemaVersion = 3, coins = config.StartingCoins, xp = 0, level = 1, bag = {}, bait = {},
            equipped = { auger = "hand", rod = "twig", lure = "plain", bait = "bread" },
            owned = { auger = { hand = true }, rod = { twig = true }, lure = { plain = true } },
            discoveries = {}, records = {}, statistics = { catches = 0, sold = 0, earned = 0 },
            settings = { musicVolume = 0.35, sfxVolume = 0.65, reducedEffects = false, highContrast = false },
            quests = {}, unlockedRegions = { pond = true }, collection = {}, achievements = {}, tutorial = { step = 1, completed = false, skipped = false } }
        for _, bait in ipairs(config.Gear.bait) do if bait.amount &gt; 0 then profile.bait[bait.id] = 0 end end
        return profile
    end
    function schema.migrate(raw)
        if type(raw) ~= "table" then return nil, "invalid profile" end
        if raw.schemaVersion and (not finite(raw.schemaVersion) or raw.schemaVersion &gt; 3) then return nil, "unsupported data version" end
        if not finite(raw.coins) or raw.coins &lt; 0 or raw.coins &gt; config.MaxCoins then return nil, "invalid currency" end
        local p = schema.new()
        for _, key in ipairs({ "owned", "bait", "equipped" }) do
            if raw[key] ~= nil and type(raw[key]) ~= "table" then return nil, "invalid " .. key end
        end
        for _, category in ipairs({ "rod", "auger", "lure" }) do
            if raw.owned and raw.owned[category] ~= nil and type(raw.owned[category]) ~= "table" then return nil, "invalid equipment ownership" end
        end
        p.coins = math.floor(raw.coins)
        if raw.xp ~= nil and (not finite(raw.xp) or raw.xp &lt; 0) then return nil, "invalid XP" end
        p.xp = math.min(progression.MaxXP, math.floor(raw.xp or 0))
        p.level = progression.describe(p.xp).level
        for category, items in pairs(config.Gear) do
            if category ~= "bait" then
                for _, item in ipairs(items) do
                    if raw.owned and raw.owned[category] and raw.owned[category][item.id] == true then p.owned[category][item.id] = true end
                end
            else
                for _, item in ipairs(items) do
                    local count = raw.bait and raw.bait[item.id]
                    if count ~= nil and (not finite(count) or count &lt; 0 or count &gt; 1000000000) then return nil, "invalid bait count" end
                    if item.amount &gt; 0 then p.bait[item.id] = math.floor(count or 0) end
                end
            end
            local equipped = raw.equipped and raw.equipped[category]
            if config.findGear(category, equipped) and (category == "bait" or p.owned[category][equipped]) then p.equipped[category] = equipped end
        end
        if raw.bag ~= nil and type(raw.bag) ~= "table" then return nil, "invalid fish inventory" end
        if raw.bag and #raw.bag &gt; 100 then return nil, "oversized fish inventory" end
        local ids = {}
        for i, fish in ipairs(raw.bag or {}) do
            if type(fish) ~= "table" or type(fish.name) ~= "string" or not finite(fish.value) or fish.value &lt; 1
                or fish.value &gt; 10000000 or not finite(fish.kg) or fish.kg &lt;= 0 or fish.kg &gt; 10000 then
                return nil, "invalid fish entry"
            end
            local entry = clone(fish)
            if type(entry.rarity) ~= "string" or type(entry.color) ~= "table" then return nil, "invalid fish appearance" end
            for channel = 1, 3 do
                if not finite(entry.color[channel]) or entry.color[channel] &lt; 0 or entry.color[channel] &gt; 255 then return nil, "invalid fish color" end
            end
            entry.catchId = type(entry.catchId) == "string" and entry.catchId or ("legacy-" .. i)
            if ids[entry.catchId] then return nil, "duplicate catch ID" end
            ids[entry.catchId] = true
            table.insert(p.bag, entry)
        end
        for _, key in ipairs({ "discoveries", "records", "statistics", "settings", "quests", "unlockedRegions", "collection", "achievements", "tutorial" }) do
            if raw[key] ~= nil and type(raw[key]) ~= "table" then return nil, "invalid " .. key end
            if raw[key] then p[key] = clone(raw[key]) end
        end
        for _, key in ipairs({ "catches", "sold", "earned" }) do
            local value = p.statistics[key]
            if value ~= nil and (not finite(value) or value &lt; 0) then return nil, "invalid statistics" end
            p.statistics[key] = math.floor(value or 0)
        end
        for id, value in pairs(p.discoveries) do
            if type(id) ~= "string" or type(value) ~= "boolean" then return nil, "invalid discoveries" end
        end
        for id, value in pairs(p.records) do
            if type(id) ~= "string" or not finite(value) or value &lt;= 0 then return nil, "invalid fish records" end
        end
        for key, default in pairs(schema.new().settings) do
            local value = p.settings[key]
            if value == nil then p.settings[key] = default
            elseif type(value) ~= type(default) or type(value) == "number" and (not finite(value) or value &lt; 0 or value &gt; 1) then return nil, "invalid settings" end
        end
        if not finite(p.tutorial.step) or p.tutorial.step &lt; 1 or p.tutorial.step &gt; 7
            or type(p.tutorial.completed) ~= "boolean" or type(p.tutorial.skipped) ~= "boolean" then return nil, "invalid tutorial" end
        for id, record in pairs(p.collection) do
            if type(id) ~= "string" or type(record) ~= "table" or not finite(record.count) or record.count &lt; 0
                or not finite(record.biggest) or record.biggest &lt; 0 or type(record.variants) ~= "table" then return nil, "invalid collection" end
            for variant, found in pairs(record.variants) do if type(variant) ~= "string" or type(found) ~= "boolean" then return nil, "invalid collection variant" end end
        end
        for id, found in pairs(p.discoveries) do
            if found and not p.collection[id] then p.collection[id] = { count = 1, biggest = p.records[id] or 0, variants = { Normal = true } } end
        end
        for id, state in pairs(p.quests) do
            if type(id) ~= "string" or type(state) ~= "table" or not finite(state.progress) or state.progress &lt; 0
                or not finite(state.acceptedAt) or type(state.claimed) ~= "boolean" or type(state.seen) ~= "table"
                or state.claimedAt ~= nil and not finite(state.claimedAt) then return nil, "invalid quest progress" end
            for species, seen in pairs(state.seen) do if type(species) ~= "string" or type(seen) ~= "boolean" then return nil, "invalid quest species" end end
        end
        for id, unlocked in pairs(p.unlockedRegions) do if type(id) ~= "string" or type(unlocked) ~= "boolean" then return nil, "invalid regions" end end
        for id, unlocked in pairs(p.achievements) do if type(id) ~= "string" or type(unlocked) ~= "boolean" then return nil, "invalid achievements" end end
        p.unlockedRegions.pond = true
        for _, fish in ipairs(p.bag) do
            fish.favorite, fish.locked = fish.favorite == true, fish.locked == true
            fish.variant = type(fish.variant) == "string" and fish.variant or "Normal"
            if not fish.species then
                for _, definition in ipairs(config.Fish) do if definition.name == fish.name then fish.species = definition.id break end end
            end
        end
        return p
    end
    return schema
end
return ProfileSchema
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX27">
        <Properties>
          <string name="Name">ServerSettings</string>
          <ProtectedString name="Source">-- This module stays in ServerScriptService, never ReplicatedStorage.
return {
    LiveStoreName = "FrostbitePlayers_v2",
    StudioStoreName = "FrostbiteStudio_TEST_v2",
    StudioPersistence = false, -- Explicitly enable only in a published TEST place.
    AutosaveSeconds = 60,
    LeaseSeconds = 180,
    AdminUsername = "unbenator",
    AdminUserIds = {}, -- Optional permanent numeric IDs; independent of renames.
    StudioAdminUserIds = {}, -- Optional Studio test players, e.g. -1; never live.
    MaxMoneyGrant = 1000000,
    MaxXPGrant = 100000,
    FlySpeed = 55,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX28">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local World = {}
local Lighting = game:GetService("Lighting")
local Equipment = require(game:GetService("ReplicatedStorage").Shared.Equipment)
local TweenService = game:GetService("TweenService")

local function part(parent, name, size, position, color, material)
    local p = Instance.new("Part")
    p.Name, p.Size, p.Position = name, size, position
    p.Anchored, p.Color = true, color
    p.Material = material or Enum.Material.SmoothPlastic
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

-- Surface signs stay attached to their physical boards and respect occlusion.
local function signFace(board, face, title, subtitle)
    local surface = Instance.new("SurfaceGui")
    surface.Name, surface.Face = "Lettering", face
    surface.SizingMode, surface.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 45
    surface.AlwaysOnTop, surface.LightInfluence, surface.MaxDistance = false, 0.15, 150
    surface.Parent = board
    for i, value in ipairs({ title, subtitle }) do
        local t = Instance.new("TextLabel")
        t.Size = UDim2.fromScale(0.92, i == 1 and 0.49 or 0.25)
        t.Position = UDim2.fromScale(0.04, i == 1 and 0.08 or 0.65)
        t.BackgroundTransparency, t.Text, t.TextScaled = 1, value, true
        t.Font = i == 1 and Enum.Font.GothamBold or Enum.Font.Gotham
        t.TextColor3 = i == 1 and Color3.fromRGB(255, 223, 160) or Color3.fromRGB(176, 223, 213)
        t.Parent = surface
    end
end

local function sign(parent, name, size, position, title, subtitle)
    local board = part(parent, name, size, position, Color3.fromRGB(29, 64, 68), Enum.Material.Wood)
    for _, x in ipairs({ -1, 1 }) do
        part(parent, "SignTrim", Vector3.new(0.2, size.Y + 0.3, size.Z + 0.12), position + Vector3.new(x * size.X / 2, 0, 0), Color3.fromRGB(183, 139, 83), Enum.Material.Wood)
    end
    for _, y in ipairs({ -1, 1 }) do
        part(parent, "SignTrim", Vector3.new(size.X, 0.2, size.Z + 0.12), position + Vector3.new(0, y * size.Y / 2, 0), Color3.fromRGB(183, 139, 83), Enum.Material.Wood)
    end
    signFace(board, Enum.NormalId.Back, title, subtitle)
    signFace(board, Enum.NormalId.Front, title, subtitle)
    return board
end

function World.build(config)
    local old = workspace:FindFirstChild("FrostbiteWorld")
    if old then old:Destroy() end
    local world = Instance.new("Folder")
    world.Name, world.Parent = "FrostbiteWorld", workspace
    Lighting.ClockTime, Lighting.Brightness = 14, 2
    Lighting.Ambient = Color3.fromRGB(140, 166, 190)
    Lighting.OutdoorAmbient = Color3.fromRGB(165, 187, 207)
    Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.fromRGB(197, 219, 235), 210, 580
    local sky = Instance.new("Atmosphere")
    sky.Density, sky.Color, sky.Decay = 0.22, Color3.fromRGB(199, 222, 240), Color3.fromRGB(135, 168, 195)
    sky.Parent = Lighting

    part(world, "Snowfield", Vector3.new(420, 8, 420), Vector3.new(0, -4, 0), Color3.fromRGB(233, 241, 245), Enum.Material.Snow)
    local pond = part(world, "FrozenPond", Vector3.new(2, 136, 136), Vector3.new(0, 1, 0), Color3.fromRGB(145, 201, 219), Enum.Material.Ice)
    pond.Shape, pond.Orientation, pond.Reflectance = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), 0.15
    local rng = Random.new(2026)
    -- Thin pale cracks across the frozen surface, kept non-colliding.
    for i = 1, 30 do
        local angle, radius = rng:NextNumber(0, math.pi * 2), rng:NextNumber(6, 59)
        local crack = part(world, "IceVein", Vector3.new(rng:NextNumber(3, 11), 0.015, 0.09),
            Vector3.new(math.cos(angle) * radius, 2.012, math.sin(angle) * radius), Color3.fromRGB(209, 238, 245), Enum.Material.Ice)
        crack.Orientation, crack.CanCollide, crack.CanQuery = Vector3.new(0, rng:NextNumber(0, 360), 0), false, false
    end
    for i = 1, 58 do
        local angle = i * math.pi * 2 / 58 + rng:NextNumber(-0.04, 0.04)
        local radius = rng:NextNumber(87, 175)
        local x, z = math.cos(angle) * radius, math.sin(angle) * radius
        if not (math.abs(x) &lt; 29 and z &lt; -65) then
            local height = rng:NextNumber(16, 29)
            part(world, "PineTrunk", Vector3.new(2.1, height * 0.6, 2.1), Vector3.new(x, height * 0.3, z), Color3.fromRGB(90, 71, 59), Enum.Material.Wood)
            for level = 1, 3 do
                local width = (4 - level) * 3.5
                local leaf = part(world, "PineBoughs", Vector3.new(width, height * 0.32, width), Vector3.new(x, height * (0.30 + level * 0.19), z), Color3.fromRGB(45 + level * 8, 89 + level * 6, 82 + level * 5), Enum.Material.Grass)
                leaf.Shape = Enum.PartType.Ball
                local snow = part(world, "PineSnow", Vector3.new(width * 0.92, height * 0.15, width * 0.92), leaf.Position + Vector3.new(0, height * 0.1, 0), Color3.fromRGB(238, 246, 250), Enum.Material.Snow)
                snow.Shape = Enum.PartType.Ball
            end
        end
    end

    local shop = Instance.new("Model")
    shop.Name, shop.Parent = "TackleShop", world
    part(shop, "Floor", Vector3.new(32, 1, 23), Vector3.new(0, 0.5, -96), Color3.fromRGB(124, 94, 72), Enum.Material.WoodPlanks)
    part(shop, "BackWall", Vector3.new(32, 15, 1), Vector3.new(0, 8, -107), Color3.fromRGB(111, 74, 54), Enum.Material.WoodPlanks)
    for _, x in ipairs({ -15.5, 15.5 }) do
        part(shop, "SideWall", Vector3.new(1, 15, 23), Vector3.new(x, 8, -96), Color3.fromRGB(111, 74, 54), Enum.Material.WoodPlanks)
        part(shop, "PorchPost", Vector3.new(1.2, 15, 1.2), Vector3.new(x, 8, -82), Color3.fromRGB(85, 59, 47), Enum.Material.Wood)
    end
    part(shop, "Roof", Vector3.new(36, 2, 30), Vector3.new(0, 16, -94), Color3.fromRGB(226, 238, 242), Enum.Material.Snow)
    local counter = part(shop, "Counter", Vector3.new(24, 4, 3), Vector3.new(0, 3, -96), Color3.fromRGB(161, 112, 76), Enum.Material.WoodPlanks)
    sign(shop, "CabinSign", Vector3.new(25, 3.6, 0.6), Vector3.new(0, 12.9, -81.2), "FROSTBITE TACKLE", "AUGERS  •  RODS  •  BAIT  •  LURES")
    sign(shop, "SellSign", Vector3.new(10, 1.8, 0.25), Vector3.new(0, 3.3, -94.35), "SELL YOUR CATCH", "Fresh fish. Fair prices.")
    -- Real 3D stock on the back wall, matching the preview and held models.
    part(shop, "EquipmentRack", Vector3.new(28, 0.4, 2), Vector3.new(0, 4, -105), Color3.fromRGB(81, 59, 45), Enum.Material.Wood)
    for i, id in ipairs({ "twig", "birch", "carbon", "glacier" }) do
        local stock = Equipment.build("rod", id)
        stock.Parent = shop
        stock:PivotTo(CFrame.new(-12 + i * 3.2, 5, -105) * CFrame.Angles(0, 0, math.rad(-12)))
    end
    for i, id in ipairs({ "hand", "power" }) do
        local stock = Equipment.build("auger", id)
        stock.Parent = shop
        stock:PivotTo(CFrame.new(6 + i * 3, 9, -105))
    end
    local promptPart = part(shop, "ShopPrompt", Vector3.new(1, 1, 1), Vector3.new(0, 4, -87), Color3.new(1, 1, 1))
    promptPart.Transparency, promptPart.CanCollide = 1, false
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText = "Shop &amp; sell fish", "Frostbite Tackle"
    prompt.MaxActivationDistance, prompt.HoldDuration, prompt.RequiresLineOfSight = 18, 0, false
    prompt.Parent = promptPart
    local light = Instance.new("PointLight")
    light.Color, light.Range, light.Brightness, light.Parent = Color3.fromRGB(255, 209, 137), 35, 1.8, counter

    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Size, spawn.Position = "LakesideSpawn", Vector3.new(10, 1, 8), Vector3.new(0, 0.5, -73)
    spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 0
    spawn.Color, spawn.Material, spawn.Parent = Color3.fromRGB(220, 232, 237), Enum.Material.Snow, world
    sign(world, "PondSign", Vector3.new(12, 4, 0.7), Vector3.new(21, 5, -71), "FROSTBITE POND", "DRILL ONCE. FISH ALL DAY.")
    for _, x in ipairs({ 16, 26 }) do
        part(world, "SignPost", Vector3.new(0.6, 4.6, 0.6), Vector3.new(x, 2.3, -71), Color3.fromRGB(104, 77, 54), Enum.Material.Wood)
    end

    -- An impassable natural edge keeps players inside the playable snowfield.
    for i = 1, 24 do
        local angle = i * math.pi * 2 / 24
        local rock = part(world, "SnowyRidge", Vector3.new(57, 45 + (i % 4) * 7, 44), Vector3.new(math.cos(angle) * 207, 15, math.sin(angle) * 207), Color3.fromRGB(191, 211, 222), Enum.Material.Slate)
        rock.Shape = Enum.PartType.Ball
    end
    local buyer = Instance.new("Model")
    buyer.Name, buyer.Parent = "MaraFishBuyer", world
    local base = Vector3.new(11, 1, -86)
    local torso = part(buyer, "Torso", Vector3.new(2, 2, 1), base + Vector3.new(0, 3, 0), Color3.fromRGB(53, 104, 116))
    local head = part(buyer, "Head", Vector3.new(1.6, 1, 1.2), base + Vector3.new(0, 4.5, 0), Color3.fromRGB(219, 171, 128))
    local npcRoot = part(buyer, "HumanoidRootPart", Vector3.new(2, 2, 1), torso.Position, Color3.new(1, 1, 1))
    npcRoot.Transparency, npcRoot.CanCollide = 1, false
    buyer.PrimaryPart = npcRoot
    local neck = Instance.new("Motor6D")
    neck.Name, neck.Part0, neck.Part1 = "Neck", torso, head
    neck.C0, neck.C1, neck.Parent = CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0), torso
    for _, side in ipairs({ -1, 1 }) do
        part(buyer, side == 1 and "Right Arm" or "Left Arm", Vector3.new(1, 2, 1), base + Vector3.new(side * 1.5, 3, 0), Color3.fromRGB(53, 104, 116))
        part(buyer, side == 1 and "Right Leg" or "Left Leg", Vector3.new(0.95, 2, 1), base + Vector3.new(side * 0.5, 1, 0), Color3.fromRGB(48, 57, 68))
        part(buyer, "Mitten", Vector3.new(0.95, 0.5, 1.02), base + Vector3.new(side * 1.5, 2.15, 0), Color3.fromRGB(179, 133, 75))
        part(buyer, "Eye", Vector3.new(0.1, 0.12, 0.06), base + Vector3.new(side * 0.29, 4.55, 0.62), Color3.fromRGB(30, 42, 44))
    end
    part(buyer, "Beanie", Vector3.new(1.75, 0.45, 1.3), base + Vector3.new(0, 5.05, 0), Color3.fromRGB(210, 146, 67))
    local pom = part(buyer, "PomPom", Vector3.new(0.45, 0.45, 0.45), base + Vector3.new(0, 5.45, 0), Color3.fromRGB(247, 227, 179))
    pom.Shape = Enum.PartType.Ball
    part(buyer, "Scarf", Vector3.new(2.1, 0.3, 1.2), base + Vector3.new(0, 4, 0), Color3.fromRGB(210, 146, 67))
    local humanoid = Instance.new("Humanoid")
    humanoid.DisplayName, humanoid.NameDisplayDistance, humanoid.Parent = "Mara · Fish buyer", 45, buyer
    local sellPrompt = Instance.new("ProximityPrompt")
    sellPrompt.ActionText, sellPrompt.ObjectText = "Sell all fish", "Mara · Fish buyer"
    sellPrompt.MaxActivationDistance, sellPrompt.HoldDuration, sellPrompt.RequiresLineOfSight = 10, 0.25, false
    sellPrompt.Parent = torso
    return world, prompt, sellPrompt
end

function World.hole(parent, position, diameter, owner)
    local model = Instance.new("Model")
    model.Name, model.Parent = "Hole_" .. owner.UserId, parent
    local rim = part(model, "SnowRim", Vector3.new(0.1, diameter + 0.65, diameter + 0.65), Vector3.new(position.X, 2.04, position.Z), Color3.fromRGB(231, 249, 251), Enum.Material.Snow)
    rim.Shape, rim.Orientation, rim.CanCollide = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), false
    local water = part(model, "DarkWater", Vector3.new(0.12, diameter, diameter), Vector3.new(position.X, 2.11, position.Z), Color3.fromRGB(19, 57, 76), Enum.Material.Glass)
    water.Shape, water.Orientation, water.CanCollide, water.Reflectance = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), false, 0.2
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText = "Cast again", owner.DisplayName .. "'s fishing hole"
    prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.HoldDuration = 10, false, 0
    prompt.Parent = water
    return model, prompt
end

function World.line(hole, equipment)
    local model = Instance.new("Model")
    model.Name, model.Parent = "FishingLine", hole.model
    local bobber = part(model, "Bobber", Vector3.new(0.25, 0.4, 0.25), hole.position + Vector3.new(0, 1.7, 0), Color3.fromRGB(236, 107, 78))
    bobber.Shape, bobber.CanCollide, bobber.CanQuery = Enum.PartType.Ball, false, false
    local anchor = Instance.new("Attachment")
    anchor.Parent = bobber
    local beam = Instance.new("Beam")
    beam.Attachment0 = equipment.PrimaryPart:FindFirstChild("LineTip")
    beam.Attachment1, beam.Width0, beam.Width1, beam.FaceCamera = anchor, 0.025, 0.025, true
    beam.Segments, beam.CurveSize0, beam.CurveSize1 = 16, 0.35, 0.35
    beam.Color, beam.Parent = ColorSequence.new(Color3.fromRGB(227, 238, 241)), bobber
    TweenService:Create(bobber, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = hole.position + Vector3.new(0, 0.24, 0) }):Play()
    return model, bobber
end

function World.drilling(parent, position)
    local source = part(parent, "IceShavings", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 0.2, 0), Color3.new(1, 1, 1))
    source.Transparency, source.CanCollide, source.CanQuery = 1, false, false
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(Color3.fromRGB(223, 249, 255))
    emitter.Rate, emitter.Lifetime, emitter.Speed = 28, NumberRange.new(0.25, 0.55), NumberRange.new(3, 7)
    emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) })
    emitter.SpreadAngle, emitter.Acceleration, emitter.Parent = Vector2.new(65, 65), Vector3.new(0, -16, 0), source
    return source
end

function World.catchEffect(parent, position, catch)
    local FishModels = require(game:GetService("ReplicatedStorage").Shared.FishModels)
    local model = FishModels.build(catch.species, catch.color)
    model:ScaleTo(math.min(0.8, 0.35 + catch.kg ^ 0.25 * 0.08))
    model.Parent = parent
    local value = Instance.new("CFrameValue")
    value.Value, value.Parent = CFrame.new(position + Vector3.new(0, 0.4, 0)), model
    model:PivotTo(value.Value)
    local connection = value.Changed:Connect(function(cf) if model.Parent then model:PivotTo(cf) end end)
    model.Destroying:Connect(function() connection:Disconnect() end)
    local tween = TweenService:Create(value, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = CFrame.new(position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(65)) })
    tween.Completed:Connect(function() model:Destroy() end)
    tween:Play()
    game:GetService("Debris"):AddItem(model, 1.2)
end

return World
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX29">
        <Properties>
          <string name="Name">WorldExpansion</string>
          <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Content = require(ReplicatedStorage.Shared.Content)
local Expansion = {}
local function part(parent, class, name, size, position, rgb, material)
    local p = Instance.new(class)
    p.Name, p.Size, p.Position, p.Color = name, size, position, Color3.fromRGB(rgb[1], rgb[2], rgb[3])
    p.Anchored, p.Material, p.Parent = true, material or Enum.Material.SmoothPlastic, parent
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.CanTouch = false
    return p
end
local function sign(parent, position, title, subtitle)
    local board = part(parent, "Part", "TrailBoard", Vector3.new(13, 4, 0.5), position, { 35, 64, 71 }, Enum.Material.Wood)
    for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
        local surface = Instance.new("SurfaceGui")
        surface.Face, surface.SizingMode, surface.PixelsPerStud, surface.Parent = face, Enum.SurfaceGuiSizingMode.PixelsPerStud, 40, board
        surface.LightInfluence = 0.15
        for i, value in ipairs({ title, subtitle }) do
            local t = Instance.new("TextLabel")
            t.Text, t.TextScaled, t.BackgroundTransparency = value, true, 1
            t.Size, t.Position = UDim2.fromScale(0.94, i == 1 and 0.45 or 0.25), UDim2.fromScale(0.03, i == 1 and 0.1 or 0.66)
            t.TextColor3, t.Font, t.Parent = Color3.fromRGB(247, 222, 168), Enum.Font.GothamBold, surface
        end
    end
    for _, offset in ipairs({ -5, 5 }) do part(parent, "Part", "Post", Vector3.new(0.5, 4, 0.5), position + Vector3.new(offset, -3, 0), { 112, 79, 51 }, Enum.Material.Wood) end
    return board
end
local function prompt(parent, action, object)
    local p = Instance.new("ProximityPrompt")
    p.ActionText, p.ObjectText, p.MaxActivationDistance, p.RequiresLineOfSight = action, object, 12, false
    p.Parent = parent
    return p
end
local function pine(parent, x, z, height)
    part(parent, "Part", "PineTrunk", Vector3.new(1.2, height * 0.6, 1.2), Vector3.new(x, height * 0.3, z), { 91, 70, 53 }, Enum.Material.Wood)
    -- Crossed wedge boughs give a pointed, faceted conifer silhouette.
    for tier = 1, 3 do
        local width, y = (4 - tier) * 3, height * (0.27 + tier * 0.19)
        for quarter = 0, 3 do
            local angle = quarter * math.pi / 2
            local direction = Vector3.new(math.sin(angle), 0, math.cos(angle))
            local leaf = part(parent, "WedgePart", "PineBough", Vector3.new(width, height * 0.32, width / 2), Vector3.new(x, y, z) + direction * width / 4, { 43, 89 + tier * 6, 78 }, Enum.Material.Grass)
            leaf.CFrame = CFrame.new(leaf.Position) * CFrame.Angles(0, angle, 0)
            leaf.CanCollide, leaf.CanQuery = false, false
            local snow = part(parent, "WedgePart", "SnowBough", leaf.Size * 0.91, leaf.Position + Vector3.new(0, 0.34, 0), { 232, 243, 247 }, Enum.Material.Snow)
            snow.CFrame, snow.CanCollide, snow.CanQuery = CFrame.new(snow.Position) * CFrame.Angles(0, angle, 0), false, false
        end
    end
end
local function hut(parent, position, color)
    part(parent, "Part", "ShelterFloor", Vector3.new(12, 0.6, 11), position, { 121, 88, 62 }, Enum.Material.WoodPlanks)
    part(parent, "Part", "ShelterBack", Vector3.new(12, 9, 0.5), position + Vector3.new(0, 4.7, -5.2), color, Enum.Material.WoodPlanks)
    for _, x in ipairs({ -5.7, 5.7 }) do part(parent, "Part", "ShelterWall", Vector3.new(0.5, 9, 11), position + Vector3.new(x, 4.7, 0), color, Enum.Material.WoodPlanks) end
    part(parent, "Part", "SnowRoof", Vector3.new(14, 1, 13), position + Vector3.new(0, 9.5, 0), { 235, 245, 249 }, Enum.Material.Snow)
    local lantern = part(parent, "Part", "Lantern", Vector3.new(0.8, 1.1, 0.8), position + Vector3.new(4, 6, 4.8), { 255, 218, 142 }, Enum.Material.Neon)
    local light = Instance.new("PointLight")
    light.Color, light.Range, light.Brightness, light.Parent = Color3.fromRGB(255, 215, 148), 20, 1.1, lantern
    part(parent, "Part", "Bench", Vector3.new(7, 0.6, 2), position + Vector3.new(0, 2, -3.6), { 136, 98, 66 }, Enum.Material.WoodPlanks)
end
local function npc(parent, position, name, action)
    local model = Instance.new("Model") model.Name, model.Parent = name, parent
    local torso = part(model, "Part", "Torso", Vector3.new(2, 2, 1), position + Vector3.new(0, 3, 0), { 96, 109, 138 })
    local head = part(model, "Part", "Head", Vector3.new(1.6, 1, 1.2), position + Vector3.new(0, 4.5, 0), { 218, 171, 129 })
    for _, side in ipairs({ -1, 1 }) do
        part(model, "Part", "Arm", Vector3.new(1, 2, 1), position + Vector3.new(side * 1.5, 3, 0), { 96, 109, 138 })
        part(model, "Part", "Leg", Vector3.new(0.9, 2, 1), position + Vector3.new(side * 0.5, 1, 0), { 49, 60, 73 })
        local eye = part(model, "Part", "Eye", Vector3.new(0.1, 0.1, 0.08), head.Position + Vector3.new(side * 0.3, 0.1, 0.63), { 25, 33, 43 })
        eye.CanCollide = false
    end
    part(model, "Part", "Hat", Vector3.new(1.85, 0.45, 1.4), position + Vector3.new(0, 5.1, 0), { 192, 145, 84 })
    sign(parent, position + Vector3.new(0, 7.4, -0.5), name, action)
    return prompt(torso, action, name)
end
function Expansion.build(world)
    local callbacks = {}
    local oldTrees = {}
    for _, item in ipairs(world:GetChildren()) do
        if item.Name == "PineTrunk" then table.insert(oldTrees, item.Position) end
        if item.Name == "PineTrunk" or item.Name == "PineBoughs" or item.Name == "PineSnow" then item:Destroy() end
        if item.Name == "SnowyRidge" then
            -- Replace the original giant spheres with varied low rock ridges.
            item.Shape, item.Size, item.Position = Enum.PartType.Block, Vector3.new(55, 24, 38), Vector3.new(item.Position.X, 8, item.Position.Z)
            item.Orientation = Vector3.new(0, math.deg(math.atan2(item.Position.X, item.Position.Z)), 0)
        end
    end
    for i, position in ipairs(oldTrees) do if i % 2 == 0 then pine(world, position.X, position.Z, 19 + i % 7) end end
    for i, region in ipairs(Content.Regions) do
        local folder = Instance.new("Folder") folder.Name, folder.Parent = "Region_" .. region.id, world
        if i &gt; 1 then
            part(folder, "Part", "Snowfield", Vector3.new(300, 8, 300), Vector3.new(region.x, -4, region.z), { 232, 241, 247 }, Enum.Material.Snow)
            local ice = part(folder, "Part", "FrozenLake", Vector3.new(2, region.radius * 2, region.radius * 2), Vector3.new(region.x, 1, region.z), region.color, Enum.Material.Ice)
            ice.Shape, ice.Orientation, ice.Reflectance = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), 0.12
            for tree = 1, 16 do
                local angle = tree * math.pi / 8
                if math.sin(angle) &gt; -0.65 then pine(folder, region.x + math.cos(angle) * (region.radius + 28), region.z + math.sin(angle) * (region.radius + 28), 18 + tree % 9) end
            end
            for ridge = 1, 10 do
                local angle = ridge * math.pi / 5
                local mountain = part(folder, "WedgePart", "Mountain", Vector3.new(52, 24 + ridge % 3 * 8, 34), Vector3.new(region.x + math.cos(angle) * 142, 10, region.z + math.sin(angle) * 142), { 173, 194, 209 }, Enum.Material.Slate)
                mountain.Orientation = Vector3.new(0, math.deg(angle), 0)
            end
            hut(folder, Vector3.new(region.x + 20, 0.5, region.z - region.radius - 14), { 77, 108, 119 })
        end
        local trailPosition = Vector3.new(region.x - 13, 5, region.z - region.radius - 12)
        local board = sign(folder, trailPosition, region.name, "TRAILS / PLAN YOUR NEXT TRIP")
        table.insert(callbacks, { prompt = prompt(board, "Travel &amp; unlock lakes", "Trail board"), position = trailPosition, menu = "Map" })
        -- A short wooden dock leads from the trail stop onto the ice.
        part(folder, "Part", "Dock", Vector3.new(7, 0.4, 21), Vector3.new(region.x + 10, 2.4, region.z - region.radius + 3), { 125, 95, 69 }, Enum.Material.WoodPlanks)
        for _, side in ipairs({ -3.5, 3.5 }) do
            for n = 0, 2 do part(folder, "Part", "DockPost", Vector3.new(0.5, 4.5, 0.5), Vector3.new(region.x + 10 + side, 2.2, region.z - region.radius - 6 + n * 9), { 90, 70, 53 }, Enum.Material.Wood) end
        end
        hut(folder, Vector3.new(region.x - region.radius * 0.65, 2.5, region.z + 12), { 93, 110, 134 })
        if i == 3 or i == 5 then
            for c = 1, 7 do
                local crystal = part(folder, "WedgePart", "IceCrystal", Vector3.new(3, 7 + c % 3 * 3, 3), Vector3.new(region.x + region.radius + 12, 3, region.z + c * 5 - 20), region.color, Enum.Material.Glass)
                crystal.Transparency = 0.18
            end
        end
    end
    hut(world, Vector3.new(-45, 0.5, -102), { 123, 83, 69 })
    hut(world, Vector3.new(45, 0.5, -110), { 78, 105, 111 })
    table.insert(callbacks, { prompt = npc(world, Vector3.new(-28, 0, -83), "Nolan / Trail guide", "Fishing guide"), position = Vector3.new(-28, 4, -83), menu = "Guide" })
    table.insert(callbacks, { prompt = npc(world, Vector3.new(28, 0, -91), "Iris / Outpost tasks", "Quests &amp; rewards"), position = Vector3.new(28, 4, -91), menu = "Quests" })
    return callbacks
end
return Expansion
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX30">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX31">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX32">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX33">
          <Properties>
            <string name="Name">AdminMenu</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local AdminMenu = {}

function AdminMenu.start(gui, remotes)
    local player = Players.LocalPlayer
    local command, event = remotes:WaitForChild("AdminCommand"), remotes:WaitForChild("AdminEvent")
    local navy, card, mint, gold, white = Color3.fromRGB(20, 41, 54), Color3.fromRGB(32, 57, 71), Color3.fromRGB(131, 230, 201), Color3.fromRGB(255, 213, 136), Color3.fromRGB(232, 245, 249)
    local function make(class, parent, props)
        local object = Instance.new(class)
        for k, v in pairs(props) do object[k] = v end
        object.Parent = parent
        return object
    end
    local function round(object) make("UICorner", object, { CornerRadius = UDim.new(0, 9) }) end
    local function text(parent, value, size, position, fontSize)
        return make("TextLabel", parent, { Text = value, Size = size, Position = position, TextSize = fontSize or 14,
            Font = Enum.Font.Gotham, TextColor3 = white, TextWrapped = true, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left })
    end
    local function button(parent, value, size, position, callback, color)
        local object = make("TextButton", parent, { Text = value, Size = size, Position = position, TextSize = 13, Font = Enum.Font.GothamBold,
            BackgroundColor3 = color or mint, TextColor3 = navy, BorderSizePixel = 0 })
        round(object) object.Activated:Connect(callback) return object
    end
    local function box(parent, placeholder, size, position)
        local object = make("TextBox", parent, { Text = "", PlaceholderText = placeholder, Size = size, Position = position, TextSize = 14,
            Font = Enum.Font.Gotham, TextColor3 = white, PlaceholderColor3 = Color3.fromRGB(170, 194, 206), BackgroundColor3 = card,
            BorderSizePixel = 0, ClearTextOnFocus = false })
        round(object) return object
    end
    local overlay = make("Frame", gui, { Name = "AdminOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0, Visible = false, ZIndex = 10 })
    local panel = make("ScrollingFrame", overlay, { Name = "AdminPanel", Size = UDim2.fromOffset(680, 560), CanvasSize = UDim2.fromOffset(0, 560), ScrollBarThickness = 4,
        ScrollingDirection = Enum.ScrollingDirection.Y, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = navy, BorderSizePixel = 0 })
    round(panel)
    local scale = make("UIScale", panel, { Scale = 1 })
    text(panel, "FROSTBITE / ADMIN", UDim2.new(1, -80, 0, 34), UDim2.fromOffset(20, 14), 22).Font = Enum.Font.GothamBold
    text(panel, "Manage players in this server", UDim2.new(1, -40, 0, 24), UDim2.fromOffset(20, 49), 13)
    button(panel, "X", UDim2.fromOffset(36, 34), UDim2.new(1, -56, 0, 16), function() overlay.Visible = false end, gold)
    local selected, confirm = nil, nil
    local selection = text(panel, "Select a player", UDim2.fromOffset(415, 32), UDim2.fromOffset(245, 88), 17)
    local result = text(panel, "Choose a player, amount, and action.", UDim2.new(1, -40, 0, 48), UDim2.fromOffset(20, 492), 13)
    local rosterList = make("ScrollingFrame", panel, { Size = UDim2.fromOffset(205, 355), Position = UDim2.fromOffset(20, 90),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y })
    make("UIListLayout", rosterList, { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder })
    local amount = box(panel, "Amount (whole number)", UDim2.fromOffset(410, 36), UDim2.fromOffset(245, 128))
    local reason = box(panel, "Kick reason (optional)", UDim2.fromOffset(410, 36), UDim2.fromOffset(245, 174))
    local function request(action, needsTarget, needsConfirmation)
        if not player:GetAttribute("IsAdmin") then overlay.Visible = false return end
        if needsTarget and not selected then result.Text = "Select a player first." return end
        if needsConfirmation then
            local key = action .. ":" .. tostring(selected)
            if not confirm or confirm.key ~= key or os.clock() &gt; confirm.expires then
                confirm = { key = key, expires = os.clock() + 6 }
                result.Text = "Press " .. action .. " again within 6 seconds to confirm for the selected player."
                return
            end
        end
        confirm = nil
        command:FireServer({ action = action, targetId = selected, amount = tonumber(amount.Text), reason = reason.Text })
    end
    local actions = {
        { "Give coins", "money" }, { "Give XP", "xp" }, { "Go to player", "gotoPlayer" }, { "Bring player", "bring" },
        { "Freeze", "freeze" }, { "Unfreeze", "unfreeze" }, { "Heal", "heal" }, { "Respawn", "respawn", true }, { "Kick", "kick", true },
    }
    local actionButtons = {}
    for i, action in ipairs(actions) do
        local column, row = (i - 1) % 2, math.floor((i - 1) / 2)
        actionButtons[i] = button(panel, action[1], UDim2.fromOffset(198, 34), UDim2.fromOffset(245 + column * 212, 222 + row * 43), function()
            request(action[2], true, action[3])
        end, action[2] == "kick" and Color3.fromRGB(241, 144, 139) or mint)
    end
    local flyButton = button(panel, "Fly: OFF", UDim2.fromOffset(130, 34), UDim2.fromOffset(245, 446), function() request("fly") end, gold)
    local pondButton = button(panel, "To pond", UDim2.fromOffset(130, 34), UDim2.fromOffset(385, 446), function() request("pond") end, gold)
    local shopButton = button(panel, "To shop", UDim2.fromOffset(130, 34), UDim2.fromOffset(525, 446), function() request("shop") end, gold)
    local refreshButton = button(panel, "Refresh players", UDim2.fromOffset(205, 30), UDim2.fromOffset(20, 451), function() request("roster") end, gold)
    local function toggle()
        if not player:GetAttribute("IsAdmin") then return end
        overlay.Visible = not overlay.Visible
        if overlay.Visible then request("roster") end
    end
    local badge = button(gui, "ADMIN  [F2]", UDim2.fromOffset(190, 30), UDim2.new(1, -206, 0, 164), toggle, gold)
    badge.Name = "AdminButton"
    badge.Visible = player:GetAttribute("IsAdmin") == true
    player:GetAttributeChangedSignal("IsAdmin"):Connect(function()
        badge.Visible = player:GetAttribute("IsAdmin") == true
        if not badge.Visible then overlay.Visible = false end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and not UserInputService:GetFocusedTextBox() and input.KeyCode == Enum.KeyCode.F2 then toggle() end
    end)
    event.OnClientEvent:Connect(function(kind, data)
        if not player:GetAttribute("IsAdmin") then return end
        if kind == "result" then result.Text = data
        elseif kind == "roster" then
            for _, child in ipairs(rosterList:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
            local found = false
            for i, target in ipairs(data) do
                if target.userId == selected then found = true end
                local entry = button(rosterList, "@" .. target.username .. "\n" .. target.displayName, UDim2.new(1, -6, 0, 55), UDim2.fromOffset(0, 0), function()
                    selected, confirm = target.userId, nil
                    selection.Text = "@" .. target.username .. "  /  " .. target.userId
                end, selected == target.userId and gold or mint)
                entry.LayoutOrder = i
            end
            if not found then selected, confirm = nil, nil selection.Text = "Select a player" end
        end
    end)
    -- Flight uses server-created constraints, enabled only after server approval.
    local up, down, flightBound = false, false, false
    local flightHud = make("Frame", gui, { Size = UDim2.fromOffset(260, 95), Position = UDim2.new(0.5, -130, 0, 90), BackgroundColor3 = navy, BorderSizePixel = 0, Visible = false })
    round(flightHud)
    text(flightHud, "FLY / WASD · Space up · Ctrl down", UDim2.new(1, -20, 0, 30), UDim2.fromOffset(10, 4), 12)
    local upButton = button(flightHud, "UP", UDim2.fromOffset(110, 40), UDim2.fromOffset(10, 42), function() end)
    local downButton = button(flightHud, "DOWN", UDim2.fromOffset(110, 40), UDim2.fromOffset(140, 42), function() end)
    local upPointer, downPointer
    upButton.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then upPointer = input end end)
    downButton.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then downPointer = input end end)
    UserInputService.InputEnded:Connect(function(input)
        if input == upPointer or input.UserInputType == Enum.UserInputType.MouseButton1 then upPointer = nil end
        if input == downPointer or input.UserInputType == Enum.UserInputType.MouseButton1 then downPointer = nil end
    end)
    UserInputService.WindowFocusReleased:Connect(function() up, down, upPointer, downPointer = false, false, nil, nil end)
    local lastViewport = Vector2.zero
    RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if camera and camera.ViewportSize ~= lastViewport then
            lastViewport = camera.ViewportSize
            local mobile = lastViewport.X &lt; 680
            local width, height = math.min(680, lastViewport.X - 20), math.min(mobile and 760 or 560, lastViewport.Y - 60)
            panel.Size, scale.Scale = UDim2.fromOffset(width, height), 1
            panel.CanvasSize = UDim2.fromOffset(0, mobile and 760 or 560)
            rosterList.Size = mobile and UDim2.new(1, -40, 0, 120) or UDim2.fromOffset(205, 355)
            selection.Size = UDim2.new(1, mobile and -40 or -265, 0, 32)
            selection.Position = UDim2.fromOffset(mobile and 20 or 245, mobile and 219 or 88)
            amount.Size, reason.Size = UDim2.new(1, mobile and -40 or -270, 0, 36), UDim2.new(1, mobile and -40 or -270, 0, 36)
            amount.Position, reason.Position = UDim2.fromOffset(mobile and 20 or 245, mobile and 258 or 128), UDim2.fromOffset(mobile and 20 or 245, mobile and 302 or 174)
            for i, object in ipairs(actionButtons) do
                local column, row = (i - 1) % 2, math.floor((i - 1) / 2)
                local buttonWidth = mobile and (width - 52) / 2 or 198
                object.Size = UDim2.fromOffset(buttonWidth, 34)
                object.Position = UDim2.fromOffset((mobile and 20 or 245) + column * (buttonWidth + 14), (mobile and 347 or 222) + row * 43)
            end
            for i, object in ipairs({ flyButton, pondButton, shopButton }) do
                local buttonWidth = mobile and (width - 60) / 3 or 130
                object.Size = UDim2.fromOffset(buttonWidth, 34)
                object.Position = UDim2.fromOffset((mobile and 20 or 245) + (i - 1) * (buttonWidth + 10), mobile and 576 or 446)
            end
            refreshButton.Position = UDim2.fromOffset(20, mobile and 624 or 451)
            result.Position = UDim2.fromOffset(20, mobile and 672 or 492)
        end
        local enabled = player:GetAttribute("IsAdmin") == true and player:GetAttribute("AdminFlying") == true
        flyButton.Text, flightHud.Visible = enabled and "Fly: ON" or "Fly: OFF", enabled
        if enabled and not flightBound then
            ContextActionService:BindActionAtPriority("AdminFlightVertical", function(_, state, input)
                local pressed = state == Enum.UserInputState.Begin
                if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then up = pressed else down = pressed end
                return Enum.ContextActionResult.Sink
            end, false, Enum.ContextActionPriority.High.Value + 200, Enum.KeyCode.Space, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonB)
            flightBound = true
        elseif not enabled and flightBound then
            ContextActionService:UnbindAction("AdminFlightVertical")
            flightBound, up, down, upPointer, downPointer = false, false, false, nil, nil
        end
        if not enabled or not camera then return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local velocity = root and root:FindFirstChild("AdminFlightVelocity")
        local orientation = root and root:FindFirstChild("AdminFlightOrientation")
        if not velocity or not orientation or not humanoid then return end
        local direction = Vector3.zero
        if not UserInputService:GetFocusedTextBox() and not overlay.Visible then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - camera.CFrame.RightVector end
            if direction.Magnitude &lt; 0.01 then direction = humanoid.MoveDirection end
            direction = direction + Vector3.new(0, ((up or upPointer) and 1 or 0) - ((down or downPointer) and 1 or 0), 0)
        end
        velocity.VectorVelocity = direction.Magnitude &gt; 0 and direction.Unit * (player:GetAttribute("AdminFlySpeed") or 55) or Vector3.zero
        orientation.CFrame = camera.CFrame.Rotation
    end)
end
return AdminMenu
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX34">
          <Properties>
            <string name="Name">AdventureUI</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Content = require(ReplicatedStorage.Shared.Content)
local Config = require(ReplicatedStorage.Shared.Config)
local Inventory = require(ReplicatedStorage.Shared.Inventory)
local Preview = require(script.Parent.EquipmentPreview)
local Ui = require(script.Parent.Ui)
local Adventure = {}
function Adventure.start(gui, remotes, onOpen)
    local c, player = Ui.colors, Players.LocalPlayer
    local profile, active, sort, selected = nil, "Inventory", "Recent", nil
    local query, detailId = "", nil
    local mobile, panelWidth, panelHeight = false, 760, 590
    local lastViewport = Vector2.zero
    local command, event = remotes.Command, remotes.Event
    local function send(action, data) command:FireServer(action, data) end
    local shade = Ui.make("Frame", gui, { Name = "AdventureOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(), BackgroundTransparency = 0.35, BorderSizePixel = 0, Visible = false, ZIndex = 6 })
    local panel = Ui.frame(shade, UDim2.fromOffset(760, 590), UDim2.fromScale(0.5, 0.5))
    panel.Name = "FieldKitPanel"
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    local scale = Ui.make("UIScale", panel, { Scale = 1 })
    local title = Ui.text(panel, "ANGLER'S FIELD KIT", UDim2.new(1, -90, 0, 32), UDim2.fromOffset(20, 16), 23, c.gold)
    title.Font = Enum.Font.GothamBold
    local subtitle = Ui.text(panel, "", UDim2.new(1, -40, 0, 26), UDim2.fromOffset(20, 52), 13, c.muted)
    Ui.button(panel, "X", UDim2.fromOffset(36, 34), UDim2.new(1, -56, 0, 16), function() shade.Visible = false end, c.gold)
    local render
    local tabs = Ui.make("ScrollingFrame", panel, { Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 86), BackgroundTransparency = 1, BorderSizePixel = 0,
        CanvasSize = UDim2.fromOffset(840, 0), ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.X })
    for i, name in ipairs({ "Inventory", "Gear", "Journal", "Quests", "Map", "Settings", "Guide" }) do
        Ui.button(tabs, name, UDim2.fromOffset(112, 32), UDim2.fromOffset((i - 1) * 120, 0), function() active, detailId = name, nil if render then render() end end)
    end
    local search = Ui.make("TextBox", panel, { Text = "", PlaceholderText = "Search fish species...", Size = UDim2.fromOffset(450, 30), Position = UDim2.fromOffset(20, 134), ClearTextOnFocus = false,
        Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = c.text, BackgroundColor3 = c.card, BorderSizePixel = 0 })
    Ui.round(search)
    local sorts = { "Recent", "Rarity", "Weight", "Value" }
    local sortButton
    sortButton = Ui.button(panel, "Sort: Recent", UDim2.fromOffset(250, 30), UDim2.fromOffset(490, 134), function()
        local index = table.find(sorts, sort) or 1
        sort = sorts[index % #sorts + 1] sortButton.Text = "Sort: " .. sort render()
    end, c.gold)
    local list = Ui.make("ScrollingFrame", panel, { Size = UDim2.fromOffset(720, 355), Position = UDim2.fromOffset(20, 176), BackgroundTransparency = 1, BorderSizePixel = 0,
        CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5 })
    Ui.make("UIListLayout", list, { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder })
    Ui.make("UIPadding", list, { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) })
    local footer = Ui.text(panel, "", UDim2.fromOffset(500, 35), UDim2.fromOffset(20, 543), 12, c.muted)
    local sell = Ui.button(panel, "SELL UNPROTECTED", UDim2.fromOffset(200, 34), UDim2.fromOffset(540, 541), function() send("sell") end, c.gold)
    local inspect = Ui.frame(panel, UDim2.new(1, -30, 1, -30), UDim2.fromOffset(15, 15))
    inspect.Visible = false
    Ui.button(inspect, "BACK", UDim2.fromOffset(90, 32), UDim2.new(1, -110, 0, 14), function() inspect.Visible = false end, c.gold)
    local info = Ui.text(inspect, "", UDim2.new(1, -40, 0, 120), UDim2.new(0, 20, 1, -145), 15)
    local function showFish(fish, silhouette)
        local old = inspect:FindFirstChild("FishPreview") if old then old:Destroy() end
        local view = Ui.make("ViewportFrame", inspect, { Name = "FishPreview", Size = UDim2.new(1, -40, 1, -230), Position = UDim2.fromOffset(20, 65), BackgroundColor3 = c.dark, BorderSizePixel = 0 })
        Ui.round(view) Preview.fish(view, fish.species or fish.id, fish.color, silhouette)
        info.Text = silhouette and "An undiscovered species. Explore its lake and experiment with equipment." or
            (fish.name .. "\n" .. (fish.variant or "Normal") .. " / " .. fish.rarity .. " / " .. tostring(fish.kg or fish.biggest or 0) .. " kg\n" ..
            (fish.value and (fish.value .. " coins / " .. (fish.location or Config.Region) .. "\nCaught " .. os.date("!%Y-%m-%d %H:%M UTC", fish.caughtAt or 0)) or
            ("Preferred bait: " .. Config.gearName("bait", fish.preferredBait) .. " / " .. (fish.regionOnly and Content.region(fish.regionOnly).name or "Multiple lakes") .. "\nMore active: " .. (fish.preferredTime or "Day") .. " / " .. Content.weather(fish.preferredWeather).name)))
        inspect.Visible = true
    end
    local function card(height)
        local row = Ui.frame(list, UDim2.new(1, 0, 0, mobile and math.max(height, 154) or height), UDim2.fromOffset(0, 0), c.card)
        return row
    end
    local function preview(row, species, color, hidden)
        local view = Ui.make("ViewportFrame", row, { Size = UDim2.fromOffset(mobile and 76 or 92, 76), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = c.dark, BorderSizePixel = 0 })
        Ui.round(view) Preview.fish(view, species, color, hidden)
    end
    render = function()
        if not profile then return end
        inspect.Visible = false
        local position = list.CanvasPosition
        for _, item in ipairs(list:GetChildren()) do if item:IsA("Frame") or item:IsA("TextLabel") then item:Destroy() end end
        local inventory = active == "Inventory"
        search.Visible, sortButton.Visible, sell.Visible = inventory, inventory, inventory
        list.Position = UDim2.fromOffset(20, inventory and 176 or 134)
        list.Size = UDim2.new(1, -40, 0, panelHeight - (inventory and (mobile and 280 or 235) or 193))
        footer.Size = UDim2.new(1, mobile and -40 or -240, 0, mobile and 42 or 35)
        footer.Position = UDim2.new(0, 20, 1, mobile and (inventory and -96 or -53) or -47)
        sell.Size, sell.Position = UDim2.new(mobile and 1 or 0, mobile and -40 or 200, 0, 34), UDim2.new(mobile and 0 or 1, mobile and 20 or -220, 1, -46)
        search.Size = UDim2.new(0.6, -28, 0, 30)
        sortButton.Size, sortButton.Position = UDim2.new(0.4, -22, 0, 30), UDim2.new(0.6, 10, 0, 134)
        subtitle.Text = active .. " / Level " .. profile.level .. " / " .. profile.coins .. " coins"
        footer.Text = ""
        if inventory then
            local fishes = Inventory.query(profile.bag, query, sort)
            footer.Text = #profile.bag .. "/100 catches. Favorites and locks protect fish from sales."
            if #fishes == 0 then Ui.text(list, "No matching catches. Your next story is under the ice.", UDim2.new(1, 0, 0, 70), UDim2.fromOffset(0, 0), 17, c.muted) end
            for i, fish in ipairs(fishes) do
                local row = card(126) row.LayoutOrder = i
                preview(row, fish.species, fish.color)
                Ui.text(row, fish.name .. (fish.trophy and " / TROPHY" or ""), UDim2.new(1, mobile and -108 or -130, 0, mobile and 38 or 26), UDim2.fromOffset(mobile and 96 or 112, 8), 17).Font = Enum.Font.GothamBold
                Ui.text(row, (fish.variant or "Normal") .. " / " .. fish.rarity .. " / " .. fish.kg .. " kg / " .. fish.value .. " coins", UDim2.new(1, mobile and -108 or -130, 0, mobile and 54 or 24), UDim2.fromOffset(mobile and 96 or 112, mobile and 50 or 37), 13, c.muted)
                Ui.button(row, "INSPECT", UDim2.fromOffset(mobile and 66 or 92, mobile and 30 or 26), UDim2.fromOffset(8, mobile and 112 or 91), function() showFish(fish) end, c.gold)
                Ui.button(row, fish.favorite and "UNFAVORITE" or "FAVORITE", UDim2.fromOffset(mobile and 76 or 130, 30), UDim2.fromOffset(mobile and 80 or 112, mobile and 112 or 80), function() send("fishFlag", { id = fish.catchId, key = "favorite", value = not fish.favorite }) end, fish.favorite and c.gold or c.mint)
                Ui.button(row, fish.locked and "UNLOCK" or "LOCK", UDim2.fromOffset(mobile and 60 or 110, 30), UDim2.fromOffset(mobile and 162 or 255, mobile and 112 or 80), function() send("fishFlag", { id = fish.catchId, key = "locked", value = not fish.locked }) end)
                Ui.button(row, "SELL ONE", UDim2.fromOffset(mobile and 70 or 130, 30), UDim2.new(mobile and 1 or 0, mobile and -78 or 380, 0, mobile and 112 or 80), function() send("sellOne", { id = fish.catchId }) end, c.gold)
            end
        elseif active == "Gear" then
            footer.Text = "Equip owned items here. Shop for upgrades at the cabin. Finish a cast before changing gear."
            local order = 0
            for _, category in ipairs({ "auger", "rod", "bait", "lure" }) do
                for _, item in ipairs(Config.Gear[category]) do
                    local owned = category == "bait" and (item.amount == 0 or (profile.bait[item.id] or 0) &gt; 0) or category ~= "bait" and profile.owned[category][item.id]
                    if owned then
                        order = order + 1 local row = card(112) row.LayoutOrder = order
                        local view = Ui.make("ViewportFrame", row, { Size = UDim2.fromOffset(76, 88), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = c.dark, BorderSizePixel = 0 })
                        Ui.round(view) Preview.mount(view, category, item.id)
                        Ui.text(row, item.name, UDim2.new(1, -110, 0, mobile and 42 or 30), UDim2.fromOffset(96, 8), 16)
                        Ui.text(row, Config.gearStats(category, item), UDim2.new(1, mobile and -110 or -270, 0, 54), UDim2.fromOffset(96, mobile and 48 or 40), 11, c.muted)
                        Ui.button(row, profile.equipped[category] == item.id and "EQUIPPED" or "EQUIP", UDim2.fromOffset(130, 30), UDim2.new(1, -145, 0, mobile and 112 or 65), function()
                            send("equip", { category = category, id = item.id })
                        end, profile.equipped[category] == item.id and c.gold or c.mint)
                    end
                end
            end
        elseif active == "Journal" then
            local discovered = 0 for _, found in pairs(profile.discoveries) do if found then discovered = discovered + 1 end end
            footer.Text = discovered .. "/" .. #Config.Fish .. " species / " .. math.floor(discovered / #Config.Fish * 100) .. "% discovered. Milestones reward coins and XP."
            for i, species in ipairs(Config.Fish) do
                local found, record = profile.discoveries[species.id], profile.collection[species.id]
                local row = card(102) row.LayoutOrder = i
                preview(row, species.id, species.color, not found)
                Ui.text(row, found and species.name or "??? / Undiscovered", UDim2.new(1, mobile and -108 or -260, 0, mobile and 40 or 28), UDim2.fromOffset(mobile and 96 or 112, 9), 17, found and c.text or c.muted)
                local variants = {} if record then for variant, seen in pairs(record.variants) do if seen then table.insert(variants, variant) end end table.sort(variants) end
                Ui.text(row, found and ("Caught " .. (record and record.count or 1) .. " / Best " .. (record and record.biggest or 0) .. " kg\nVariants: " .. table.concat(variants, ", ")) or "Explore the lakes and try different bait.", UDim2.new(1, mobile and -108 or -260, 0, mobile and 85 or 46), UDim2.fromOffset(mobile and 96 or 112, mobile and 54 or 40), 12, c.muted)
                Ui.button(row, "VIEW", UDim2.fromOffset(76, 30), mobile and UDim2.fromOffset(8, 104) or UDim2.new(1, -95, 0, 35), function() showFish(species, not found) end, c.gold)
            end
        elseif active == "Quests" then
            footer.Text = "Accept before fishing. Claim earned rewards here; saved progress survives rejoining."
            for i, definition in ipairs(Content.Quests) do
                local state = profile.quests[definition.id]
                local row = card(118) row.LayoutOrder = i
                Ui.text(row, definition.title, UDim2.new(1, mobile and -28 or -210, 0, mobile and 38 or 28), UDim2.fromOffset(14, 8), 18, c.gold)
                Ui.text(row, definition.description .. "\n" .. definition.coins .. " coins / " .. definition.xp .. " XP / Level " .. definition.level, UDim2.new(1, mobile and -28 or -210, 0, mobile and 50 or 48), UDim2.fromOffset(14, mobile and 49 or 39), 13, c.muted)
                local label = not state and "ACCEPT" or (state.claimed and (definition.repeatSeconds and "REPEAT" or "COMPLETED") or (state.progress &gt;= definition.goal and "CLAIM" or (state.progress .. "/" .. definition.goal)))
                if state and ((state.claimed and not definition.repeatSeconds) or (not state.claimed and state.progress &lt; definition.goal)) then
                    local status = Ui.text(row, label, UDim2.fromOffset(150, 36), UDim2.new(1, -165, 0, mobile and 108 or 39), 14, c.gold)
                    status.TextXAlignment = Enum.TextXAlignment.Center
                else
                    Ui.button(row, label, UDim2.fromOffset(150, 36), UDim2.new(1, -165, 0, mobile and 108 or 39), function()
                        send("quest", { id = definition.id, mode = state and not state.claimed and "claim" or "accept" })
                    end, state and state.progress &gt;= definition.goal and c.gold or c.mint)
                end
            end
        elseif active == "Map" then
            footer.Text = "Use a trail board near a lake entrance. Unlocks are permanent; return trips are free."
            for i, region in ipairs(Content.Regions) do
                local row = card(104) row.LayoutOrder = i
                Ui.text(row, region.name, UDim2.new(1, mobile and -28 or -210, 0, 30), UDim2.fromOffset(14, 8), 19, c.gold)
                Ui.text(row, "Level " .. region.level .. " / " .. (profile.unlockedRegions[region.id] and "Trail unlocked" or (region.price .. " coins to unlock")) .. "\nRegional luck +" .. region.luck .. (i &gt; 1 and " / Unique regional species" or " / Beginner-friendly ice"), UDim2.new(1, mobile and -28 or -210, 0, 56), UDim2.fromOffset(14, 43), 13, c.muted)
                Ui.button(row, profile.unlockedRegions[region.id] and "TRAVEL" or "UNLOCK &amp; TRAVEL", UDim2.fromOffset(165, 38), UDim2.new(1, -180, 0, mobile and 109 or 34), function() send("travel", { id = region.id }) end)
            end
        elseif active == "Settings" then
            footer.Text = "Settings save with your profile. Reduced effects helps smaller devices."
            for i, key in ipairs({ "musicVolume", "sfxVolume", "reducedEffects", "highContrast" }) do
                local names = { musicVolume = "Music &amp; ambience", sfxVolume = "Sound effects", reducedEffects = "Reduced effects", highContrast = "High contrast menus" }
                local row = card(82) row.LayoutOrder = i
                local value = profile.settings[key]
                Ui.text(row, names[key], UDim2.new(1, -28, 0, 30), UDim2.fromOffset(14, 10), 17)
                if type(value) == "boolean" then
                    Ui.button(row, value and "ON" or "OFF", UDim2.fromOffset(150, 34), UDim2.new(1, -170, 0, mobile and 60 or 24), function() send("setting", { key = key, value = not value }) end, value and c.gold or c.mint)
                else
                    Ui.text(row, math.floor(value * 100) .. "%", UDim2.fromOffset(100, 30), UDim2.new(1, -210, 0, mobile and 60 or 24), 16)
                    Ui.button(row, "-", UDim2.fromOffset(55, 34), UDim2.new(1, -300, 0, mobile and 60 or 24), function() send("setting", { key = key, value = math.max(0, math.floor(value * 10 - 1) / 10) }) end)
                    Ui.button(row, "+", UDim2.fromOffset(55, 34), UDim2.new(1, -80, 0, mobile and 60 or 24), function() send("setting", { key = key, value = math.min(1, math.floor(value * 10 + 1) / 10) }) end)
                end
            end
        else
            local step = profile.tutorial.step
            footer.Text = profile.tutorial.completed and "Guide completed. These instructions remain available." or ("Current step " .. step .. " of " .. #Content.Tutorial .. " / Talk to Nolan at the outpost.")
            for i, instruction in ipairs(Content.Tutorial) do
                local row = card(100) row.LayoutOrder = i
                Ui.text(row, i .. " / " .. instruction.title .. (i &lt; step and " / DONE" or ""), UDim2.new(1, -28, 0, 34), UDim2.fromOffset(14, 8), 18, i == step and c.gold or c.text)
                Ui.text(row, instruction.description, UDim2.new(1, -28, 0, mobile and 94 or 52), UDim2.fromOffset(14, 43), 13, c.muted)
            end
            if not profile.tutorial.completed then
                local row = card(48)
                row.LayoutOrder = 100
                Ui.button(row, "SKIP TUTORIAL", UDim2.fromOffset(200, 32), UDim2.fromOffset(14, 8), function() send("tutorial", { skip = true }) end, c.gold)
            end
        end
        list.CanvasPosition = position
    end
    search:GetPropertyChangedSignal("Text"):Connect(function() query = search.Text if shade.Visible and active == "Inventory" then render() end end)
    local api = {}
    function api.open(name)
        if not profile then return end
        active, detailId = name or "Inventory", nil
        onOpen() shade.Visible = true render()
        panel.Position = UDim2.fromScale(0.5, 0.53)
        TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.5) }):Play()
    end
    function api.close() shade.Visible = false end
    local catchCard = Ui.frame(gui, UDim2.fromOffset(420, 204), UDim2.new(0.5, -210, 0.2, 0))
    catchCard.Visible, catchCard.ZIndex = false, 4
    local catchScale = Ui.make("UIScale", catchCard, { Scale = 1 })
    local catchText = Ui.text(catchCard, "", UDim2.fromOffset(260, 152), UDim2.fromOffset(148, 26), 16)
    Ui.button(catchCard, "X", UDim2.fromOffset(30, 26), UDim2.new(1, -38, 0, 6), function() catchCard.Visible = false end, c.gold)
    local serial = 0
    event.OnClientEvent:Connect(function(kind, data)
        if kind == "profile" then
            profile = data
            c.text = data.settings.highContrast and Color3.new(1, 1, 1) or Color3.fromRGB(232, 245, 249)
            c.muted = data.settings.highContrast and Color3.fromRGB(233, 233, 233) or Color3.fromRGB(170, 198, 211)
            if shade.Visible then render() end
        elseif kind == "openContent" then api.open(data)
        elseif kind == "stage" then api.close() catchCard.Visible = false
        elseif kind == "caught" then
            serial = serial + 1 local current = serial
            local old = catchCard:FindFirstChild("CatchPreview") if old then old:Destroy() end
            local view = Ui.make("ViewportFrame", catchCard, { Name = "CatchPreview", Size = UDim2.fromOffset(132, 176), Position = UDim2.fromOffset(8, 14), BackgroundTransparency = 1 })
            Preview.fish(view, data.species, data.color)
            catchText.Text = data.name .. "\n" .. data.variant .. " / " .. data.rarity .. "\n" .. data.kg .. " kg / " .. data.value .. " coins\n+" .. data.xp .. " XP" .. (data.discovery and " / NEW" or "") .. (data.trophy and "\nTROPHY CATCH" or "")
            catchCard.Visible = true
            task.delay(data.rarity == "Legendary" and 7 or 5, function() if current == serial then catchCard.Visible = false end end)
        end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        local keys = { [Enum.KeyCode.J] = "Journal", [Enum.KeyCode.K] = "Quests", [Enum.KeyCode.M] = "Map", [Enum.KeyCode.O] = "Settings", [Enum.KeyCode.H] = "Guide" }
        if keys[input.KeyCode] then api.open(keys[input.KeyCode]) end
    end)
    RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if camera then
            if camera.ViewportSize ~= lastViewport then
                lastViewport = camera.ViewportSize
                mobile = lastViewport.X &lt; 650
                panelWidth, panelHeight = math.min(760, lastViewport.X - 20), math.min(590, lastViewport.Y - 60)
                panel.Size, scale.Scale = UDim2.fromOffset(panelWidth, panelHeight), 1
                info.Size, info.Position = UDim2.new(1, -40, 0, 120), UDim2.new(0, 20, 1, -145)
                local view = inspect:FindFirstChild("FishPreview")
                if view then view.Size = UDim2.new(1, -40, 1, -240) end
                if profile and shade.Visible then render() end
            end
            catchScale.Scale = math.min(1, (camera.ViewportSize.X - 20) / 420)
            catchCard.AnchorPoint, catchCard.Position = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0.18, 0)
        end
    end)
    return api
end
return Adventure
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX35">
          <Properties>
            <string name="Name">AnglerAnimation</string>
            <ProtectedString name="Source">-- Procedural R6/R15 poses need no uploaded animation IDs or asset permissions.
-- Character attributes replicate the activity; each client animates all anglers.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Animation = {}

function Animation.start()
    local rigs = {}
    return RunService.RenderStepped:Connect(function(dt)
        local seen = {}
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            if character then
                seen[character] = true
                local stage = character:GetAttribute("FishingStage")
                local resultAt = character:GetAttribute("FishingResultAt") or -100
                if not stage and character:GetAttribute("FishingResult") == "caught" and workspace:GetServerTimeNow() - resultAt &lt; 0.8 then stage = "landing" end
                local rig = rigs[character]
                if stage and not rig then
                    rig = { motors = {}, blend = 0 }
                    for _, m in ipairs(character:GetDescendants()) do
                        if m:IsA("Motor6D") and (m.Name == "RightShoulder" or m.Name == "LeftShoulder"
                            or m.Name == "Right Shoulder" or m.Name == "Left Shoulder" or m.Name == "Waist"
                            or m.Name == "Neck" or m.Name == "LeftWrist") then
                            table.insert(rig.motors, { motor = m, base = m.C0 })
                        end
                    end
                    rigs[character] = rig
                end
                if rig then
                    local alpha = 1 - math.exp(-14 * math.min(dt, 0.1))
                    rig.blend = rig.blend + ((stage and 1 or 0) - rig.blend) * alpha
                    local t = workspace:GetServerTimeNow() - (stage == "landing" and resultAt or character:GetAttribute("FishingStageAt") or 0)
                    local drilling, reeling = stage == "drilling", stage == "reeling"
                    local cycle = math.sin(t * (drilling and 10 or reeling and 9 or 2))
                    local lift = stage == "landing" and (65 + math.sin(t / 0.8 * math.pi) * 35) or (stage == "hooking" and 85) or drilling and 78 or (stage == "casting" and (62 + math.sin(math.min(t / 0.8, 1) * math.pi) * 30) or 58)
                    for _, entry in ipairs(rig.motors) do
                        local m, pose = entry.motor, CFrame.new()
                        if m.Parent then
                            if m.Name == "RightShoulder" then pose = CFrame.Angles(math.rad(lift + cycle * 3), math.rad(-10), math.rad(12))
                            elseif m.Name == "LeftShoulder" then pose = CFrame.Angles(math.rad(lift - 6 + cycle * (reeling and 9 or 3)), math.rad(20), math.rad(-25))
                            elseif m.Name == "Right Shoulder" then pose = CFrame.Angles(0, math.rad(-10), math.rad(lift + cycle * 3))
                            elseif m.Name == "Left Shoulder" then pose = CFrame.Angles(0, math.rad(15), math.rad(-lift + 10 - cycle * 6))
                            elseif m.Name == "LeftWrist" then pose = CFrame.Angles(reeling and math.sin(t * 10) * 0.3 or 0, 0, 0)
                            elseif m.Name == "Waist" then pose = CFrame.Angles(math.rad(8 + cycle), 0, 0)
                            elseif m.Name == "Neck" then pose = CFrame.Angles(math.rad(-9), 0, 0) end
                            m.C0 = entry.base * CFrame.new():Lerp(pose, rig.blend)
                        end
                    end
                    if not stage and rig.blend &lt; 0.001 then
                        for _, entry in ipairs(rig.motors) do if entry.motor.Parent then entry.motor.C0 = entry.base end end
                        rigs[character] = nil
                    end
                end
            end
        end
        for character in pairs(rigs) do if not seen[character] then rigs[character] = nil end end
    end)
end
return Animation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX36">
          <Properties>
            <string name="Name">EquipmentPreview</string>
            <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Equipment = require(ReplicatedStorage.Shared.Equipment)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local Preview = {}
local views, dragging = {}, nil

local function mountModel(viewport, model)
    local world = Instance.new("WorldModel")
    world.Parent = viewport
    model.Parent = world
    local bounds, size = model:GetBoundingBox()
    model:PivotTo(CFrame.new(-bounds.Position) * model:GetPivot())
    local base = model:GetPivot()
    local camera = Instance.new("Camera")
    camera.FieldOfView = 36
    camera.Parent, viewport.CurrentCamera = viewport, camera
    viewport.Ambient, viewport.LightColor = Color3.fromRGB(180, 198, 213), Color3.fromRGB(255, 236, 209)
    viewport.LightDirection = Vector3.new(-1, -0.6, -1)
    local view = { model = model, camera = camera, viewport = viewport, base = base,
        angle = 0.4, height = size.Y, width = math.max(size.X, size.Z), zoom = 1 }
    views[viewport] = view
    viewport.Active = true
    viewport.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = { view = view, input = input, x = input.Position.X }
        end
    end)
    viewport.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then view.zoom = math.max(0.75, math.min(1.5, view.zoom - input.Position.Z * 0.1)) end
    end)
    viewport.Destroying:Connect(function()
        views[viewport] = nil
        if dragging and dragging.view == view then dragging = nil end
    end)
end

function Preview.mount(viewport, category, id) mountModel(viewport, Equipment.build(category, id)) end
function Preview.fish(viewport, species, color, silhouette) mountModel(viewport, FishModels.build(species, color, silhouette)) end
local function visible(viewport)
    local node = viewport
    while node do
        if node:IsA("GuiObject") and not node.Visible then return false end
        node = node.Parent
    end
    return true
end

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragging.input) then
        dragging.view.angle = dragging.view.angle + (input.Position.X - dragging.x) * 0.012
        dragging.x = input.Position.X
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if dragging and (input == dragging.input or input.UserInputType == Enum.UserInputType.MouseButton1) then dragging = nil end
end)
UserInputService.WindowFocusReleased:Connect(function() dragging = nil end)

function Preview.step(dt)
    for viewport, v in pairs(views) do
        if viewport.Parent and visible(viewport) then
            if not dragging or dragging.view ~= v then v.angle = v.angle + dt * 0.35 end
            v.model:PivotTo(CFrame.Angles(0, v.angle, 0) * v.base)
            local aspect = math.max(0.2, viewport.AbsoluteSize.X / math.max(1, viewport.AbsoluteSize.Y))
            local distance = math.max(v.height, v.width / aspect) / (2 * math.tan(math.rad(18))) * 1.22 * v.zoom
            v.camera.CFrame = CFrame.lookAt(Vector3.new(0, v.height * 0.06, distance), Vector3.new())
        end
    end
end
return Preview
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX37">
          <Properties>
            <string name="Name">Feedback</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Content = require(ReplicatedStorage.Shared.Content)
local Audio = require(ReplicatedStorage.Shared.AudioConfig)
local Feedback = {}
function Feedback.start(remotes)
    local settings, loops = { musicVolume = 0.35, sfxVolume = 0.65, reducedEffects = false }, {}
    local sfxGroup, musicGroup = Instance.new("SoundGroup"), Instance.new("SoundGroup")
    sfxGroup.Name, musicGroup.Name = "FrostbiteSFX", "FrostbiteMusic"
    sfxGroup.Parent, musicGroup.Parent = SoundService, SoundService
    local function sound(key, loop)
        local id = Audio[key]
        local placeholder = not id or #id == 0
        if placeholder then
            if loop or not Audio.useBundledPlaceholders or key == "splash" then return nil end
            id = "rbxasset://sounds/electronicpingshort.wav"
        end
        local item = Instance.new("Sound")
        item.Name, item.SoundId, item.Looped = "Frostbite_" .. key, id, loop or false
        item.SoundGroup = (key == "music" or key == "wind") and musicGroup or sfxGroup
        item.Volume = key == "wind" and 0.3 or 0.45
        item.PlaybackSpeed = placeholder and (key == "level" and 1.3 or key == "coins" and 1.7 or 1) or 1
        item.Parent = SoundService
        item:Play()
        if not loop then Debris:AddItem(item, 10) end
        return item
    end
    local function stopLoop(key) if loops[key] then loops[key]:Destroy() loops[key] = nil end end
    loops.wind, loops.music = sound("wind", true), sound("music", true)
    local snow = Instance.new("Part")
    snow.Name, snow.Size, snow.Transparency, snow.Anchored = "LocalSnowfall", Vector3.new(65, 0.2, 65), 1, true
    snow.CanCollide, snow.CanQuery, snow.CanTouch, snow.CastShadow, snow.Parent = false, false, false, false, workspace
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Lifetime, emitter.Speed, emitter.EmissionDirection = NumberRange.new(4, 6), NumberRange.new(5, 10), Enum.NormalId.Bottom
    emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.11), NumberSequenceKeypoint.new(1, 0.06) })
    emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(0.9, 0.3), NumberSequenceKeypoint.new(1, 1) })
    emitter.Acceleration, emitter.SpreadAngle, emitter.Parent = Vector3.new(-1.5, -1, 0.6), Vector2.new(12, 12), snow
    local aurora = {}
    for i = 1, 3 do
        local holder = Instance.new("Part")
        holder.Name, holder.Size, holder.Transparency, holder.Anchored = "LocalAurora", Vector3.new(1, 1, 1), 1, true
        holder.CanCollide, holder.CanQuery, holder.CanTouch, holder.CastShadow, holder.Parent = false, false, false, false, workspace
        local a, b = Instance.new("Attachment"), Instance.new("Attachment")
        a.Position, b.Position, a.Parent, b.Parent = Vector3.new(-120, 0, 0), Vector3.new(120, 0, 0), holder, holder
        local beam = Instance.new("Beam")
        beam.Attachment0, beam.Attachment1, beam.Width0, beam.Width1 = a, b, 10 + i * 4, 13 + i * 4
        beam.Segments, beam.FaceCamera, beam.LightEmission = 32, true, 0.8
        beam.Color = ColorSequence.new(Color3.fromRGB(90, 235, 195), Color3.fromRGB(171, 126, 245))
        beam.Transparency, beam.CurveSize0, beam.CurveSize1, beam.Parent = NumberSequence.new(0.65), 30 * i, -25 * i, holder
        table.insert(aurora, { part = holder, beam = beam })
    end
    local accumulator = 0
    RunService.RenderStepped:Connect(function(dt)
        accumulator = accumulator + dt
        local camera = workspace.CurrentCamera
        if not camera then return end
        snow.Position = camera.CFrame.Position + Vector3.new(0, 25, 0)
        if accumulator &gt; 0.2 then
            accumulator = 0
            local weather = Content.weather(workspace:GetAttribute("Weather"))
            emitter.Rate = settings.reducedEffects and math.min(8, weather.snow) or weather.snow
            sfxGroup.Volume, musicGroup.Volume = settings.sfxVolume, settings.musicVolume
            for i, ribbon in ipairs(aurora) do
                ribbon.beam.Enabled = weather.id == "Aurora" and not settings.reducedEffects
                ribbon.part.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 85 + i * 8, -100 - i * 10)) * CFrame.Angles(0, 0.1 * math.sin(workspace:GetServerTimeNow() * 0.1 + i), 0)
            end
        end
    end)
    remotes.Event.OnClientEvent:Connect(function(kind, data)
        if kind == "profile" then settings = data.settings
        elseif kind == "stage" then
            stopLoop("drill") stopLoop("reel")
            if data.stage == "drilling" then loops.drill = sound("drill", true) elseif data.stage == "waiting" then sound("splash") end
        elseif kind == "hook" then sound("bite")
        elseif kind == "bite" then loops.reel = sound("reel", true)
        elseif kind == "caught" then
            stopLoop("reel") sound(data.discovery and "discovery" or "catch")
            if data.rarity == "Legendary" or data.rarity == "Epic" then sound("level") end
        elseif kind == "ended" then stopLoop("drill") stopLoop("reel")
        elseif kind == "feedback" then sound(data) end
    end)
    Players.LocalPlayer.CharacterRemoving:Connect(function() stopLoop("drill") stopLoop("reel") end)
    if Audio.music == "" then warn("[Audio] Original WAVs are in assets/audio. Assign uploaded asset IDs in Shared.AudioConfig; bundled UI pings are temporary placeholders.") end
end
return Feedback
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX38">
          <Properties>
            <string name="Name">Game</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Reel = require(ReplicatedStorage.Shared:WaitForChild("Reel"))
local Progression = require(ReplicatedStorage.Shared:WaitForChild("Progression"))
local Content = require(ReplicatedStorage.Shared:WaitForChild("Content"))
local Inventory = require(ReplicatedStorage.Shared:WaitForChild("Inventory"))
local Preview = require(script.Parent:WaitForChild("EquipmentPreview"))
require(script.Parent:WaitForChild("AnglerAnimation")).start()
local remotes = ReplicatedStorage:WaitForChild("FishingRemotes")
local command, event = remotes:WaitForChild("Command"), remotes:WaitForChild("Event")
local C = {
    panel = Color3.fromRGB(20, 41, 54), card = Color3.fromRGB(32, 57, 71),
    text = Color3.fromRGB(232, 245, 249), muted = Color3.fromRGB(167, 196, 208),
    mint = Color3.fromRGB(131, 230, 201), gold = Color3.fromRGB(255, 213, 136),
    red = Color3.fromRGB(248, 134, 137), dark = Color3.fromRGB(16, 33, 44),
}
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "FrostbiteUI", false, Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function make(class, parent, props)
    local object = Instance.new(class)
    for k, v in pairs(props or {}) do object[k] = v end
    object.Parent = parent
    return object
end
local function rounded(object, radius)
    make("UICorner", object, { CornerRadius = UDim.new(0, radius or 12) })
end
local function frame(parent, size, position, color)
    local f = make("Frame", parent, { Size = size, Position = position, BackgroundColor3 = color or C.panel, BorderSizePixel = 0 })
    rounded(f)
    return f
end
local function text(parent, value, size, position, fontSize, color)
    return make("TextLabel", parent, { Text = value, Size = size, Position = position,
        BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = fontSize or 15,
        TextColor3 = color or C.text, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
end
local function button(parent, value, size, position, callback, color)
    local b = make("TextButton", parent, { Text = value, Size = size, Position = position,
        BackgroundColor3 = color or C.mint, TextColor3 = C.dark, BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = true })
    rounded(b, 9)
    if callback then b.Activated:Connect(callback) end
    return b
end
local function send(action, data) command:FireServer(action, data) end
local profile, activeTab, modalMode = nil, "auger", "shop"
local shopMobile = false
local fishing, token, held = false, nil, false
local reelView, jumpLock = nil, nil
local drillingInfo, hookingInfo = nil, nil
local adventure
local keyHeld, reelPointer = false, nil

local brand = frame(gui, UDim2.fromOffset(252, 76), UDim2.fromOffset(16, 16))
text(brand, "F R O S T B I T E", UDim2.new(1, -28, 0, 28), UDim2.fromOffset(14, 10), 20, C.mint).Font = Enum.Font.GothamBold
text(brand, "ICE FISHING  /  FROZEN WILDERNESS", UDim2.new(1, -28, 0, 20), UDim2.fromOffset(14, 43), 10, C.muted)
local wallet = frame(gui, UDim2.fromOffset(190, 138), UDim2.new(1, -206, 0, 16))
local coins = text(wallet, "120 coins", UDim2.new(1, -24, 0, 30), UDim2.fromOffset(12, 9), 21, C.gold)
coins.Font = Enum.Font.GothamBold
local bagCount = text(wallet, "Loading your profile...", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 43), 13, C.muted)
local levelLabel = text(wallet, "Level 1", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 68), 11, C.mint)
local xpTrack = frame(wallet, UDim2.new(1, -24, 0, 7), UDim2.fromOffset(12, 136), C.dark)
local xpFill = frame(xpTrack, UDim2.fromScale(0, 1), UDim2.fromOffset(0, 0), C.mint)
local dataMode = text(wallet, "Loading saved progress...", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 106), 10, C.muted)
player:GetAttributeChangedSignal("DataMode"):Connect(function() dataMode.Text = player:GetAttribute("DataMode") or "Loading saved progress..." end)
local guide = frame(gui, UDim2.fromOffset(246, 167), UDim2.fromOffset(16, 108))
text(guide, "A QUIET DAY ON THE ICE", UDim2.fromOffset(218, 26), UDim2.fromOffset(14, 10), 12, C.gold).Font = Enum.Font.GothamBold
text(guide, "01  Walk onto the frozen pond\n02  Drill once, reuse your hole\n03  Hook the bite, then track the fish\n04  Sell fish at the cabin for gear", UDim2.fromOffset(218, 110), UDim2.fromOffset(14, 43), 14, C.muted)

local dock = frame(gui, UDim2.fromOffset(468, 166), UDim2.new(0.5, -234, 1, -106))
local castButton = button(dock, "DRILL / CAST  [F]", UDim2.fromOffset(208, 42), UDim2.fromOffset(12, 10), function() send(fishing and "cancel" or "cast") end)
button(dock, "SHOP  [B]", UDim2.fromOffset(108, 42), UDim2.fromOffset(230, 10), function() send("shop") end, C.gold)
local openBag
button(dock, "BAG  [I]", UDim2.fromOffset(108, 42), UDim2.fromOffset(348, 10), function() if openBag then openBag() end end, Color3.fromRGB(191, 218, 232))
button(dock, "NEW HOLE  [G]  /  replaces your previous hole", UDim2.new(1, -24, 0, 27), UDim2.fromOffset(12, 59), function()
    if not fishing then send("drill") end
end, Color3.fromRGB(191, 218, 232))
for i, page in ipairs({ "Journal", "Quests", "Map", "Settings" }) do
    button(dock, page:upper(), UDim2.fromOffset(103, 29), UDim2.fromOffset(12 + (i - 1) * 113, 94), function()
        if adventure then adventure.open(page) end
    end, Color3.fromRGB(191, 218, 232))
end
local area = frame(gui, UDim2.fromOffset(230, 55), UDim2.new(0.5, -115, 0, 16))
local areaText = text(area, "Frostbite Pond", UDim2.new(1, -20, 1, -12), UDim2.fromOffset(10, 6), 12, C.muted)
areaText.TextXAlignment = Enum.TextXAlignment.Center
local loadout = text(dock, "Walk onto the ice to begin", UDim2.new(1, -24, 0, 20), UDim2.fromOffset(12, 136), 11, C.muted)
loadout.TextXAlignment = Enum.TextXAlignment.Center

local toast = frame(gui, UDim2.new(0.8, 0, 0, 72), UDim2.new(0.1, 0, 0, 104))
toast.Visible = false
make("UISizeConstraint", toast, { MaxSize = Vector2.new(580, 90) })
toast.AnchorPoint, toast.Position = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 104)
local toastText = text(toast, "", UDim2.new(1, -28, 1, -16), UDim2.fromOffset(14, 8), 16)
toastText.TextXAlignment = Enum.TextXAlignment.Center
local toastId = 0
local function notice(message, color)
    toastId = toastId + 1
    local id = toastId
    toastText.Text, toastText.TextColor3, toast.Visible = message, color or C.text, true
    task.delay(4.5, function() if toastId == id then toast.Visible = false end end)
end

local shade = make("TextButton", gui, { Text = "", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, Visible = false, AutoButtonColor = false })
local modal = frame(shade, UDim2.fromOffset(650, 530), UDim2.fromScale(0.5, 0.5))
modal.AnchorPoint = Vector2.new(0.5, 0.5)
local modalScale = make("UIScale", modal, { Scale = 1 })
local modalTitle = text(modal, "FROSTBITE TACKLE", UDim2.new(1, -90, 0, 34), UDim2.fromOffset(22, 16), 23, C.gold)
modalTitle.Font = Enum.Font.GothamBold
local modalSubtitle = text(modal, "Better gear. Bigger holes. Rarer fish.", UDim2.new(1, -44, 0, 24), UDim2.fromOffset(22, 52), 14, C.muted)
button(modal, "X", UDim2.fromOffset(36, 36), UDim2.new(1, -54, 0, 18), function() shade.Visible = false end, Color3.fromRGB(181, 203, 213))
local tabs = frame(modal, UDim2.new(1, -44, 0, 40), UDim2.fromOffset(22, 88), C.dark)
local list = make("ScrollingFrame", modal, { Size = UDim2.new(1, -44, 1, -208), Position = UDim2.fromOffset(22, 140), BackgroundTransparency = 1,
    BorderSizePixel = 0, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ScrollBarImageColor3 = C.muted })
make("UIListLayout", list, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
make("UIPadding", list, { PaddingBottom = UDim.new(0, 6), PaddingRight = UDim.new(0, 8) })
local sell = button(modal, "SELL ALL FISH", UDim2.new(1, -44, 0, 40), UDim2.new(0, 22, 1, -54), function() send("sell") end, C.gold)
local tabButtons, render = {}, nil
for i, category in ipairs({ "auger", "rod", "bait", "lure" }) do
    tabButtons[category] = button(tabs, string.upper(category) .. "S", UDim2.new(0.25, -6, 1, -8), UDim2.new((i - 1) * 0.25, 3, 0, 4), function()
        activeTab = category
        if render then render() end
    end, C.card)
end

local inspection = frame(modal, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), C.panel)
inspection.Visible = false
local inspectTitle = text(inspection, "EQUIPMENT", UDim2.new(1, -140, 0, 38), UDim2.fromOffset(22, 18), 22, C.gold)
inspectTitle.Font = Enum.Font.GothamBold
button(inspection, "BACK", UDim2.fromOffset(90, 34), UDim2.new(1, -112, 0, 18), function() inspection.Visible = false end, C.gold)
local inspectDescription = text(inspection, "", UDim2.new(1, -44, 0, 45), UDim2.new(0, 22, 1, -95), 15, C.muted)
text(inspection, "Drag to rotate  /  Scroll to zoom", UDim2.new(1, -44, 0, 24), UDim2.new(0, 22, 1, -36), 12, C.mint).TextXAlignment = Enum.TextXAlignment.Center
local function inspect(category, item)
    local old = inspection:FindFirstChild("EquipmentView")
    if old then old:Destroy() end
    inspectTitle.Text, inspectDescription.Text = item.name, item.description
    local viewport = make("ViewportFrame", inspection, { Name = "EquipmentView", Size = UDim2.new(1, -44, 1, -180), Position = UDim2.fromOffset(22, 68),
        BackgroundColor3 = C.dark, BorderSizePixel = 0 })
    rounded(viewport)
    Preview.mount(viewport, category, item.id)
    inspection.Visible = true
end

local function bagValue(sellable)
    local sum = 0
    if profile then for _, fish in ipairs(profile.bag) do if not sellable or not Inventory.protected(fish) then sum = sum + fish.value end end end
    return sum
end

render = function()
    for _, child in ipairs(list:GetChildren()) do if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end end
    if not profile then return end
    inspection.Visible = false
    local isShop = modalMode == "shop"
    tabs.Visible = isShop
    modalTitle.Text = isShop and "FROSTBITE TACKLE" or "YOUR FISH BAG"
    modalSubtitle.Text = isShop and ("Balance: " .. profile.coins .. " coins  /  Purchases auto-equip") or "Bring your catch to the cabin to sell it."
    list.Position = UDim2.fromOffset(22, isShop and 140 or 90)
    list.Size = UDim2.new(1, -44, 1, isShop and -208 or -158)
    sell.Text = "SELL UNPROTECTED  /  " .. bagValue(true) .. " COINS"
    for category, b in pairs(tabButtons) do
        b.BackgroundColor3 = category == activeTab and C.mint or C.card
        b.TextColor3 = category == activeTab and C.dark or C.muted
    end
    if isShop then
        for i, item in ipairs(Config.Gear[activeTab]) do
            local category = activeTab
            local card = frame(list, UDim2.new(1, 0, 0, shopMobile and 206 or 124), UDim2.fromOffset(0, 0), C.card)
            card.LayoutOrder = i
            local viewport = make("ViewportFrame", card, { Size = UDim2.fromOffset(88, 86), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.dark, BorderSizePixel = 0 })
            rounded(viewport, 8)
            Preview.mount(viewport, category, item.id)
            button(card, "3D VIEW", UDim2.fromOffset(88, 22), UDim2.fromOffset(8, 97), function() inspect(category, item) end, C.gold)
            text(card, item.name, UDim2.new(1, shopMobile and -126 or -270, 0, shopMobile and 42 or 28), UDim2.fromOffset(110, 8), 16).Font = Enum.Font.GothamBold
            text(card, item.description, UDim2.new(1, shopMobile and -126 or -276, 0, shopMobile and 66 or 40), UDim2.fromOffset(110, shopMobile and 54 or 38), 12, C.muted)
            text(card, Config.gearStats(category, item), UDim2.new(1, shopMobile and -28 or -276, 0, 37), UDim2.fromOffset(shopMobile and 14 or 110, shopMobile and 128 or 82), 10, C.mint)
            local equipped = profile.equipped[category] == item.id
            local owned = category ~= "bait" and profile.owned[category][item.id]
            local stock = category == "bait" and (profile.bait[item.id] or 0) or 0
            local hasBait = category == "bait" and (item.amount == 0 or stock &gt; 0)
            local caption = equipped and "EQUIPPED" or ((owned or hasBait) and "EQUIP" or (item.cost .. " COINS"))
            local locked = not owned and (profile.level or 1) &lt; (item.requiredLevel or 1)
            if locked then caption = "LEVEL " .. item.requiredLevel end
            if category == "bait" and equipped and item.amount &gt; 0 then caption = "+10 / " .. item.cost .. " COINS" end
            button(card, caption, UDim2.fromOffset(136, 36), UDim2.new(1, -150, 0, shopMobile and 166 or 22), function()
                send("buy", { category = category, id = item.id, equip = hasBait and not equipped })
            end, equipped and C.gold or C.mint)
            if category == "bait" then
                text(card, item.amount == 0 and "Unlimited" or (stock .. " casts left"), UDim2.fromOffset(136, 22), shopMobile and UDim2.fromOffset(12, 170) or UDim2.new(1, -150, 0, 63), 12, C.muted).TextXAlignment = Enum.TextXAlignment.Center
            end
        end
    else
        if #profile.bag == 0 then text(list, "Your next great catch is under the ice.", UDim2.new(1, 0, 0, 90), UDim2.fromOffset(0, 0), 18, C.muted) end
        for i = #profile.bag, 1, -1 do
            local fish = profile.bag[i]
            local card = frame(list, UDim2.new(1, 0, 0, 72), UDim2.fromOffset(0, 0), C.card)
            card.LayoutOrder = #profile.bag - i
            text(card, fish.name, UDim2.new(1, -150, 0, 30), UDim2.fromOffset(14, 7), 17, Color3.fromRGB(fish.color[1], fish.color[2], fish.color[3])).Font = Enum.Font.GothamBold
            text(card, fish.rarity .. "  /  " .. fish.kg .. " kg", UDim2.new(1, -150, 0, 23), UDim2.fromOffset(14, 39), 13, C.muted)
            text(card, fish.value .. " coins", UDim2.fromOffset(120, 40), UDim2.new(1, -132, 0, 16), 17, C.gold).TextXAlignment = Enum.TextXAlignment.Right
        end
    end
    list.CanvasPosition = Vector2.zero
end

adventure = require(script.Parent:WaitForChild("AdventureUI")).start(gui, remotes, function() shade.Visible = false end)
openBag = function() adventure.open("Inventory") end

local reel = frame(gui, UDim2.fromOffset(490, 218), UDim2.new(0.5, -245, 1, -338))
reel.Visible = false
local reelTitle = text(reel, "WAITING FOR A BITE...", UDim2.new(1, -28, 0, 28), UDim2.fromOffset(14, 10), 17, C.gold)
reelTitle.Font, reelTitle.TextXAlignment = Enum.Font.GothamBold, Enum.TextXAlignment.Center
local track = frame(reel, UDim2.new(1, -44, 0, 40), UDim2.fromOffset(22, 48), C.dark)
track.ClipsDescendants = true
local zone = frame(track, UDim2.fromScale(0.23, 1), UDim2.fromScale(0.5, 0), C.mint)
zone.BackgroundTransparency, zone.AnchorPoint = 0.3, Vector2.new(0.5, 0)
local marker = frame(track, UDim2.new(0, 6, 1, -8), UDim2.new(0.5, 0, 0, 4), C.gold)
marker.AnchorPoint = Vector2.new(0.5, 0)
local caption = text(reel, "Keep the gold fish marker inside your green zone", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 92), 12, C.muted)
caption.TextXAlignment = Enum.TextXAlignment.Center
local progressBack = frame(reel, UDim2.new(0.64, -20, 0, 8), UDim2.fromOffset(22, 123), C.dark)
local progressFill = frame(progressBack, UDim2.fromScale(0.25, 1), UDim2.fromOffset(0, 0), C.mint)
local tensionBack = frame(reel, UDim2.new(0.3, 0, 0, 8), UDim2.new(0.66, 0, 0, 123), C.dark)
local tensionFill = frame(tensionBack, UDim2.fromScale(0, 1), UDim2.fromOffset(0, 0), C.red)
local progressLabel = text(reel, "CATCH PROGRESS", UDim2.fromOffset(180, 20), UDim2.fromOffset(22, 134), 10, C.muted)
local tensionLabel = text(reel, "LINE TENSION", UDim2.fromOffset(140, 20), UDim2.new(0.66, 0, 0, 134), 10, C.red)
local holdButton = button(reel, "HOLD / SPACE TO REEL", UDim2.new(1, -44, 0, 43), UDim2.fromOffset(22, 162), nil)

local function updateHeld()
    held = keyHeld or reelPointer ~= nil
    if token then send("input", { token = token, held = held }) end
end
local function lockJump()
    if jumpLock then return end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        jumpLock = { humanoid = humanoid, enabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping) }
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        humanoid.Jump = false
    end
    ContextActionService:BindActionAtPriority("FrostbiteReel", function(_, state)
        keyHeld = state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox()
        updateHeld()
        return Enum.ContextActionResult.Sink
    end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
end
local function releaseJump()
    ContextActionService:UnbindAction("FrostbiteReel")
    if jumpLock and jumpLock.humanoid.Parent then
        jumpLock.humanoid.Jump = false
        jumpLock.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, jumpLock.enabled)
    end
    jumpLock = nil
end
holdButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        reelPointer = input
        updateHeld()
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input == reelPointer or (reelPointer and input.UserInputType == Enum.UserInputType.MouseButton1) then reelPointer = nil updateHeld() end
end)
UserInputService.WindowFocusReleased:Connect(function() keyHeld, reelPointer = false, nil updateHeld() end)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.F then send(fishing and "cancel" or "cast")
    elseif input.KeyCode == Enum.KeyCode.G and not fishing then send("drill")
    elseif input.KeyCode == Enum.KeyCode.B then send("shop")
    elseif input.KeyCode == Enum.KeyCode.I or input.KeyCode == Enum.KeyCode.ButtonR1 then openBag()
    elseif input.KeyCode == Enum.KeyCode.ButtonX then send(fishing and "cancel" or "cast")
    elseif input.KeyCode == Enum.KeyCode.ButtonY then send("shop") end
end)

local function endFishing()
    fishing, token, held, reel.Visible = false, nil, false, false
    keyHeld, reelPointer, reelView, drillingInfo, hookingInfo = false, nil, nil, nil, nil
    releaseJump()
    castButton.Text = "DRILL / CAST  [F]"
end
player.CharacterRemoving:Connect(endFishing)
local function drawReel(data)
    zone.Position, zone.Size = UDim2.fromScale(data.bar, 0), UDim2.fromScale(data.width, 1)
    marker.Position = UDim2.new(data.target, 0, 0, 4)
    progressFill.Size, tensionFill.Size = UDim2.fromScale(data.progress, 1), UDim2.fromScale(data.tension, 1)
end

event.OnClientEvent:Connect(function(kind, data)
    if kind == "profile" then
        profile = data
        local progress = Progression.describe(data.xp)
        levelLabel.Text = "Level " .. progress.level .. "  /  " .. progress.current .. " of " .. progress.required .. " XP"
        xpFill.Size = UDim2.fromScale(progress.fraction, 1)
        dataMode.Text = player:GetAttribute("DataMode") or "Saved progression"
        coins.Text, bagCount.Text = data.coins .. " coins", #data.bag .. " fish  /  " .. bagValue() .. " coin value"
        local names = {}
        for _, category in ipairs({ "auger", "rod", "lure", "bait" }) do
            table.insert(names, Config.gearName(category, data.equipped[category]))
        end
        loadout.Text = table.concat(names, "  /  ")
        if shade.Visible then render() end
    elseif kind == "notice" then notice(data)
    elseif kind == "shop" then adventure.close() modalMode = "shop" render() shade.Visible = true
    elseif kind == "stage" then
        hookingInfo = nil
        holdButton.Text = "HOLD / SPACE / A TO REEL"
        drillingInfo = data.stage == "drilling" and data or nil
        progressLabel.Text = drillingInfo and "DRILL PROGRESS" or "CATCH PROGRESS"
        tensionLabel.Visible, tensionBack.Visible = false, false
        fishing, token, held, reelView = true, data.token, false, nil
        keyHeld, reelPointer = false, nil
        lockJump()
        shade.Visible, reel.Visible, track.Visible, holdButton.Visible = false, true, false, false
        if data.stage == "drilling" then
            reelTitle.Text, caption.Text = "CUTTING THROUGH THE ICE", "Your auger is making a permanent fishing hole."
        elseif data.stage == "casting" then
            reelTitle.Text, caption.Text = data.reused and "BACK TO YOUR FISHING SPOT" or "CASTING YOUR LINE", "Getting the line ready..."
        else reelTitle.Text, caption.Text = "LINE IN. TAKE A BREATH.", "Listening beneath the ice..." end
        progressFill.Size, tensionFill.Size = UDim2.fromScale(0, 1), UDim2.fromScale(0, 1)
        castButton.Text = "CANCEL CAST  [F]"
    elseif kind == "hook" and data.token == token then
        hookingInfo = data
        keyHeld, reelPointer = false, nil
        updateHeld()
        reelTitle.Text, caption.Text = "BITE! HOOK THE FISH", "Press Hook / Space / A before it slips away."
        holdButton.Text, holdButton.Visible = "HOOK! / SPACE / A", true
        track.Visible, tensionLabel.Visible, tensionBack.Visible = false, false, false
        progressLabel.Text = "REACTION WINDOW"
    elseif kind == "bite" and data.token == token then
        hookingInfo = nil
        holdButton.Text, progressLabel.Text = "HOLD / SPACE / A TO REEL", "CATCH PROGRESS"
        track.Visible, holdButton.Visible = true, true
        tensionLabel.Visible, tensionBack.Visible = true, true
        reelTitle.Text = "FISH ON!"
        caption.Text = "Hold to move right. Release to drift left. Follow the gold fish."
        reelView = Reel.newView(data)
        drawReel(Reel.viewStep(reelView, 0, held, workspace:GetServerTimeNow(), Config.Fishing))
    elseif kind == "reel" and data.token == token and reelView then
        Reel.receiveView(reelView, data, workspace:GetServerTimeNow(), held, Config.Fishing)
    elseif kind == "caught" then
        endFishing()
    elseif kind == "ended" then endFishing() notice(data) end
end)

local elapsed, lastViewport = 0, Vector2.zero
RunService.RenderStepped:Connect(function(dt)
    elapsed = elapsed + dt
    if drillingInfo then
        local progress = math.max(0, math.min(1, (workspace:GetServerTimeNow() - drillingInfo.startedAt) / drillingInfo.duration))
        progressFill.Size = UDim2.fromScale(progress, 1)
        caption.Text = "Drilling  " .. math.floor(progress * 100) .. "%  /  Reuse this hole for future casts"
    end
    if reelView then drawReel(Reel.viewStep(reelView, dt, held, workspace:GetServerTimeNow(), Config.Fishing)) end
    Preview.step(dt)
    if hookingInfo then progressFill.Size = UDim2.fromScale(math.max(0, 1 - (workspace:GetServerTimeNow() - hookingInfo.startedAt) / hookingInfo.duration), 1) end
    local hour = workspace:GetAttribute("WorldHour") or 14
    areaText.Text = (player:GetAttribute("RegionName") or "Frostbite Pond") .. "\n" .. Content.weather(workspace:GetAttribute("Weather")).name .. " / " .. string.format("%02d:%02d", math.floor(hour), math.floor(hour % 1 * 60))
    if token and elapsed &gt; 0.12 then
        elapsed = 0
        send("input", { token = token, held = held })
    end
    local camera = workspace.CurrentCamera
    if camera and camera.ViewportSize ~= lastViewport then
        lastViewport = camera.ViewportSize
        shopMobile = lastViewport.X &lt; 650
        modal.Size = UDim2.fromOffset(math.min(650, lastViewport.X - 20), math.min(530, lastViewport.Y - 60))
        modalScale.Scale = 1
        modalTitle.TextSize, inspectTitle.TextSize = shopMobile and 18 or 23, shopMobile and 18 or 22
        if shade.Visible then render() end
        holdButton.TextSize, caption.TextSize = shopMobile and 20 or 14, shopMobile and 15 or 12
        for _, item in ipairs(dock:GetDescendants()) do if item:IsA("TextButton") then item.TextSize = shopMobile and 18 or 14 end end
        local scale = math.min(1, (lastViewport.X - 20) / 490)
        local ds = dock:FindFirstChildOfClass("UIScale") or make("UIScale", dock)
        local rs = reel:FindFirstChildOfClass("UIScale") or make("UIScale", reel)
        ds.Scale, rs.Scale = scale, scale
        dock.AnchorPoint, dock.Position = Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -12)
        reel.AnchorPoint, reel.Position = Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -24 - 166 * scale)
        guide.Visible = lastViewport.X &gt; 850 and lastViewport.Y &gt; 580
        brand.Visible = lastViewport.X &gt; 590
        area.Visible = lastViewport.X &gt; 760

    end
end)

require(script.Parent:WaitForChild("AdminMenu")).start(gui, remotes)
require(script.Parent:WaitForChild("Feedback")).start(remotes)

-- Retry the handshake until the server has registered this player.
task.spawn(function()
    while not profile do send("ready") task.wait(1) end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX39">
          <Properties>
            <string name="Name">Ui</string>
            <ProtectedString name="Source">local Ui = {}
Ui.colors = { panel = Color3.fromRGB(20, 41, 54), card = Color3.fromRGB(32, 57, 71),
    text = Color3.fromRGB(232, 245, 249), muted = Color3.fromRGB(170, 198, 211),
    mint = Color3.fromRGB(131, 230, 201), gold = Color3.fromRGB(255, 213, 136), dark = Color3.fromRGB(14, 29, 39) }
function Ui.make(class, parent, props)
    local item = Instance.new(class)
    for key, value in pairs(props or {}) do item[key] = value end
    item.Parent = parent
    return item
end
function Ui.round(item) Ui.make("UICorner", item, { CornerRadius = UDim.new(0, 10) }) end
function Ui.frame(parent, size, position, color)
    local item = Ui.make("Frame", parent, { Size = size, Position = position, BackgroundColor3 = color or Ui.colors.panel, BorderSizePixel = 0 })
    Ui.round(item) return item
end
function Ui.text(parent, value, size, position, fontSize, color)
    return Ui.make("TextLabel", parent, { Text = value, Size = size, Position = position, TextSize = fontSize or 14, Font = Enum.Font.Gotham,
        TextColor3 = color or Ui.colors.text, BackgroundTransparency = 1, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left })
end
function Ui.button(parent, value, size, position, callback, color)
    local item = Ui.make("TextButton", parent, { Text = value, Size = size, Position = position, TextSize = 12, Font = Enum.Font.GothamBold,
        BackgroundColor3 = color or Ui.colors.mint, TextColor3 = Ui.colors.dark, BorderSizePixel = 0, AutoButtonColor = true, Selectable = true })
    Ui.round(item) item.Activated:Connect(callback) return item
end
return Ui
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>

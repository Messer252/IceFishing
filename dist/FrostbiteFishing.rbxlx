      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">local Config = {}

Config.StartingCoins = 120
Config.MaxCoins = 1000000000
Config.Region = "Frostbite Pond"
Config.Pond = { CenterX = 0, CenterZ = 0, Radius = 68, SurfaceY = 2 }
Config.ShopPosition = { X = 0, Z = -92 }
Config.ShopDistance = 23
Config.HoleUseDistance = 12
Config.DrillDuration = 2.4
Config.CastDuration = 0.8
Config.Fishing = {
    Tick = 0.08, BarSpeed = 0.55, Gravity = 0.36,
    Response = 12, FixedStep = 1 / 120,
    BaseWidth = 0.23, Gain = 0.16, Loss = 0.07,
    TensionGain = 0.22, TensionLoss = 0.33, Timeout = 35,
}

-- Costs are one-time unlocks. Bait packs are consumed on each cast.
Config.Gear = {
    auger = {
        { id = "hand", name = "Hand Auger", cost = 0, tier = 1, size = 3, drillTime = 2.4, luck = 0, description = "A small hole for pond fish." },
        { id = "steel", name = "Steel Auger", cost = 180, tier = 2, size = 4.5, drillTime = 1.9, luck = 0.2, description = "Wider holes unlock uncommon fish." },
        { id = "power", name = "Power Auger", cost = 650, tier = 3, size = 6, drillTime = 1.5, luck = 0.5, description = "Reach rare fish below the ice." },
        { id = "titanium", name = "Titanium Auger", cost = 1100, tier = 4, size = 7, drillTime = 1.3, luck = 0.65, description = "Lightweight drill for epic fish." },
        { id = "arctic", name = "Arctic Auger", cost = 1800, tier = 5, size = 8, drillTime = 1.1, luck = 0.8, description = "The deepest water hides legendary fish." },
    },
    rod = {
        { id = "twig", name = "Starter Rod", cost = 0, luck = 0, control = 0, description = "Simple, sturdy, and ready to fish." },
        { id = "birch", name = "Fiberglass Ice Rod", cost = 140, luck = 0.25, control = 0.035, description = "A little more luck and reel control." },
        { id = "carbon", name = "Carbon Rod", cost = 500, luck = 0.65, control = 0.07, description = "Better odds and a wider catch zone." },
        { id = "pro", name = "Pro Angler Rod", cost = 950, luck = 0.85, control = 0.09, description = "Fast reeling and stable tension for big fish." },
        { id = "glacier", name = "Glacier Rod", cost = 1500, luck = 1.1, control = 0.11, description = "Premium control for elusive fish." },
    },
    lure = {
        { id = "plain", name = "Plain Hook", cost = 0, luck = 0, description = "Your trusty starter hook." },
        { id = "copper", name = "Copper Spoon", cost = 110, luck = 0.3, description = "A flash of copper attracts better fish." },
        { id = "silver", name = "Silver Spinner", cost = 400, luck = 0.7, description = "An irresistible glimmer under the ice." },
        { id = "soft", name = "Soft Plastic", cost = 200, luck = 0.45, description = "A lifelike action that bass prefer." },
        { id = "blade", name = "Blade Bait", cost = 600, luck = 0.8, description = "Vibration draws pike and walleye." },
        { id = "predator", name = "Predator Jig", cost = 900, luck = 1, description = "A large profile for heavy predators." },
        { id = "aurora", name = "Aurora Jig", cost = 1200, luck = 1.2, description = "A shimmering lure for prized catches." },
    },
    bait = {
        { id = "bread", name = "Bread Crumbs", cost = 0, luck = 0, amount = 0, description = "Unlimited free bait." },
        { id = "worms", name = "Nightcrawlers · 10 casts", cost = 35, luck = 0.5, amount = 10, description = "Fresh bait improves rare-fish odds." },
        { id = "waxworms", name = "Wax Worms · 10 casts", cost = 25, luck = 0.25, amount = 10, description = "Quick bites from small pond species." },
        { id = "mealworms", name = "Mealworms · 10 casts", cost = 45, luck = 0.4, amount = 10, description = "A reliable choice for bass and panfish." },
        { id = "cutbait", name = "Cut Bait · 10 casts", cost = 80, luck = 0.75, amount = 10, description = "Attract bottom-feeding predators." },
        { id = "premium", name = "Premium Live Bait · 10 casts", cost = 160, luck = 1.45, amount = 10, description = "Faster bites and better rare-fish odds." },
        { id = "minnows", name = "Minnows · 10 casts", cost = 100, luck = 1.15, amount = 10, description = "Live bait for the biggest predators." },
    },
}

Config.Fish = {
    { id = "perch", name = "Yellow Perch", rarity = "Common", tier = 1, weight = 52, value = 25, kg = 0.6, difficulty = 0.70, color = { 228, 188, 86 } },
    { id = "bluegill", name = "Bluegill", rarity = "Common", tier = 1, weight = 35, value = 35, kg = 0.9, difficulty = 0.85, color = { 107, 181, 210 } },
    { id = "pumpkinseed", name = "Pumpkinseed", rarity = "Common", tier = 1, weight = 25, value = 30, kg = 0.7, difficulty = 0.75, color = { 232, 152, 83 } },
    { id = "crappie", name = "Black Crappie", rarity = "Common", tier = 1, weight = 20, value = 40, kg = 1.1, difficulty = 0.9, color = { 176, 188, 203 } },
    { id = "whitebass", name = "White Bass", rarity = "Uncommon", tier = 1, weight = 9, value = 55, kg = 1.8, difficulty = 0.95, color = { 122, 215, 160 } },
    { id = "trout", name = "Rainbow Trout", rarity = "Uncommon", tier = 2, weight = 19, value = 80, kg = 2.2, difficulty = 1.05, color = { 122, 215, 160 } },
    { id = "walleye", name = "Walleye", rarity = "Rare", tier = 3, weight = 13, value = 110, kg = 3.4, difficulty = 1.15, color = { 122, 215, 160 } },
    { id = "pike", name = "Northern Pike", rarity = "Rare", tier = 3, weight = 7, value = 230, kg = 6.5, difficulty = 1.30, color = { 121, 157, 255 } },
    { id = "char", name = "Arctic Char", rarity = "Rare", tier = 3, weight = 4, value = 340, kg = 4.5, difficulty = 1.45, color = { 121, 157, 255 } },
    { id = "sturgeon", name = "Lake Sturgeon", rarity = "Legendary", tier = 5, weight = 1.2, value = 900, kg = 18, difficulty = 1.65, color = { 248, 197, 92 } },
    { id = "spirit", name = "Aurora Spiritfish", rarity = "Legendary", tier = 5, weight = 0.45, value = 1600, kg = 8, difficulty = 1.85, color = { 219, 145, 255 } },
    { id = "largemouth", name = "Largemouth Bass", rarity = "Uncommon", tier = 2, weight = 15, value = 85, kg = 2.8, difficulty = 1.05, color = { 122, 215, 160 } },
    { id = "smallmouth", name = "Smallmouth Bass", rarity = "Uncommon", tier = 2, weight = 17, value = 75, kg = 2.1, difficulty = 1.0, color = { 122, 215, 160 } },
    { id = "burbot", name = "Burbot", rarity = "Rare", tier = 3, weight = 6, value = 250, kg = 5.2, difficulty = 1.3, color = { 121, 157, 255 } },
    { id = "muskellunge", name = "Muskellunge", rarity = "Epic", tier = 4, weight = 2.6, value = 480, kg = 11, difficulty = 1.5, color = { 203, 148, 250 } },
    { id = "laketrout", name = "Lake Trout", rarity = "Epic", tier = 4, weight = 3.2, value = 430, kg = 9, difficulty = 1.4, color = { 203, 148, 250 } },
    { id = "flathead", name = "Flathead Catfish", rarity = "Epic", tier = 4, weight = 2.1, value = 520, kg = 14, difficulty = 1.55, color = { 203, 148, 250 } },
    { id = "goldenwalleye", name = "Golden Walleye", rarity = "Legendary", tier = 5, weight = 0.8, value = 1150, kg = 6, difficulty = 1.75, color = { 248, 197, 92 } },
}

local rodStats = {
    twig = { 1, 6, 1, 0 }, birch = { 2, 12, 1.08, 0.08 }, carbon = { 5, 22, 1.16, 0.16 },
    pro = { 8, 35, 1.23, 0.23 }, glacier = { 12, 55, 1.30, 0.30 },
}
for _, rod in ipairs(Config.Gear.rod) do
    local values = rodStats[rod.id]
    rod.requiredLevel, rod.strength, rod.reelSpeed, rod.stability = values[1], values[2], values[3], values[4]
end
for _, auger in ipairs(Config.Gear.auger) do auger.requiredLevel = ({ 1, 3, 6, 9, 12 })[auger.tier] end
for _, lure in ipairs(Config.Gear.lure) do lure.requiredLevel = math.max(1, math.floor(lure.cost / 180)) end
for _, bait in ipairs(Config.Gear.bait) do bait.biteSpeed = bait.id == "bread" and 1 or (bait.id == "premium" and 1.5 or 1.2) end
local preferences = {
    perch = "waxworms", bluegill = "bread", pumpkinseed = "mealworms", crappie = "waxworms",
    whitebass = "minnows", largemouth = "worms", smallmouth = "mealworms", trout = "worms",
    walleye = "minnows", pike = "minnows", burbot = "cutbait", char = "waxworms",
    muskellunge = "minnows", laketrout = "premium", flathead = "cutbait", sturgeon = "cutbait",
    goldenwalleye = "premium", spirit = "premium",
}
for _, fish in ipairs(Config.Fish) do
    fish.minWeight, fish.maxWeight = math.floor(fish.kg * 0.65 * 100 + 0.5) / 100, math.floor(fish.kg * 1.5 * 100 + 0.5) / 100
    fish.xp = 16 + fish.tier * 8
    fish.preferredBait = preferences[fish.id]
    fish.preferredLure = fish.tier &gt;= 3 and "predator" or "soft"
    fish.location, fish.preferredWeather, fish.preferredTime = "pond", "Clear", fish.tier &gt;= 3 and "Night" or "Day"
end

function Config.reelSettings(rod)
    local settings = {}
    for key, value in pairs(Config.Fishing) do settings[key] = value end
    settings.Gain = settings.Gain * rod.reelSpeed
    settings.TensionGain = settings.TensionGain * (1 - rod.stability)
    return settings
end

function Config.gearStats(category, item)
    if category == "rod" then
        return string.format("Luck +%.2f / Control +%.0f%% / %d kg / Reel x%.2f / Stability %.0f%%", item.luck, item.control * 100, item.strength, item.reelSpeed, item.stability * 100)
    elseif category == "auger" then return string.format("%g-stud hole / Tier %d / Drill %.1fs", item.size, item.tier, item.drillTime)
    elseif category == "bait" then return string.format("Luck +%.2f / Bite speed x%.1f", item.luck, item.biteSpeed)
    else return string.format("Luck +%.2f / Permanent lure", item.luck) end
end

function Config.findGear(category, id)
    for _, item in ipairs(Config.Gear[category] or {}) do
        if item.id == id then return item end
    end
    return nil
end

function Config.gearName(category, id)
    local gear = Config.findGear(category, id)
    -- Parentheses intentionally discard gsub's second return value.
    return gear and (gear.name:gsub(" · 10 casts", "")) or "Unknown gear"
end

function Config.weightFor(fish, luck, context)
    -- Value adds a small quality boost within a tier, so starter-pond gear
    -- upgrades help even before a player unlocks the next auger.
    local quality = fish.tier - 1 + math.log(fish.value / 25) * 0.2
    local preference = 1
    if context and context.bait == fish.preferredBait then preference = preference * 1.5 end
    if context and context.lure == fish.preferredLure then preference = preference * 1.25 end
    return fish.weight * (1 + math.max(0, luck) * quality * 0.75) * preference
end

-- Accepts an injected [0, 1) roll to make the selection logic testable.
function Config.selectFish(tier, luck, roll, context)
    local total = 0
    for _, fish in ipairs(Config.Fish) do
        if fish.tier &lt;= tier then total = total + Config.weightFor(fish, luck, context) end
    end
    local target = math.max(0, math.min(0.999999, roll)) * total
    for _, fish in ipairs(Config.Fish) do
        if fish.tier &lt;= tier then
            target = target - Config.weightFor(fish, luck, context)
            if target &lt; 0 then return fish end
        end
    end
    return Config.Fish[1]
end

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">Equipment</string>
          <ProtectedString name="Source">-- Original asset-free models shared by held tools, cabin racks and 3D previews.
local Equipment = {}
local palettes = {
    hand = { 170, 91, 54 }, steel = { 96, 149, 163 }, power = { 226, 163, 57 }, arctic = { 107, 220, 231 }, titanium = { 165, 163, 216 }, pro = { 196, 146, 80 },
    twig = { 139, 88, 53 }, birch = { 205, 167, 111 }, carbon = { 75, 127, 166 }, glacier = { 124, 230, 228 },
    plain = { 166, 184, 193 }, copper = { 210, 134, 65 }, silver = { 207, 227, 240 }, aurora = { 166, 139, 245 },
    bread = { 236, 201, 137 }, worms = { 195, 106, 113 }, minnows = { 106, 183, 207 },
}
local metal, dark = Color3.fromRGB(187, 205, 216), Color3.fromRGB(32, 44, 54)

local function piece(model, name, size, cf, color, shape, material)
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame = name, size, cf
    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = true, false, false, false, true
    p.Color, p.Material = color, material or Enum.Material.SmoothPlastic
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    if shape then p.Shape = shape end
    p.Parent = model
    return p
end

local function link(model, name, a, b, radius, color, material)
    local delta = b - a
    local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
    return piece(model, name, Vector3.new(delta.Magnitude, radius, radius), cf, color, Enum.PartType.Cylinder, material)
end

local function ring(model, name, center, radius, color)
    for i = 1, 12 do
        local a, b = (i - 1) * math.pi / 6, i * math.pi / 6
        link(model, name, center + Vector3.new(math.cos(a) * radius, math.sin(a) * radius, 0),
            center + Vector3.new(math.cos(b) * radius, math.sin(b) * radius, 0), 0.045, color, Enum.Material.Metal)
    end
end

function Equipment.build(category, id)
    local model = Instance.new("Model")
    model.Name = category .. "_" .. id
    local rgb = palettes[id] or { 170, 210, 220 }
    local accent = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
    local handle = piece(model, "Handle", Vector3.new(0.27, 0.9, 0.27), CFrame.new(), dark)
    model.PrimaryPart = handle
    if category == "rod" then
        handle.Color, handle.Material = Color3.fromRGB(173, 133, 87), Enum.Material.Wood
        local length = id == "glacier" and 6.4 or 5.8
        for i = 1, 4 do
            local from = Vector3.new(0, 0.45 + (i - 1) * length / 4, 0)
            local to = Vector3.new(0, 0.45 + i * length / 4, 0)
            link(model, "RodBlank", from, to, 0.16 - i * 0.025, accent, Enum.Material.Metal)
            ring(model, "LineGuide", to + Vector3.new(0, 0, -0.09), 0.10, metal)
        end
        link(model, "ReelFoot", Vector3.new(0, 0.15, 0), Vector3.new(0, 0.15, -0.42), 0.12, metal)
        piece(model, "ReelSpool", Vector3.new(0.52, 0.65, 0.65), CFrame.new(0, 0.05, -0.52), accent, Enum.PartType.Cylinder, Enum.Material.Metal)
        piece(model, "SpoolLine", Vector3.new(0.34, 0.52, 0.52), CFrame.new(0, 0.05, -0.52), Color3.fromRGB(223, 233, 222), Enum.PartType.Cylinder)
        link(model, "Crank", Vector3.new(0.32, 0.05, -0.52), Vector3.new(0.32, -0.35, -0.72), 0.09, metal)
        piece(model, "CrankKnob", Vector3.new(0.3, 0.18, 0.18), CFrame.new(0.42, -0.35, -0.72), dark, Enum.PartType.Cylinder)
        local tip = Instance.new("Attachment")
        tip.Name, tip.Position, tip.Parent = "LineTip", Vector3.new(0, length + 0.45, 0), handle
    elseif category == "auger" then
        link(model, "DrillShaft", Vector3.new(0, 0.3, 0), Vector3.new(0, -4.6, 0), 0.19, metal, Enum.Material.Metal)
        for i = 1, 64 do
            local function point(t) return Vector3.new(math.cos(t * math.pi * 6) * 0.55, -1 - t * 3.4, math.sin(t * math.pi * 6) * 0.55) end
            link(model, "SpiralFlight", point((i - 1) / 64), point(i / 64), 0.24, accent, Enum.Material.Metal)
        end
        piece(model, "CuttingBlade", Vector3.new(1.3, 0.1, 0.42), CFrame.new(0, -4.55, 0) * CFrame.Angles(0, 0, 0.1), metal, nil, Enum.Material.Metal)
        link(model, "Crossbar", Vector3.new(-0.9, 0.45, 0), Vector3.new(0.9, 0.45, 0), 0.14, metal)
        for _, x in ipairs({ -0.85, 0.85 }) do
            piece(model, "Grip", Vector3.new(0.55, 0.28, 0.28), CFrame.new(x, 0.45, 0), dark, Enum.PartType.Cylinder)
        end
        if id == "power" or id == "arctic" or id == "titanium" then
            piece(model, "MotorHousing", Vector3.new(1.1, 0.95, 0.85), CFrame.new(0, 0.8, 0), accent)
            piece(model, "FuelCap", Vector3.new(0.16, 0.3, 0.3), CFrame.new(0.33, 1.32, 0) * CFrame.Angles(0, 0, math.pi / 2), dark, Enum.PartType.Cylinder)
            for i = 1, 4 do piece(model, "CoolingVent", Vector3.new(0.65, 0.045, 0.04), CFrame.new(0, 0.5 + i * 0.13, -0.44), dark) end
        end
    elseif category == "lure" then
        handle.Transparency = 1
        piece(model, "Spoon", Vector3.new(0.65, 1.65, 0.2), CFrame.new(0, 0.5, 0), accent, Enum.PartType.Ball, Enum.Material.Metal)
        ring(model, "Eyelet", Vector3.new(0, 1.45, 0), 0.14, metal)
        for i = 1, 12 do
            local a, b = (i - 1) * math.pi / 9, i * math.pi / 9
            link(model, "Hook", Vector3.new(0.27 * math.sin(a), -0.55 - 0.35 * math.cos(a), 0), Vector3.new(0.27 * math.sin(b), -0.55 - 0.35 * math.cos(b), 0), 0.065, metal)
        end
        piece(model, "Eye", Vector3.new(0.12, 0.12, 0.08), CFrame.new(0, 0.8, -0.12), dark, Enum.PartType.Ball)
    else
        handle.Transparency = 1
        piece(model, "BaitTin", Vector3.new(1.3, 1.8, 1.8), CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(223, 231, 221), Enum.PartType.Cylinder)
        piece(model, "Lid", Vector3.new(0.18, 1.9, 1.9), CFrame.new(0, 1.01, 0) * CFrame.Angles(0, 0, math.pi / 2), accent, Enum.PartType.Cylinder, Enum.Material.Metal)
        piece(model, "LabelBand", Vector3.new(0.55, 1.84, 1.84), CFrame.new(0, 0.35, 0) * CFrame.Angles(0, 0, math.pi / 2), accent, Enum.PartType.Cylinder)
        if id == "worms" then
            for i = 1, 7 do piece(model, "Worm", Vector3.new(0.14, 0.14, 0.5), CFrame.new((i % 3 - 1) * 0.26, 1.15, (i % 2 - 0.5) * 0.5) * CFrame.Angles(0, i, 0), accent, Enum.PartType.Ball) end
        else
            for i = 1, 4 do piece(model, "Bait", Vector3.new(0.35, 0.23, 0.65), CFrame.new((i % 2 - 0.5) * 0.7, 1.17, (math.floor(i / 2) - 1) * 0.45), accent, Enum.PartType.Ball) end
        end
    end
    return model
end

function Equipment.mount(character, category, id)
    local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if not hand then return nil end
    local model = Equipment.build(category, id)
    local handle = model.PrimaryPart
    local offset = category == "rod" and (CFrame.new(0, -0.25, -0.15) * CFrame.Angles(math.rad(-112), 0, 0))
        or (CFrame.new(0, -0.3, -0.3) * CFrame.Angles(math.rad(-70), 0, 0))
    -- Cache authored transforms before moving the handle, then weld the assembly.
    local transforms = {}
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then transforms[p] = p.CFrame end
    end
    for p, cf in pairs(transforms) do
        p.CFrame, p.Anchored = hand.CFrame * offset * cf, false
    end
    for p in pairs(transforms) do
        if p ~= handle then
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1, weld.Parent = handle, p, p
        end
    end
    local grip = Instance.new("Motor6D")
    grip.Name, grip.Part0, grip.Part1 = "EquipmentGrip", hand, handle
    grip.C0, grip.Parent = offset, handle
    model.Parent = character
    return model, grip, offset
end

return Equipment
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">FishGeneration</string>
          <ProtectedString name="Source">local FishGeneration = {}

function FishGeneration.roll(config, tier, luck, context, random)
    local species = config.selectFish(tier, luck, random(), context)
    local weightRoll = random()
    local rawWeight = species.minWeight + (species.maxWeight - species.minWeight) * weightRoll
    local kg = math.max(species.minWeight, math.min(species.maxWeight, math.floor(rawWeight * 100 + 0.5) / 100))
    local strength = context.strength or 6
    local resistance = 1 + math.max(0, kg / strength - 1) * 0.12
    return { id = species.id, name = species.name, rarity = species.rarity, tier = species.tier,
        kg = kg, value = math.max(1, math.floor(species.value * kg / species.kg)),
        difficulty = math.min(2.15, species.difficulty * (0.9 + weightRoll * 0.2) * resistance),
        xp = species.xp, color = species.color, trophy = weightRoll &gt;= 0.95 }
end

return FishGeneration
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">HoleRules</string>
          <ProtectedString name="Source">local HoleRules = {}

function HoleRules.canReuse(hole, userId, distance, maxDistance)
    return hole ~= nil and hole.ownerId == userId and distance &lt;= maxDistance
end

-- Existing holes retain the tier of the auger that drilled them.
function HoleRules.fishingTier(hole)
    return hole.tier
end

return HoleRules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source">local Progression = {}
Progression.MaxLevel = 100
Progression.MaxXP = 10000000

function Progression.requiredXP(level)
    return 80 + (level - 1) * 45
end

function Progression.describe(totalXP)
    local remaining, level = math.max(0, math.floor(totalXP or 0)), 1
    while level &lt; Progression.MaxLevel and remaining &gt;= Progression.requiredXP(level) do
        remaining = remaining - Progression.requiredXP(level)
        level = level + 1
    end
    if level == Progression.MaxLevel then remaining = Progression.requiredXP(level) end
    return { level = level, current = remaining, required = Progression.requiredXP(level),
        fraction = level == Progression.MaxLevel and 1 or remaining / Progression.requiredXP(level) }
end

function Progression.add(profile, amount)
    local before = Progression.describe(profile.xp).level
    profile.xp = math.min(Progression.MaxXP, profile.xp + math.max(0, math.floor(amount)))
    profile.level = Progression.describe(profile.xp).level
    return profile.level &gt; before
end

return Progression
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">Reel</string>
          <ProtectedString name="Source">local Reel = {}

local function clamp(x, lo, hi) return math.max(lo, math.min(hi, x)) end

function Reel.target(phase, difficulty, elapsed)
    return 0.5 + math.sin(elapsed * difficulty * 1.25 + phase) * 0.26
        + math.sin(elapsed * difficulty * 2.1 + phase * 0.7) * 0.10
end

-- Exact integration of a responding velocity keeps behavior independent of FPS.
function Reel.moveBar(state, dt, held, settings)
    local desired = held and settings.BarSpeed or -settings.Gravity
    local velocity = state.velocity or 0
    local decay = math.exp(-settings.Response * dt)
    local movement = desired * dt + (velocity - desired) * (1 - decay) / settings.Response
    local half = (state.width or 0) / 2
    local raw = state.bar + movement
    state.bar = clamp(raw, half, 1 - half)
    state.velocity = raw ~= state.bar and 0 or desired + (velocity - desired) * decay
end

-- Only the server uses the outcome to award a catch.
function Reel.step(state, dt, held, fish, settings, elapsed)
    Reel.moveBar(state, dt, held, settings)
    state.target = Reel.target(state.phase, fish.difficulty, elapsed)
    local inside = math.abs(state.bar - state.target) &lt;= state.width / 2
    state.progress = clamp(state.progress + (inside and settings.Gain or -settings.Loss) * dt, 0, 1)
    state.tension = clamp(state.tension + (inside and -settings.TensionLoss or settings.TensionGain) * dt, 0, 1)
    if state.progress &gt;= 1 then return "caught" end
    if state.tension &gt;= 1 or elapsed &gt;= settings.Timeout then return "escaped" end
    return nil
end

function Reel.newView(snapshot)
    return { bar = snapshot.bar, velocity = snapshot.velocity or 0, width = snapshot.width,
        progress = snapshot.progress, tension = snapshot.tension, snapshot = snapshot,
        error = 0, velocityError = 0 }
end

function Reel.receiveView(view, snapshot, now, held, settings)
    if snapshot.serverTime &lt;= view.snapshot.serverTime then return end
    local projected = { bar = snapshot.bar, velocity = snapshot.velocity, width = snapshot.width }
    Reel.moveBar(projected, clamp(now - snapshot.serverTime, 0, 0.25), held, settings)
    view.error, view.velocityError = projected.bar - view.bar, projected.velocity - view.velocity
    view.snapshot = snapshot
end

-- Render every frame, predict input locally, gently reconcile server errors.
-- Receiving a packet never directly repositions the UI.
function Reel.viewStep(view, dt, held, now, settings)
    dt = clamp(dt, 0, 0.05)
    Reel.moveBar(view, dt, held, settings)
    local alpha = 1 - math.exp(-10 * dt)
    view.bar = clamp(view.bar + view.error * alpha, view.width / 2, 1 - view.width / 2)
    view.velocity = view.velocity + view.velocityError * alpha
    view.error, view.velocityError = view.error * (1 - alpha), view.velocityError * (1 - alpha)
    local snapshot = view.snapshot
    view.progress = view.progress + (snapshot.progress - view.progress) * alpha
    view.tension = view.tension + (snapshot.tension - view.tension) * alpha
    view.target = Reel.target(snapshot.phase, snapshot.difficulty,
        snapshot.elapsed + math.max(0, now - snapshot.serverTime))
    return view
end

return Reel
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">AdminPolicy</string>
          <ProtectedString name="Source">local Policy = {}
local actions = { roster = true, money = true, xp = true, fly = true, kick = true,
    gotoPlayer = true, bring = true, freeze = true, unfreeze = true, heal = true, respawn = true,
    pond = true, shop = true }
local selfActions = { roster = true, fly = true, pond = true, shop = true }
local function integer(n) return type(n) == "number" and n == n and math.abs(n) &lt;= 9007199254740991 and n % 1 == 0 end

function Policy.new(settings, isStudio)
    local allowed = {}
    for _, id in ipairs(settings.AdminUserIds) do if integer(id) and id &gt; 0 then allowed[id] = true end end
    if isStudio then for _, id in ipairs(settings.StudioAdminUserIds) do if integer(id) then allowed[id] = true end end end
    return {
        allowResolved = function(id) if integer(id) and id &gt; 0 then allowed[id] = true return true end return false end,
        isAdmin = function(id) return allowed[id] == true end,
        validate = function(request)
            if type(request) ~= "table" or not actions[request.action] then return false, "Unknown admin action." end
            if not selfActions[request.action] and not integer(request.targetId) then return false, "Select a player in this server." end
            if request.action == "money" or request.action == "xp" then
                local cap = request.action == "money" and settings.MaxMoneyGrant or settings.MaxXPGrant
                if not integer(request.amount) or request.amount &lt; 1 or request.amount &gt; cap then return false, "Enter a whole number between 1 and " .. cap .. "." end
            end
            return true
        end,
    }
end
return Policy
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">AdminService</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Progression = require(ReplicatedStorage.Shared.Progression)
local Config = require(ReplicatedStorage.Shared.Config)
local Settings = require(script.Parent.ServerSettings)
local Policy = require(script.Parent.AdminPolicy)
local Admin = {}

function Admin.start(context)
    local policy = Policy.new(Settings, RunService:IsStudio())
    local command, event = Instance.new("RemoteEvent"), Instance.new("RemoteEvent")
    command.Name, event.Name = "AdminCommand", "AdminEvent"
    command.Parent, event.Parent = context.remotes, context.remotes
    local limits, flying, frozen = {}, {}, {}
    local function status(player, text) event:FireClient(player, "result", text) end
    local function mark(player) player:SetAttribute("IsAdmin", policy.isAdmin(player.UserId)) end
    local function roster(player)
        local list = {}
        for _, target in ipairs(Players:GetPlayers()) do
            table.insert(list, { userId = target.UserId, username = target.Name, displayName = target.DisplayName,
                coins = context.profiles[target] and context.profiles[target].coins or nil })
        end
        event:FireClient(player, "roster", list)
    end
    local function rootOf(player)
        local char = player.Character
        return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
    end
    local function stopFlying(player)
        local state = flying[player]
        if state then
            for _, item in ipairs(state.instances) do item:Destroy() end
            if state.humanoid.Parent then
                state.humanoid.PlatformStand, state.humanoid.AutoRotate = state.platformStand, state.autoRotate
            end
            if state.root.Parent then
                state.root.AssemblyLinearVelocity, state.root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            end
            flying[player] = nil
        end
        player:SetAttribute("AdminFlying", false)
    end
    local function unfreeze(player)
        local state = frozen[player]
        if state and state.root.Parent then state.root.Anchored = state.anchored end
        frozen[player] = nil
        player:SetAttribute("AdminFrozen", false)
    end
    local function setup(player)
        mark(player)
        player.CharacterRemoving:Connect(function() stopFlying(player) unfreeze(player) end)
    end
    Players.PlayerAdded:Connect(setup)
    for _, player in ipairs(Players:GetPlayers()) do setup(player) end
    Players.PlayerRemoving:Connect(function(player) stopFlying(player) unfreeze(player) limits[player] = nil end)
    task.spawn(function()
        for attempt = 1, 3 do
            local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(Settings.AdminUsername) end)
            if ok and policy.allowResolved(id) then
                warn("[Admin] " .. Settings.AdminUsername .. " resolved to UserId " .. id .. ". Pin this ID in ServerSettings.AdminUserIds to retain access after renaming.")
                for _, player in ipairs(Players:GetPlayers()) do mark(player) end
                return
            end
            if attempt &lt; 3 then task.wait(attempt * 2) end
        end
        warn("[Admin] Owner lookup failed; no username-based privileges granted. Numeric AdminUserIds remain available.")
    end)
    command.OnServerEvent:Connect(function(actor, request)
        -- Player attributes and UI visibility are never permission checks.
        if not policy.isAdmin(actor.UserId) then return end
        local now = os.clock()
        if now - (limits[actor] or -math.huge) &lt; 0.3 then return end
        limits[actor] = now
        local valid, problem = policy.validate(request)
        if not valid then status(actor, problem) return end
        local action = request.action
        if action == "roster" then roster(actor) return end
        local selfAction = action == "fly" or action == "pond" or action == "shop"
        local target = selfAction and actor or Players:GetPlayerByUserId(request.targetId)
        if not target then status(actor, "That player has left the server.") roster(actor) return end
        if target ~= actor and policy.isAdmin(target.UserId) and (action == "kick" or action == "freeze" or action == "respawn") then
            status(actor, "That action is protected for other admins.") return
        end
        local profile = context.profiles[target]
        if action == "money" or action == "xp" then
            if not profile or target:GetAttribute("ProfileReady") ~= true then status(actor, "That player's saved profile is not ready.") return end
            if action == "money" then
                if profile.coins + request.amount &gt; Config.MaxCoins then status(actor, "That grant exceeds the player's coin limit.") return end
                profile.coins = profile.coins + request.amount
                context.notify(target, "An admin gave you " .. request.amount .. " coins.")
            else
                if profile.xp + request.amount &gt; Progression.MaxXP then status(actor, "That grant exceeds the player's XP limit.") return end
                Progression.add(profile, request.amount)
                context.notify(target, "An admin gave you " .. request.amount .. " XP.")
            end
            context.pushProfile(target)
        elseif action == "kick" then
            if target == actor then status(actor, "Choose another player to kick.") return end
            local reason = type(request.reason) == "string" and request.reason:gsub("%c", " "):sub(1, 160) or "Removed by an administrator."
            if #reason &lt; 1 then reason = "Removed by an administrator." end
            target:Kick(reason)
        else
            local root, humanoid = rootOf(target)
            if not root or not humanoid or humanoid.Health &lt;= 0 then status(actor, "That character is not ready.") return end
            if action == "fly" then
                if flying[actor] then stopFlying(actor)
                else
                    context.cancel(actor, "escaped", "Cast cancelled for admin flight.")
                    unfreeze(actor)
                    local attachment = Instance.new("Attachment")
                    attachment.Name, attachment.Parent = "AdminFlightAttachment", root
                    local velocity = Instance.new("LinearVelocity")
                    velocity.Name, velocity.Attachment0, velocity.RelativeTo = "AdminFlightVelocity", attachment, Enum.ActuatorRelativeTo.World
                    velocity.MaxForce, velocity.VectorVelocity, velocity.Parent = 10000000, Vector3.zero, root
                    local orientation = Instance.new("AlignOrientation")
                    orientation.Name, orientation.Mode, orientation.Attachment0 = "AdminFlightOrientation", Enum.OrientationAlignmentMode.OneAttachment, attachment
                    orientation.MaxTorque, orientation.Responsiveness, orientation.Parent = 10000000, 20, root
                    orientation.CFrame = root.CFrame.Rotation
                    flying[actor] = { instances = { velocity, orientation, attachment }, humanoid = humanoid,
                        root = root, platformStand = humanoid.PlatformStand, autoRotate = humanoid.AutoRotate }
                    humanoid.PlatformStand, humanoid.AutoRotate = true, false
                    actor:SetAttribute("AdminFlySpeed", Settings.FlySpeed)
                    actor:SetAttribute("AdminFlying", true)
                end
            elseif action == "freeze" then
                context.cancel(target, "escaped", "An admin paused your movement.")
                stopFlying(target)
                if not frozen[target] then frozen[target] = { root = root, anchored = root.Anchored } end
                root.Anchored = true
                target:SetAttribute("AdminFrozen", true)
            elseif action == "unfreeze" then unfreeze(target)
            elseif action == "heal" then humanoid.Health = humanoid.MaxHealth
            elseif action == "respawn" then
                context.cancel(target, "escaped", "Respawning...")
                stopFlying(target) unfreeze(target)
                task.spawn(function()
                    local ok = pcall(function() target:LoadCharacterAsync() end)
                    if not ok and actor.Parent then status(actor, "The respawn could not finish. Try again.") end
                end)
            else
                local destination
                if action == "pond" then destination = CFrame.new(0, 6, -40)
                elseif action == "shop" then destination = CFrame.new(0, 4, -85)
                else
                    local actorRoot = rootOf(actor)
                    if not actorRoot then status(actor, "Your character is not ready.") return end
                    if action == "gotoPlayer" then destination, target, root = root.CFrame * CFrame.new(3, 0, 0), actor, actorRoot
                    elseif action == "bring" then destination = actorRoot.CFrame * CFrame.new(3, 0, 0) end
                end
                context.cancel(target, "escaped", "Cast cancelled for teleport.")
                root.CFrame, root.AssemblyLinearVelocity = destination, Vector3.zero
            end
        end
        warn(string.format("[Admin] actor=%d action=%s target=%d amount=%s", actor.UserId, action, target.UserId, tostring(request.amount or "-")))
        status(actor, "Done: " .. action .. " / " .. target.Name)
        roster(actor)
    end)
    return { stopFlying = stopFlying, isAdmin = policy.isAdmin }
end
return Admin
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX14">
        <Properties>
          <string name="Name">Game</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage.Shared.Config)
local Reel = require(ReplicatedStorage.Shared.Reel)
local HoleRules = require(ReplicatedStorage.Shared.HoleRules)
local Equipment = require(ReplicatedStorage.Shared.Equipment)
local World = require(script.Parent.World)
local Data = require(script.Parent.PlayerDataService)
local AdminService = require(script.Parent.AdminService)
local Progression = require(ReplicatedStorage.Shared.Progression)
local FishGeneration = require(ReplicatedStorage.Shared.FishGeneration)

local world, shopPrompt, sellPrompt = World.build(Config)
local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "FishingRemotes", ReplicatedStorage
local command = Instance.new("RemoteEvent")
command.Name, command.Parent = "Command", remotes
local event = Instance.new("RemoteEvent")
event.Name, event.Parent = "Event", remotes
local rng = Random.new()
local profiles, sessions, holes, limits = {}, {}, {}, {}
local loading, closing = {}, false

local function notify(player, message) event:FireClient(player, "notice", message) end
local function rootOf(player)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health &lt;= 0 then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end
local function nearShop(player)
    local root = rootOf(player)
    return root and (root.Position - Vector3.new(Config.ShopPosition.X, root.Position.Y, Config.ShopPosition.Z)).Magnitude &lt; Config.ShopDistance
        and math.abs(root.Position.Y - 4) &lt; 15
end
local function onPond(player)
    local root = rootOf(player)
    return root and Vector2.new(root.Position.X, root.Position.Z).Magnitude &lt; Config.Pond.Radius - 5
        and math.abs(root.Position.Y - Config.Pond.SurfaceY) &lt; 8
end
local function pushProfile(player)
    local p = profiles[player]
    if not p then return end
    player.leaderstats.Coins.Value = p.coins
    player.leaderstats.Fish.Value = #p.bag
    p.level = Progression.describe(p.xp).level
    player.leaderstats.Level.Value = p.level
    event:FireClient(player, "profile", p)
end
local function removeHole(player)
    if holes[player] then holes[player].model:Destroy() holes[player] = nil end
end

local function lockMovement(player, s)
    local h = player.Character:FindFirstChildOfClass("Humanoid")
    s.humanoid, s.character = h, player.Character
    s.movement = { speed = h.WalkSpeed, power = h.JumpPower, height = h.JumpHeight,
        rotate = h.AutoRotate, jumping = h:GetStateEnabled(Enum.HumanoidStateType.Jumping) }
    h.WalkSpeed, h.JumpPower, h.JumpHeight, h.AutoRotate, h.Jump = 0, 0, 0, false, false
    h:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
end
local function unlockMovement(s)
    if s.character and s.character.Parent then s.character:SetAttribute("FishingStage", nil) end
    local h, m = s.humanoid, s.movement
    if h and h.Parent and m then
        h.WalkSpeed, h.JumpPower, h.JumpHeight, h.AutoRotate = m.speed, m.power, m.height, m.rotate
        h.Jump = false
        h:SetStateEnabled(Enum.HumanoidStateType.Jumping, m.jumping)
    end
end
local function clearTool(s)
    if s.tool then s.tool:Destroy() end
    if s.line then s.line:Destroy() end
    if s.drillEffect then s.drillEffect:Destroy() s.drillEffect = nil end
    s.tool, s.line, s.grip, s.bobber = nil, nil, nil, nil
end
local function setStage(s, stage)
    s.stage, s.stageAt = stage, workspace:GetServerTimeNow()
    s.character:SetAttribute("FishingStageAt", s.stageAt)
    s.character:SetAttribute("FishingStage", stage)
end
local function equip(s, category, id)
    clearTool(s)
    s.tool, s.grip, s.gripBase = Equipment.mount(s.character, category, id)
end
local function snapshot(s)
    return { token = s.token, bar = s.bar, velocity = s.velocity, target = s.target, width = s.width,
        progress = s.progress, tension = s.tension, phase = s.phase, difficulty = s.fish.difficulty,
        elapsed = s.elapsed, serverTime = workspace:GetServerTimeNow() }
end

local function finish(player, outcome, message)
    local s = sessions[player]
    if not s then return end
    sessions[player] = nil
    clearTool(s)
    unlockMovement(s)
    if outcome == "caught" and profiles[player] then
        local fish = s.fish
        local p = profiles[player]
        local discovery = not p.discoveries[fish.id]
        p.discoveries[fish.id] = true
        p.records[fish.id] = math.max(p.records[fish.id] or 0, fish.kg)
        p.statistics.catches = p.statistics.catches + 1
        local xp = fish.xp + (discovery and 15 or 0) + (fish.trophy and 12 or 0)
        local leveledUp = Progression.add(p, xp)
        local catch = { catchId = HttpService:GenerateGUID(false), species = fish.id, name = fish.name,
            rarity = fish.rarity, kg = fish.kg, value = fish.value, color = fish.color, xp = xp,
            trophy = fish.trophy, caughtAt = os.time(), location = Config.Region,
            variant = "Normal", locked = false, favorite = false, discovery = discovery }
        table.insert(p.bag, catch)
        pushProfile(player)
        event:FireClient(player, "caught", catch)
        if leveledUp then notify(player, "Level " .. p.level .. "! New equipment is available in the shop.") end
    else event:FireClient(player, "ended", message or "The fish escaped. Cast into the same hole to try again!") end
    -- The hole deliberately survives catches, cancellations and character resets.
end

local function buy(player, data)
    if not nearShop(player) then notify(player, "Visit Frostbite Tackle by the pond to buy gear.") return end
    if sessions[player] then notify(player, "Finish your cast first.") return end
    if type(data) ~= "table" or type(data.category) ~= "string" or type(data.id) ~= "string" then return end
    local item, p = Config.findGear(data.category, data.id), profiles[player]
    if not item then return end
    local alreadyOwned = data.category ~= "bait" and p.owned[data.category][item.id]
    if not alreadyOwned and Progression.describe(p.xp).level &lt; (item.requiredLevel or 1) then
        notify(player, "Reach level " .. item.requiredLevel .. " to unlock " .. item.name .. ".") return
    end
    if data.category == "bait" then
        if item.amount == 0 then p.equipped.bait = item.id
        elseif (p.bait[item.id] or 0) &gt; 0 and data.equip == true then p.equipped.bait = item.id
        else
            if p.coins &lt; item.cost then notify(player, "You need more coins for that bait pack.") return end
            p.coins = p.coins - item.cost
            p.bait[item.id] = (p.bait[item.id] or 0) + item.amount
            p.equipped.bait = item.id
        end
    else
        if not p.owned[data.category][item.id] then
            if p.coins &lt; item.cost then notify(player, "Catch and sell more fish to afford this gear.") return end
            p.coins = p.coins - item.cost
            p.owned[data.category][item.id] = true
        end
        p.equipped[data.category] = item.id
    end
    pushProfile(player)
    notify(player, item.name .. " equipped.")
end

local cast
local function startLine(player, s, hole)
    if sessions[player] ~= s then return end
    local p = profiles[player]
    local rod = Config.findGear("rod", p.equipped.rod)
    local lure = Config.findGear("lure", p.equipped.lure)
    local bait = Config.findGear("bait", p.equipped.bait)
    if bait.amount &gt; 0 and (p.bait[bait.id] or 0) &lt;= 0 then
        bait, p.equipped.bait = Config.Gear.bait[1], "bread"
    end
    equip(s, "rod", rod.id)
    if not s.tool then finish(player, "escaped", "Your character isn't ready to hold a rod yet. Try again.") return end
    setStage(s, "casting")
    event:FireClient(player, "stage", { token = s.token, stage = "casting", reused = s.reused })
    task.delay(Config.CastDuration, function()
        if sessions[player] ~= s then return end
        if bait.amount &gt; 0 then p.bait[bait.id] = p.bait[bait.id] - 1 end
        s.fish = FishGeneration.roll(Config, HoleRules.fishingTier(hole), hole.luck + rod.luck + lure.luck + bait.luck,
            { bait = bait.id, lure = lure.id, strength = rod.strength }, function() return rng:NextNumber() end)
        s.settings = Config.reelSettings(rod)
        s.width = Config.Fishing.BaseWidth + rod.control
        s.line, s.bobber = World.line(hole, s.tool)
        s.lineLowerUntil = workspace:GetServerTimeNow() + 0.45
        s.hole = hole
        setStage(s, "waiting")
        pushProfile(player)
        event:FireClient(player, "stage", { token = s.token, stage = "waiting", reused = s.reused })
        task.delay(rng:NextNumber(1.8, 4.2) / bait.biteSpeed, function()
            if sessions[player] ~= s then return end
            if not onPond(player) then finish(player, "escaped", "Your cast was interrupted.") return end
            s.elapsed, s.simAccumulator, s.sendAccumulator = 0, 0, 0
            s.target = Reel.target(s.phase, s.fish.difficulty, 0)
            setStage(s, "reeling")
            event:FireClient(player, "bite", snapshot(s))
        end)
    end)
end

cast = function(player, forceNew)
    if player:GetAttribute("AdminFlying") or player:GetAttribute("AdminFrozen") then notify(player, "Stop flying or unfreeze before fishing.") return end
    if sessions[player] then notify(player, "You're already fishing. Use Cancel to stop.") return end
    if not onPond(player) then notify(player, "Walk onto the frozen pond first.") return end
    local p, root = profiles[player], rootOf(player)
    if #p.bag &gt;= 100 then notify(player, "Your fish bag is full. Sell your catch at the shop.") return end
    local auger = Config.findGear("auger", p.equipped.auger)
    local hole = holes[player]
    local distance = hole and (root.Position - hole.position).Magnitude or math.huge
    local reuse = not forceNew and HoleRules.canReuse(hole, player.UserId, distance, Config.HoleUseDistance)
    local position
    if reuse then position = hole.position
    else
        local direction = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        direction = direction.Magnitude &lt; 0.1 and Vector3.new(0, 0, 1) or direction.Unit
        position = root.Position + direction * (auger.size / 2 + 1.6)
        position = Vector3.new(position.X, Config.Pond.SurfaceY, position.Z)
        if Vector2.new(position.X, position.Z).Magnitude &gt; Config.Pond.Radius - auger.size / 2 - 1 then
            notify(player, "Move closer to the middle of the pond to drill safely.") return
        end
        for owner, other in pairs(holes) do
            if owner ~= player and (other.position - position).Magnitude &lt; (other.size + auger.size) / 2 + 2 then
                notify(player, "Give the other fishing hole a little room.") return
            end
        end
        for owner, other in pairs(sessions) do
            if owner ~= player and other.drillPosition and (other.drillPosition - position).Magnitude &lt; (other.drillSize + auger.size) / 2 + 2 then
                notify(player, "Another angler is drilling there. Leave a little room.") return
            end
        end
    end
    local lookAt = Vector3.new(position.X, root.Position.Y, position.Z)
    if (lookAt - root.Position).Magnitude &gt; 0.1 then root.CFrame = CFrame.lookAt(root.Position, lookAt) end
    local s = { token = HttpService:GenerateGUID(false), phase = rng:NextNumber(0, 6), bar = 0.5, velocity = 0,
        progress = 0.25, tension = 0, held = false, position = root.Position, reused = reuse }
    if not reuse then s.drillPosition, s.drillSize = position, auger.size end
    sessions[player] = s
    lockMovement(player, s)
    if reuse then startLine(player, s, hole) return end
    equip(s, "auger", auger.id)
    if not s.tool then finish(player, "escaped", "Your character isn't ready to hold an auger yet. Try again.") return end
    setStage(s, "drilling")
    s.drillEffect = World.drilling(world, position)
    local duration = auger.drillTime or Config.DrillDuration
    event:FireClient(player, "stage", { token = s.token, stage = "drilling", startedAt = s.stageAt, duration = duration })
    task.delay(duration, function()
        if sessions[player] ~= s then return end
        removeHole(player)
        local model, prompt = World.hole(world, position, auger.size, player)
        hole = { model = model, position = position, size = auger.size, tier = auger.tier, luck = auger.luck, ownerId = player.UserId }
        holes[player] = hole
        s.drillPosition = nil
        model:SetAttribute("Tier", auger.tier)
        model:SetAttribute("OwnerId", player.UserId)
        prompt.Triggered:Connect(function(visitor)
            if visitor ~= player then notify(visitor, "This is another angler's hole. Drill your own nearby.") return end
            -- Native prompts are still validated server-side for range and state.
            if profiles[player] and holes[player] == hole then cast(player, false) end
        end)
        startLine(player, s, hole)
    end)
end

local function sellFish(player)
    if closing or not profiles[player] or player:GetAttribute("ProfileReady") ~= true then return end
    if not nearShop(player) or sessions[player] then notify(player, "Visit the shop after finishing your cast to sell fish.") return end
    local p, value = profiles[player], 0
    for _, fish in ipairs(p.bag) do value = value + fish.value end
    if p.coins + value &gt; Config.MaxCoins then notify(player, "You have reached the coin limit. Your fish have been kept.") return end
    p.statistics.sold = p.statistics.sold + #p.bag
    p.statistics.earned = p.statistics.earned + value
    p.bag, p.coins = {}, p.coins + value
    pushProfile(player)
    notify(player, value &gt; 0 and ("Sold your catch for " .. value .. " coins!") or "Your bag is empty. Head to the pond!")
end

local allowedActions = { ready = true, shop = true, buy = true, sell = true, cast = true, drill = true, cancel = true, input = true }
command.OnServerEvent:Connect(function(player, action, data)
    if closing or not profiles[player] or player:GetAttribute("ProfileReady") ~= true or type(action) ~= "string" then return end
    if not allowedActions[action] then return end
    local now = os.clock()
    limits[player] = limits[player] or {}
    -- Input transitions must not be dropped by the general UI click debounce.
    local interval = action == "input" and 0.005 or 0.25
    if now - (limits[player][action] or -math.huge) &lt; interval then return end
    limits[player][action] = now
    if action == "ready" then pushProfile(player)
    elseif action == "shop" then
        if nearShop(player) then event:FireClient(player, "shop") else notify(player, "The tackle shop is in the cabin by the pond.") end
    elseif action == "buy" then buy(player, data)
    elseif action == "sell" then sellFish(player)
    elseif action == "cast" then cast(player, false)
    elseif action == "drill" then cast(player, true)
    elseif action == "cancel" then finish(player, "escaped", "Cast cancelled. Your hole is ready to use again.")
    elseif action == "input" then
        local s = sessions[player]
        if s and type(data) == "table" and data.token == s.token and type(data.held) == "boolean" then
            s.held, s.lastInputAt = data.held, now
        end
    end
end)
shopPrompt.Triggered:Connect(function(player)
    if profiles[player] and nearShop(player) then event:FireClient(player, "shop") end
end)
sellPrompt.Triggered:Connect(function(player)
    local root = rootOf(player)
    if root and (root.Position - Vector3.new(11, 4, -86)).Magnitude &lt;= 12 then sellFish(player) end
end)

AdminService.start({ profiles = profiles, remotes = remotes, pushProfile = pushProfile, notify = notify, cancel = finish })

local function addPlayer(player)
    if profiles[player] or loading[player] or closing then return end
    loading[player] = true
    player:SetAttribute("ProfileReady", false)
    local profile, problem = Data.load(player)
    loading[player] = nil
    if not profile then
        if player.Parent == Players then player:Kick(problem or "Your saved profile could not be loaded. Please rejoin.") end
        return
    end
    if closing or player.Parent ~= Players then Data.release(player) return end
    profiles[player] = profile
    local stats = Instance.new("Folder")
    stats.Name, stats.Parent = "leaderstats", player
    for _, name in ipairs({ "Coins", "Fish", "Level" }) do
        local value = Instance.new("IntValue")
        value.Name, value.Parent = name, stats
    end
    player:SetAttribute("ProfileReady", true)
    pushProfile(player)
    player.CharacterRemoving:Connect(function() finish(player, "escaped", "Cast interrupted. Your hole is still there.") end)
end
Players.PlayerAdded:Connect(addPlayer)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() addPlayer(player) end) end
Players.PlayerRemoving:Connect(function(player)
    local s = sessions[player]
    if s then clearTool(s) unlockMovement(s) end
    player:SetAttribute("ProfileReady", false)
    sessions[player], profiles[player], limits[player] = nil, nil, nil
    removeHole(player)
    Data.release(player)
end)
game:BindToClose(function()
    closing = true
    for player in pairs(profiles) do
        finish(player, "escaped", "The server is closing.")
        player:SetAttribute("ProfileReady", false)
    end
    Data.shutdown()
end)

local maintenance = 0

RunService.Heartbeat:Connect(function(dt)
    maintenance = maintenance + dt
    if maintenance &gt;= 1 then maintenance = 0 Data.step() end
    for player, s in pairs(sessions) do
        local root = rootOf(player)
        if player:GetAttribute("ProfileReady") ~= true or not root or (root.Position - s.position).Magnitude &gt; 8 then
            finish(player, "escaped", "Your cast was interrupted. The hole is ready to use again.")
        else
            local t = workspace:GetServerTimeNow() - s.stageAt
            if s.grip then
                if s.stage == "drilling" then
                    s.grip.C0 = s.gripBase * CFrame.new(0, math.sin(t * 10) * 0.06, 0) * CFrame.Angles(0, t * 9, 0)
                elseif s.stage == "casting" then
                    s.grip.C0 = s.gripBase * CFrame.Angles(math.sin(math.min(1, t / Config.CastDuration) * math.pi) * 0.55, 0, 0)
                else
                    s.grip.C0 = s.gripBase * CFrame.Angles(math.sin(t * (s.held and 8 or 2)) * (s.stage == "reeling" and 0.07 or 0.02), 0, 0)
                end
            end
            if s.bobber and workspace:GetServerTimeNow() &gt;= s.lineLowerUntil then
                s.bobber.Position = s.hole.position + Vector3.new(math.sin(t * 2) * 0.06, 0.24 + math.sin(t * 4) * 0.035, 0)
            end
            if s.stage == "reeling" then
                if s.lastInputAt and os.clock() - s.lastInputAt &gt; 0.6 then s.held = false end
                s.simAccumulator = s.simAccumulator + math.min(dt, 0.25)
                s.sendAccumulator = s.sendAccumulator + dt
                local outcome
                while s.simAccumulator &gt;= Config.Fishing.FixedStep and not outcome do
                    s.simAccumulator = s.simAccumulator - Config.Fishing.FixedStep
                    s.elapsed = s.elapsed + Config.Fishing.FixedStep
                    outcome = Reel.step(s, Config.Fishing.FixedStep, s.held, s.fish, s.settings, s.elapsed)
                end
                if outcome then finish(player, outcome)
                elseif s.sendAccumulator &gt;= Config.Fishing.Tick then
                    s.sendAccumulator = 0
                    event:FireClient(player, "reel", snapshot(s))
                end
            end
        end
    end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Progression = require(ReplicatedStorage.Shared.Progression)
local Settings = require(script.Parent.ServerSettings)
local Schema = require(script.Parent.ProfileSchema).create(Config, Progression)
local PlayerStore = require(script.Parent.PlayerStore)
local Service = {}
local sandbox = RunService:IsStudio() and not Settings.StudioPersistence
if RunService:IsStudio() and Settings.StudioPersistence then
    assert(Settings.StudioStoreName ~= Settings.LiveStoreName, "Studio must use its separate test DataStore name.")
end
local storage = not sandbox and DataStoreService:GetDataStore(RunService:IsStudio() and Settings.StudioStoreName or Settings.LiveStoreName) or nil
local store = not sandbox and PlayerStore.new({
    store = storage, schema = Schema, clock = os.time, wait = task.wait, spawn = task.spawn,
    token = game.JobId .. ":" .. HttpService:GenerateGUID(false),
    autosaveSeconds = Settings.AutosaveSeconds, leaseSeconds = Settings.LeaseSeconds,
    onLost = function(id)
        local player = Players:GetPlayerByUserId(id)
        if player then player:SetAttribute("ProfileReady", false) player:Kick("Your saved session could not be kept safe. Please rejoin.") end
    end,
    onError = function(id)
        warn("[PlayerData] Save delayed for user " .. id .. "; retrying before the session lease expires.")
    end,
}) or nil

function Service.load(player)
    if sandbox then
        player:SetAttribute("DataMode", "Studio sandbox · not saved")
        return Schema.new()
    end
    player:SetAttribute("DataMode", RunService:IsStudio() and "Studio test saves" or "Saved progression")
    local profile, problem = store:load(player.UserId)
    if not profile then return nil, problem end
    return profile
end
function Service.release(player)
    if sandbox then return true end
    local ok, problem = store:release(player.UserId)
    if not ok then warn("[PlayerData] Final save failed for " .. player.UserId .. ": " .. tostring(problem)) end
    return ok
end
function Service.step() if store then store:step() end end
function Service.shutdown() if store and not store:shutdown() then warn("[PlayerData] Some profiles could not finish saving before shutdown.") end end
return Service
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">PlayerStore</string>
          <ProtectedString name="Source">-- Storage orchestration is independent of Roblox for fault-injection tests.
local PlayerStore = {}
PlayerStore.__index = PlayerStore

function PlayerStore.new(options)
    return setmetatable({ options = options, entries = {}, closing = false }, PlayerStore)
end

function PlayerStore:_update(id, transform)
    local lastError
    for attempt = 1, 3 do
        local ok, result = pcall(function() return self.options.store:UpdateAsync("player_" .. id, transform) end)
        if ok then return true, result end
        lastError = tostring(result)
        if attempt &lt; 3 then self.options.wait(attempt) end
    end
    return false, lastError
end

function PlayerStore:load(id)
    if self.closing or self.entries[id] then return nil, "Profile is already active or server is closing." end
    local o, reason = self.options, nil
    local ok, record = self:_update(id, function(old)
        reason = nil
        if old ~= nil and (type(old) ~= "table" or (old.version ~= 1 and old.version ~= o.schema.version)) then
            reason = "Unsupported saved profile. No data was overwritten." return nil
        end
        local lease = old and old.lease
        if lease and (type(lease) ~= "table" or type(lease.expires) ~= "number" or lease.expires ~= lease.expires
            or math.abs(lease.expires) == math.huge or type(lease.token) ~= "string") then
            reason = "Invalid saved session. No data was overwritten." return nil
        end
        if lease and lease.token ~= o.token and lease.expires &gt; o.clock() then
            reason = "Your previous session is still saving. Please rejoin shortly." return nil
        end
        local data, problem
        if old then data, problem = o.schema.migrate(old.data) else data = o.schema.new() end
        if not data then reason = "Saved profile could not be loaded: " .. tostring(problem) return nil end
        return { version = o.schema.version, data = data, lease = { token = o.token, expires = o.clock() + o.leaseSeconds } }
    end)
    if not ok then return nil, "Saving service is unavailable. Please rejoin later." end
    if not record or not record.lease or record.lease.token ~= o.token then return nil, reason or "Profile is busy. Please rejoin." end
    if self.closing then
        self.entries[id] = { data = record.data, leaseUntil = record.lease.expires, nextSave = 0 }
        self:release(id)
        return nil, "Server is closing. Please rejoin."
    end
    self.entries[id] = { data = record.data, leaseUntil = record.lease.expires,
        nextSave = o.clock() + o.autosaveSeconds + id % 11 }
    return record.data
end

function PlayerStore:save(id, release)
    local entry, o = self.entries[id], self.options
    if not entry or entry.lost then return false, "Profile is not owned." end
    if entry.busy then return false, "busy" end
    entry.busy = true
    local snapshot = o.schema.clone(entry.data)
    local ok, result = self:_update(id, function(old)
        if not old or not old.lease or old.lease.token ~= o.token or old.lease.expires &lt;= o.clock() then return nil end
        if old.version ~= o.schema.version then return nil end
        return { version = o.schema.version, data = snapshot,
            lease = not release and { token = o.token, expires = o.clock() + o.leaseSeconds } or nil }
    end)
    entry.busy = false
    if ok and result and (release and not result.lease or not release and result.lease and result.lease.token == o.token) then
        if release then self.entries[id] = nil else
            entry.leaseUntil, entry.nextSave = result.lease.expires, o.clock() + o.autosaveSeconds
            entry.lost = false
            if entry.releasePending then entry.nextSave = o.clock() end
        end
        return true
    end
    if ok then
        entry.lost = true
        if o.onLost then o.onLost(id) end
    else
        entry.nextSave = o.clock() + 10
        if o.onError then o.onError(id) end
    end
    return false, ok and "Session ownership was lost." or "Saving service is unavailable."
end

function PlayerStore:release(id)
    local entry = self.entries[id]
    if not entry then return true end
    entry.releasing = true
    local deadline = self.options.clock() + 20
    while entry.busy and self.options.clock() &lt; deadline do self.options.wait(0.1) end
    if entry.busy then
        entry.releasing, entry.releasePending = false, true
        return false, "Save did not finish before shutdown."
    end
    local ok, problem = self:save(id, true)
    if not ok and not entry.lost then
        entry.releasing, entry.releasePending = false, true
        entry.nextSave = self.options.clock() + 10
    end
    return ok, problem
end

function PlayerStore:step()
    local o = self.options
    for id, entry in pairs(self.entries) do
        if not entry.lost and o.clock() &gt;= entry.leaseUntil - 5 then
            entry.lost = true
            if o.onLost then o.onLost(id) end
        elseif not entry.busy and not entry.lost and not entry.releasing and o.clock() &gt;= entry.nextSave then
            -- Reserve before spawning so consecutive heartbeats cannot queue saves.
            entry.nextSave = o.clock() + o.autosaveSeconds
            o.spawn(function()
                if entry.releasePending then self:release(id) else self:save(id, false) end
            end)
        end
    end
end

function PlayerStore:shutdown()
    self.closing = true
    for id in pairs(self.entries) do self.options.spawn(function() self:release(id) end) end
    local deadline = self.options.clock() + 25
    while next(self.entries) and self.options.clock() &lt; deadline do self:step() self.options.wait(0.1) end
    return next(self.entries) == nil
end

return PlayerStore
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <ProtectedString name="Source">-- Versioned, deterministic migrations; safe to run repeatedly in UpdateAsync.
local ProfileSchema = {}
local function clone(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for k, v in pairs(value) do result[k] = clone(v) end
    return result
end
ProfileSchema.clone = clone
local function finite(value) return type(value) == "number" and value == value and math.abs(value) &lt; math.huge end

function ProfileSchema.create(config, progression)
    local schema = { version = 2, clone = clone }
    function schema.new()
        local profile = { schemaVersion = 2, coins = config.StartingCoins, xp = 0, level = 1, bag = {}, bait = {},
            equipped = { auger = "hand", rod = "twig", lure = "plain", bait = "bread" },
            owned = { auger = { hand = true }, rod = { twig = true }, lure = { plain = true } },
            discoveries = {}, records = {}, statistics = { catches = 0, sold = 0, earned = 0 },
            settings = {}, quests = {}, unlockedRegions = { pond = true } }
        for _, bait in ipairs(config.Gear.bait) do if bait.amount &gt; 0 then profile.bait[bait.id] = 0 end end
        return profile
    end
    function schema.migrate(raw)
        if type(raw) ~= "table" then return nil, "invalid profile" end
        if raw.schemaVersion and (not finite(raw.schemaVersion) or raw.schemaVersion &gt; 2) then return nil, "unsupported data version" end
        if not finite(raw.coins) or raw.coins &lt; 0 or raw.coins &gt; config.MaxCoins then return nil, "invalid currency" end
        local p = schema.new()
        for _, key in ipairs({ "owned", "bait", "equipped" }) do
            if raw[key] ~= nil and type(raw[key]) ~= "table" then return nil, "invalid " .. key end
        end
        for _, category in ipairs({ "rod", "auger", "lure" }) do
            if raw.owned and raw.owned[category] ~= nil and type(raw.owned[category]) ~= "table" then return nil, "invalid equipment ownership" end
        end
        p.coins = math.floor(raw.coins)
        if raw.xp ~= nil and (not finite(raw.xp) or raw.xp &lt; 0) then return nil, "invalid XP" end
        p.xp = math.min(progression.MaxXP, math.floor(raw.xp or 0))
        p.level = progression.describe(p.xp).level
        for category, items in pairs(config.Gear) do
            if category ~= "bait" then
                for _, item in ipairs(items) do
                    if raw.owned and raw.owned[category] and raw.owned[category][item.id] == true then p.owned[category][item.id] = true end
                end
            else
                for _, item in ipairs(items) do
                    local count = raw.bait and raw.bait[item.id]
                    if count ~= nil and (not finite(count) or count &lt; 0) then return nil, "invalid bait count" end
                    if item.amount &gt; 0 then p.bait[item.id] = math.min(100000, math.floor(count or 0)) end
                end
            end
            local equipped = raw.equipped and raw.equipped[category]
            if config.findGear(category, equipped) and (category == "bait" or p.owned[category][equipped]) then p.equipped[category] = equipped end
        end
        if raw.bag ~= nil and type(raw.bag) ~= "table" then return nil, "invalid fish inventory" end
        if raw.bag and #raw.bag &gt; 100 then return nil, "oversized fish inventory" end
        local ids = {}
        for i, fish in ipairs(raw.bag or {}) do
            if type(fish) ~= "table" or type(fish.name) ~= "string" or not finite(fish.value) or fish.value &lt; 1
                or fish.value &gt; 10000000 or not finite(fish.kg) or fish.kg &lt;= 0 or fish.kg &gt; 10000 then
                return nil, "invalid fish entry"
            end
            local entry = clone(fish)
            if type(entry.rarity) ~= "string" or type(entry.color) ~= "table" then return nil, "invalid fish appearance" end
            for channel = 1, 3 do
                if not finite(entry.color[channel]) or entry.color[channel] &lt; 0 or entry.color[channel] &gt; 255 then return nil, "invalid fish color" end
            end
            entry.catchId = type(entry.catchId) == "string" and entry.catchId or ("legacy-" .. i)
            if ids[entry.catchId] then return nil, "duplicate catch ID" end
            ids[entry.catchId] = true
            table.insert(p.bag, entry)
        end
        for _, key in ipairs({ "discoveries", "records", "statistics", "settings", "quests", "unlockedRegions" }) do
            if raw[key] ~= nil and type(raw[key]) ~= "table" then return nil, "invalid " .. key end
            if raw[key] then p[key] = clone(raw[key]) end
        end
        for _, key in ipairs({ "catches", "sold", "earned" }) do
            local value = p.statistics[key]
            if value ~= nil and (not finite(value) or value &lt; 0) then return nil, "invalid statistics" end
            p.statistics[key] = math.floor(value or 0)
        end
        for id, value in pairs(p.discoveries) do
            if type(id) ~= "string" or type(value) ~= "boolean" then return nil, "invalid discoveries" end
        end
        for id, value in pairs(p.records) do
            if type(id) ~= "string" or not finite(value) or value &lt;= 0 then return nil, "invalid fish records" end
        end
        return p
    end
    return schema
end
return ProfileSchema
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18">
        <Properties>
          <string name="Name">ServerSettings</string>
          <ProtectedString name="Source">-- This module stays in ServerScriptService, never ReplicatedStorage.
return {
    LiveStoreName = "FrostbitePlayers_v2",
    StudioStoreName = "FrostbiteStudio_TEST_v2",
    StudioPersistence = false, -- Explicitly enable only in a published TEST place.
    AutosaveSeconds = 60,
    LeaseSeconds = 180,
    AdminUsername = "unbenator",
    AdminUserIds = {}, -- Optional permanent numeric IDs; independent of renames.
    StudioAdminUserIds = {}, -- Optional Studio test players, e.g. -1; never live.
    MaxMoneyGrant = 1000000,
    MaxXPGrant = 100000,
    FlySpeed = 55,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX19">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local World = {}
local Lighting = game:GetService("Lighting")
local Equipment = require(game:GetService("ReplicatedStorage").Shared.Equipment)
local TweenService = game:GetService("TweenService")

local function part(parent, name, size, position, color, material)
    local p = Instance.new("Part")
    p.Name, p.Size, p.Position = name, size, position
    p.Anchored, p.Color = true, color
    p.Material = material or Enum.Material.SmoothPlastic
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

-- Surface signs stay attached to their physical boards and respect occlusion.
local function signFace(board, face, title, subtitle)
    local surface = Instance.new("SurfaceGui")
    surface.Name, surface.Face = "Lettering", face
    surface.SizingMode, surface.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 45
    surface.AlwaysOnTop, surface.LightInfluence, surface.MaxDistance = false, 0.15, 150
    surface.Parent = board
    for i, value in ipairs({ title, subtitle }) do
        local t = Instance.new("TextLabel")
        t.Size = UDim2.fromScale(0.92, i == 1 and 0.49 or 0.25)
        t.Position = UDim2.fromScale(0.04, i == 1 and 0.08 or 0.65)
        t.BackgroundTransparency, t.Text, t.TextScaled = 1, value, true
        t.Font = i == 1 and Enum.Font.GothamBold or Enum.Font.Gotham
        t.TextColor3 = i == 1 and Color3.fromRGB(255, 223, 160) or Color3.fromRGB(176, 223, 213)
        t.Parent = surface
    end
end

local function sign(parent, name, size, position, title, subtitle)
    local board = part(parent, name, size, position, Color3.fromRGB(29, 64, 68), Enum.Material.Wood)
    for _, x in ipairs({ -1, 1 }) do
        part(parent, "SignTrim", Vector3.new(0.2, size.Y + 0.3, size.Z + 0.12), position + Vector3.new(x * size.X / 2, 0, 0), Color3.fromRGB(183, 139, 83), Enum.Material.Wood)
    end
    for _, y in ipairs({ -1, 1 }) do
        part(parent, "SignTrim", Vector3.new(size.X, 0.2, size.Z + 0.12), position + Vector3.new(0, y * size.Y / 2, 0), Color3.fromRGB(183, 139, 83), Enum.Material.Wood)
    end
    signFace(board, Enum.NormalId.Back, title, subtitle)
    signFace(board, Enum.NormalId.Front, title, subtitle)
    return board
end

function World.build(config)
    local old = workspace:FindFirstChild("FrostbiteWorld")
    if old then old:Destroy() end
    local world = Instance.new("Folder")
    world.Name, world.Parent = "FrostbiteWorld", workspace
    Lighting.ClockTime, Lighting.Brightness = 14, 2
    Lighting.Ambient = Color3.fromRGB(140, 166, 190)
    Lighting.OutdoorAmbient = Color3.fromRGB(165, 187, 207)
    Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.fromRGB(197, 219, 235), 210, 580
    local sky = Instance.new("Atmosphere")
    sky.Density, sky.Color, sky.Decay = 0.22, Color3.fromRGB(199, 222, 240), Color3.fromRGB(135, 168, 195)
    sky.Parent = Lighting

    part(world, "Snowfield", Vector3.new(420, 8, 420), Vector3.new(0, -4, 0), Color3.fromRGB(233, 241, 245), Enum.Material.Snow)
    local pond = part(world, "FrozenPond", Vector3.new(2, 136, 136), Vector3.new(0, 1, 0), Color3.fromRGB(145, 201, 219), Enum.Material.Ice)
    pond.Shape, pond.Orientation, pond.Reflectance = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), 0.15
    local rng = Random.new(2026)
    -- Thin pale cracks across the frozen surface, kept non-colliding.
    for i = 1, 30 do
        local angle, radius = rng:NextNumber(0, math.pi * 2), rng:NextNumber(6, 59)
        local crack = part(world, "IceVein", Vector3.new(rng:NextNumber(3, 11), 0.015, 0.09),
            Vector3.new(math.cos(angle) * radius, 2.012, math.sin(angle) * radius), Color3.fromRGB(209, 238, 245), Enum.Material.Ice)
        crack.Orientation, crack.CanCollide, crack.CanQuery = Vector3.new(0, rng:NextNumber(0, 360), 0), false, false
    end
    for i = 1, 58 do
        local angle = i * math.pi * 2 / 58 + rng:NextNumber(-0.04, 0.04)
        local radius = rng:NextNumber(87, 175)
        local x, z = math.cos(angle) * radius, math.sin(angle) * radius
        if not (math.abs(x) &lt; 29 and z &lt; -65) then
            local height = rng:NextNumber(16, 29)
            part(world, "PineTrunk", Vector3.new(2.1, height * 0.6, 2.1), Vector3.new(x, height * 0.3, z), Color3.fromRGB(90, 71, 59), Enum.Material.Wood)
            for level = 1, 3 do
                local width = (4 - level) * 3.5
                local leaf = part(world, "PineBoughs", Vector3.new(width, height * 0.32, width), Vector3.new(x, height * (0.30 + level * 0.19), z), Color3.fromRGB(45 + level * 8, 89 + level * 6, 82 + level * 5), Enum.Material.Grass)
                leaf.Shape = Enum.PartType.Ball
                local snow = part(world, "PineSnow", Vector3.new(width * 0.92, height * 0.15, width * 0.92), leaf.Position + Vector3.new(0, height * 0.1, 0), Color3.fromRGB(238, 246, 250), Enum.Material.Snow)
                snow.Shape = Enum.PartType.Ball
            end
        end
    end

    local shop = Instance.new("Model")
    shop.Name, shop.Parent = "TackleShop", world
    part(shop, "Floor", Vector3.new(32, 1, 23), Vector3.new(0, 0.5, -96), Color3.fromRGB(124, 94, 72), Enum.Material.WoodPlanks)
    part(shop, "BackWall", Vector3.new(32, 15, 1), Vector3.new(0, 8, -107), Color3.fromRGB(111, 74, 54), Enum.Material.WoodPlanks)
    for _, x in ipairs({ -15.5, 15.5 }) do
        part(shop, "SideWall", Vector3.new(1, 15, 23), Vector3.new(x, 8, -96), Color3.fromRGB(111, 74, 54), Enum.Material.WoodPlanks)
        part(shop, "PorchPost", Vector3.new(1.2, 15, 1.2), Vector3.new(x, 8, -82), Color3.fromRGB(85, 59, 47), Enum.Material.Wood)
    end
    part(shop, "Roof", Vector3.new(36, 2, 30), Vector3.new(0, 16, -94), Color3.fromRGB(226, 238, 242), Enum.Material.Snow)
    local counter = part(shop, "Counter", Vector3.new(24, 4, 3), Vector3.new(0, 3, -96), Color3.fromRGB(161, 112, 76), Enum.Material.WoodPlanks)
    sign(shop, "CabinSign", Vector3.new(25, 3.6, 0.6), Vector3.new(0, 12.9, -81.2), "FROSTBITE TACKLE", "AUGERS  •  RODS  •  BAIT  •  LURES")
    sign(shop, "SellSign", Vector3.new(10, 1.8, 0.25), Vector3.new(0, 3.3, -94.35), "SELL YOUR CATCH", "Fresh fish. Fair prices.")
    -- Real 3D stock on the back wall, matching the preview and held models.
    part(shop, "EquipmentRack", Vector3.new(28, 0.4, 2), Vector3.new(0, 4, -105), Color3.fromRGB(81, 59, 45), Enum.Material.Wood)
    for i, id in ipairs({ "twig", "birch", "carbon", "glacier" }) do
        local stock = Equipment.build("rod", id)
        stock.Parent = shop
        stock:PivotTo(CFrame.new(-12 + i * 3.2, 5, -105) * CFrame.Angles(0, 0, math.rad(-12)))
    end
    for i, id in ipairs({ "hand", "power" }) do
        local stock = Equipment.build("auger", id)
        stock.Parent = shop
        stock:PivotTo(CFrame.new(6 + i * 3, 9, -105))
    end
    local promptPart = part(shop, "ShopPrompt", Vector3.new(1, 1, 1), Vector3.new(0, 4, -87), Color3.new(1, 1, 1))
    promptPart.Transparency, promptPart.CanCollide = 1, false
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText = "Shop &amp; sell fish", "Frostbite Tackle"
    prompt.MaxActivationDistance, prompt.HoldDuration, prompt.RequiresLineOfSight = 18, 0, false
    prompt.Parent = promptPart
    local light = Instance.new("PointLight")
    light.Color, light.Range, light.Brightness, light.Parent = Color3.fromRGB(255, 209, 137), 35, 1.8, counter

    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Size, spawn.Position = "LakesideSpawn", Vector3.new(10, 1, 8), Vector3.new(0, 0.5, -73)
    spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 0
    spawn.Color, spawn.Material, spawn.Parent = Color3.fromRGB(220, 232, 237), Enum.Material.Snow, world
    sign(world, "PondSign", Vector3.new(12, 4, 0.7), Vector3.new(21, 5, -71), "FROSTBITE POND", "DRILL ONCE. FISH ALL DAY.")
    for _, x in ipairs({ 16, 26 }) do
        part(world, "SignPost", Vector3.new(0.6, 4.6, 0.6), Vector3.new(x, 2.3, -71), Color3.fromRGB(104, 77, 54), Enum.Material.Wood)
    end

    -- An impassable natural edge keeps players inside the playable snowfield.
    for i = 1, 24 do
        local angle = i * math.pi * 2 / 24
        local rock = part(world, "SnowyRidge", Vector3.new(57, 45 + (i % 4) * 7, 44), Vector3.new(math.cos(angle) * 207, 15, math.sin(angle) * 207), Color3.fromRGB(191, 211, 222), Enum.Material.Slate)
        rock.Shape = Enum.PartType.Ball
    end
    local buyer = Instance.new("Model")
    buyer.Name, buyer.Parent = "MaraFishBuyer", world
    local base = Vector3.new(11, 1, -86)
    local torso = part(buyer, "Torso", Vector3.new(2, 2, 1), base + Vector3.new(0, 3, 0), Color3.fromRGB(53, 104, 116))
    local head = part(buyer, "Head", Vector3.new(1.6, 1, 1.2), base + Vector3.new(0, 4.5, 0), Color3.fromRGB(219, 171, 128))
    local npcRoot = part(buyer, "HumanoidRootPart", Vector3.new(2, 2, 1), torso.Position, Color3.new(1, 1, 1))
    npcRoot.Transparency, npcRoot.CanCollide = 1, false
    buyer.PrimaryPart = npcRoot
    local neck = Instance.new("Motor6D")
    neck.Name, neck.Part0, neck.Part1 = "Neck", torso, head
    neck.C0, neck.C1, neck.Parent = CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0), torso
    for _, side in ipairs({ -1, 1 }) do
        part(buyer, side == 1 and "Right Arm" or "Left Arm", Vector3.new(1, 2, 1), base + Vector3.new(side * 1.5, 3, 0), Color3.fromRGB(53, 104, 116))
        part(buyer, side == 1 and "Right Leg" or "Left Leg", Vector3.new(0.95, 2, 1), base + Vector3.new(side * 0.5, 1, 0), Color3.fromRGB(48, 57, 68))
        part(buyer, "Mitten", Vector3.new(0.95, 0.5, 1.02), base + Vector3.new(side * 1.5, 2.15, 0), Color3.fromRGB(179, 133, 75))
        part(buyer, "Eye", Vector3.new(0.1, 0.12, 0.06), base + Vector3.new(side * 0.29, 4.55, 0.62), Color3.fromRGB(30, 42, 44))
    end
    part(buyer, "Beanie", Vector3.new(1.75, 0.45, 1.3), base + Vector3.new(0, 5.05, 0), Color3.fromRGB(210, 146, 67))
    local pom = part(buyer, "PomPom", Vector3.new(0.45, 0.45, 0.45), base + Vector3.new(0, 5.45, 0), Color3.fromRGB(247, 227, 179))
    pom.Shape = Enum.PartType.Ball
    part(buyer, "Scarf", Vector3.new(2.1, 0.3, 1.2), base + Vector3.new(0, 4, 0), Color3.fromRGB(210, 146, 67))
    local humanoid = Instance.new("Humanoid")
    humanoid.DisplayName, humanoid.NameDisplayDistance, humanoid.Parent = "Mara · Fish buyer", 45, buyer
    local sellPrompt = Instance.new("ProximityPrompt")
    sellPrompt.ActionText, sellPrompt.ObjectText = "Sell all fish", "Mara · Fish buyer"
    sellPrompt.MaxActivationDistance, sellPrompt.HoldDuration, sellPrompt.RequiresLineOfSight = 10, 0.25, false
    sellPrompt.Parent = torso
    return world, prompt, sellPrompt
end

function World.hole(parent, position, diameter, owner)
    local model = Instance.new("Model")
    model.Name, model.Parent = "Hole_" .. owner.UserId, parent
    local rim = part(model, "SnowRim", Vector3.new(0.1, diameter + 0.65, diameter + 0.65), Vector3.new(position.X, 2.04, position.Z), Color3.fromRGB(231, 249, 251), Enum.Material.Snow)
    rim.Shape, rim.Orientation, rim.CanCollide = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), false
    local water = part(model, "DarkWater", Vector3.new(0.12, diameter, diameter), Vector3.new(position.X, 2.11, position.Z), Color3.fromRGB(19, 57, 76), Enum.Material.Glass)
    water.Shape, water.Orientation, water.CanCollide, water.Reflectance = Enum.PartType.Cylinder, Vector3.new(0, 0, 90), false, 0.2
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText = "Cast again", owner.DisplayName .. "'s fishing hole"
    prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.HoldDuration = 10, false, 0
    prompt.Parent = water
    return model, prompt
end

function World.line(hole, equipment)
    local model = Instance.new("Model")
    model.Name, model.Parent = "FishingLine", hole.model
    local bobber = part(model, "Bobber", Vector3.new(0.25, 0.4, 0.25), hole.position + Vector3.new(0, 1.7, 0), Color3.fromRGB(236, 107, 78))
    bobber.Shape, bobber.CanCollide, bobber.CanQuery = Enum.PartType.Ball, false, false
    local anchor = Instance.new("Attachment")
    anchor.Parent = bobber
    local beam = Instance.new("Beam")
    beam.Attachment0 = equipment.PrimaryPart:FindFirstChild("LineTip")
    beam.Attachment1, beam.Width0, beam.Width1, beam.FaceCamera = anchor, 0.025, 0.025, true
    beam.Segments, beam.CurveSize0, beam.CurveSize1 = 16, 0.35, 0.35
    beam.Color, beam.Parent = ColorSequence.new(Color3.fromRGB(227, 238, 241)), bobber
    TweenService:Create(bobber, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = hole.position + Vector3.new(0, 0.24, 0) }):Play()
    return model, bobber
end

function World.drilling(parent, position)
    local source = part(parent, "IceShavings", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 0.2, 0), Color3.new(1, 1, 1))
    source.Transparency, source.CanCollide, source.CanQuery = 1, false, false
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(Color3.fromRGB(223, 249, 255))
    emitter.Rate, emitter.Lifetime, emitter.Speed = 28, NumberRange.new(0.25, 0.55), NumberRange.new(3, 7)
    emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) })
    emitter.SpreadAngle, emitter.Acceleration, emitter.Parent = Vector2.new(65, 65), Vector3.new(0, -16, 0), source
    return source
end

return World
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX22">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX23">
          <Properties>
            <string name="Name">AdminMenu</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local AdminMenu = {}

function AdminMenu.start(gui, remotes)
    local player = Players.LocalPlayer
    local command, event = remotes:WaitForChild("AdminCommand"), remotes:WaitForChild("AdminEvent")
    local navy, card, mint, gold, white = Color3.fromRGB(20, 41, 54), Color3.fromRGB(32, 57, 71), Color3.fromRGB(131, 230, 201), Color3.fromRGB(255, 213, 136), Color3.fromRGB(232, 245, 249)
    local function make(class, parent, props)
        local object = Instance.new(class)
        for k, v in pairs(props) do object[k] = v end
        object.Parent = parent
        return object
    end
    local function round(object) make("UICorner", object, { CornerRadius = UDim.new(0, 9) }) end
    local function text(parent, value, size, position, fontSize)
        return make("TextLabel", parent, { Text = value, Size = size, Position = position, TextSize = fontSize or 14,
            Font = Enum.Font.Gotham, TextColor3 = white, TextWrapped = true, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left })
    end
    local function button(parent, value, size, position, callback, color)
        local object = make("TextButton", parent, { Text = value, Size = size, Position = position, TextSize = 13, Font = Enum.Font.GothamBold,
            BackgroundColor3 = color or mint, TextColor3 = navy, BorderSizePixel = 0 })
        round(object) object.Activated:Connect(callback) return object
    end
    local function box(parent, placeholder, size, position)
        local object = make("TextBox", parent, { Text = "", PlaceholderText = placeholder, Size = size, Position = position, TextSize = 14,
            Font = Enum.Font.Gotham, TextColor3 = white, PlaceholderColor3 = Color3.fromRGB(170, 194, 206), BackgroundColor3 = card,
            BorderSizePixel = 0, ClearTextOnFocus = false })
        round(object) return object
    end
    local overlay = make("Frame", gui, { Name = "AdminOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0, Visible = false, ZIndex = 10 })
    local panel = make("Frame", overlay, { Size = UDim2.fromOffset(680, 560), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = navy, BorderSizePixel = 0 })
    round(panel)
    local scale = make("UIScale", panel, { Scale = 1 })
    text(panel, "FROSTBITE / ADMIN", UDim2.fromOffset(520, 34), UDim2.fromOffset(20, 14), 22).Font = Enum.Font.GothamBold
    text(panel, "Manage players in this server", UDim2.fromOffset(530, 24), UDim2.fromOffset(20, 49), 13)
    button(panel, "X", UDim2.fromOffset(36, 34), UDim2.new(1, -56, 0, 16), function() overlay.Visible = false end, gold)
    local selected, confirm = nil, nil
    local selection = text(panel, "Select a player", UDim2.fromOffset(415, 32), UDim2.fromOffset(245, 88), 17)
    local result = text(panel, "Choose a player, amount, and action.", UDim2.new(1, -40, 0, 48), UDim2.fromOffset(20, 492), 13)
    local rosterList = make("ScrollingFrame", panel, { Size = UDim2.fromOffset(205, 355), Position = UDim2.fromOffset(20, 90),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y })
    make("UIListLayout", rosterList, { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder })
    local amount = box(panel, "Amount (whole number)", UDim2.fromOffset(410, 36), UDim2.fromOffset(245, 128))
    local reason = box(panel, "Kick reason (optional)", UDim2.fromOffset(410, 36), UDim2.fromOffset(245, 174))
    local function request(action, needsTarget, needsConfirmation)
        if not player:GetAttribute("IsAdmin") then overlay.Visible = false return end
        if needsTarget and not selected then result.Text = "Select a player first." return end
        if needsConfirmation then
            local key = action .. ":" .. tostring(selected)
            if not confirm or confirm.key ~= key or os.clock() &gt; confirm.expires then
                confirm = { key = key, expires = os.clock() + 6 }
                result.Text = "Press " .. action .. " again within 6 seconds to confirm for the selected player."
                return
            end
        end
        confirm = nil
        command:FireServer({ action = action, targetId = selected, amount = tonumber(amount.Text), reason = reason.Text })
    end
    local actions = {
        { "Give coins", "money" }, { "Give XP", "xp" }, { "Go to player", "gotoPlayer" }, { "Bring player", "bring" },
        { "Freeze", "freeze" }, { "Unfreeze", "unfreeze" }, { "Heal", "heal" }, { "Respawn", "respawn", true }, { "Kick", "kick", true },
    }
    for i, action in ipairs(actions) do
        local column, row = (i - 1) % 2, math.floor((i - 1) / 2)
        button(panel, action[1], UDim2.fromOffset(198, 34), UDim2.fromOffset(245 + column * 212, 222 + row * 43), function()
            request(action[2], true, action[3])
        end, action[2] == "kick" and Color3.fromRGB(241, 144, 139) or mint)
    end
    local flyButton = button(panel, "Fly: OFF", UDim2.fromOffset(130, 34), UDim2.fromOffset(245, 446), function() request("fly") end, gold)
    button(panel, "To pond", UDim2.fromOffset(130, 34), UDim2.fromOffset(385, 446), function() request("pond") end, gold)
    button(panel, "To shop", UDim2.fromOffset(130, 34), UDim2.fromOffset(525, 446), function() request("shop") end, gold)
    button(panel, "Refresh players", UDim2.fromOffset(205, 30), UDim2.fromOffset(20, 451), function() request("roster") end, gold)
    local function toggle()
        if not player:GetAttribute("IsAdmin") then return end
        overlay.Visible = not overlay.Visible
        if overlay.Visible then request("roster") end
    end
    local badge = button(gui, "ADMIN  [F2]", UDim2.fromOffset(190, 30), UDim2.new(1, -206, 0, 164), toggle, gold)
    badge.Name = "AdminButton"
    badge.Visible = player:GetAttribute("IsAdmin") == true
    player:GetAttributeChangedSignal("IsAdmin"):Connect(function()
        badge.Visible = player:GetAttribute("IsAdmin") == true
        if not badge.Visible then overlay.Visible = false end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and not UserInputService:GetFocusedTextBox() and input.KeyCode == Enum.KeyCode.F2 then toggle() end
    end)
    event.OnClientEvent:Connect(function(kind, data)
        if not player:GetAttribute("IsAdmin") then return end
        if kind == "result" then result.Text = data
        elseif kind == "roster" then
            for _, child in ipairs(rosterList:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
            local found = false
            for i, target in ipairs(data) do
                if target.userId == selected then found = true end
                local entry = button(rosterList, "@" .. target.username .. "\n" .. target.displayName, UDim2.new(1, -6, 0, 55), UDim2.fromOffset(0, 0), function()
                    selected, confirm = target.userId, nil
                    selection.Text = "@" .. target.username .. "  /  " .. target.userId
                end, selected == target.userId and gold or mint)
                entry.LayoutOrder = i
            end
            if not found then selected, confirm = nil, nil selection.Text = "Select a player" end
        end
    end)
    -- Flight uses server-created constraints, enabled only after server approval.
    local up, down, flightBound = false, false, false
    local flightHud = make("Frame", gui, { Size = UDim2.fromOffset(260, 95), Position = UDim2.new(0.5, -130, 0, 90), BackgroundColor3 = navy, BorderSizePixel = 0, Visible = false })
    round(flightHud)
    text(flightHud, "FLY / WASD · Space up · Ctrl down", UDim2.new(1, -20, 0, 30), UDim2.fromOffset(10, 4), 12)
    local upButton = button(flightHud, "UP", UDim2.fromOffset(110, 40), UDim2.fromOffset(10, 42), function() end)
    local downButton = button(flightHud, "DOWN", UDim2.fromOffset(110, 40), UDim2.fromOffset(140, 42), function() end)
    local upPointer, downPointer
    upButton.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then upPointer = input end end)
    downButton.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then downPointer = input end end)
    UserInputService.InputEnded:Connect(function(input)
        if input == upPointer or input.UserInputType == Enum.UserInputType.MouseButton1 then upPointer = nil end
        if input == downPointer or input.UserInputType == Enum.UserInputType.MouseButton1 then downPointer = nil end
    end)
    UserInputService.WindowFocusReleased:Connect(function() up, down, upPointer, downPointer = false, false, nil, nil end)
    RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if camera then scale.Scale = math.min(1, (camera.ViewportSize.X - 20) / 680, (camera.ViewportSize.Y - 60) / 560) end
        local enabled = player:GetAttribute("IsAdmin") == true and player:GetAttribute("AdminFlying") == true
        flyButton.Text, flightHud.Visible = enabled and "Fly: ON" or "Fly: OFF", enabled
        if enabled and not flightBound then
            ContextActionService:BindActionAtPriority("AdminFlightVertical", function(_, state, input)
                local pressed = state == Enum.UserInputState.Begin
                if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then up = pressed else down = pressed end
                return Enum.ContextActionResult.Sink
            end, false, Enum.ContextActionPriority.High.Value + 200, Enum.KeyCode.Space, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonB)
            flightBound = true
        elseif not enabled and flightBound then
            ContextActionService:UnbindAction("AdminFlightVertical")
            flightBound, up, down, upPointer, downPointer = false, false, false, nil, nil
        end
        if not enabled or not camera then return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local velocity = root and root:FindFirstChild("AdminFlightVelocity")
        local orientation = root and root:FindFirstChild("AdminFlightOrientation")
        if not velocity or not orientation or not humanoid then return end
        local direction = Vector3.zero
        if not UserInputService:GetFocusedTextBox() and not overlay.Visible then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - camera.CFrame.RightVector end
            if direction.Magnitude &lt; 0.01 then direction = humanoid.MoveDirection end
            direction = direction + Vector3.new(0, ((up or upPointer) and 1 or 0) - ((down or downPointer) and 1 or 0), 0)
        end
        velocity.VectorVelocity = direction.Magnitude &gt; 0 and direction.Unit * (player:GetAttribute("AdminFlySpeed") or 55) or Vector3.zero
        orientation.CFrame = camera.CFrame.Rotation
    end)
end
return AdminMenu
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX24">
          <Properties>
            <string name="Name">AnglerAnimation</string>
            <ProtectedString name="Source">-- Procedural R6/R15 poses need no uploaded animation IDs or asset permissions.
-- Character attributes replicate the activity; each client animates all anglers.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Animation = {}

function Animation.start()
    local rigs = {}
    return RunService.RenderStepped:Connect(function(dt)
        local seen = {}
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            if character then
                seen[character] = true
                local stage = character:GetAttribute("FishingStage")
                local rig = rigs[character]
                if stage and not rig then
                    rig = { motors = {}, blend = 0 }
                    for _, m in ipairs(character:GetDescendants()) do
                        if m:IsA("Motor6D") and (m.Name == "RightShoulder" or m.Name == "LeftShoulder"
                            or m.Name == "Right Shoulder" or m.Name == "Left Shoulder" or m.Name == "Waist"
                            or m.Name == "Neck" or m.Name == "LeftWrist") then
                            table.insert(rig.motors, { motor = m, base = m.C0 })
                        end
                    end
                    rigs[character] = rig
                end
                if rig then
                    local alpha = 1 - math.exp(-14 * math.min(dt, 0.1))
                    rig.blend = rig.blend + ((stage and 1 or 0) - rig.blend) * alpha
                    local t = workspace:GetServerTimeNow() - (character:GetAttribute("FishingStageAt") or 0)
                    local drilling, reeling = stage == "drilling", stage == "reeling"
                    local cycle = math.sin(t * (drilling and 10 or reeling and 9 or 2))
                    local lift = drilling and 78 or (stage == "casting" and (62 + math.sin(math.min(t / 0.8, 1) * math.pi) * 30) or 58)
                    for _, entry in ipairs(rig.motors) do
                        local m, pose = entry.motor, CFrame.new()
                        if m.Parent then
                            if m.Name == "RightShoulder" then pose = CFrame.Angles(math.rad(lift + cycle * 3), math.rad(-10), math.rad(12))
                            elseif m.Name == "LeftShoulder" then pose = CFrame.Angles(math.rad(lift - 6 + cycle * (reeling and 9 or 3)), math.rad(20), math.rad(-25))
                            elseif m.Name == "Right Shoulder" then pose = CFrame.Angles(0, math.rad(-10), math.rad(lift + cycle * 3))
                            elseif m.Name == "Left Shoulder" then pose = CFrame.Angles(0, math.rad(15), math.rad(-lift + 10 - cycle * 6))
                            elseif m.Name == "LeftWrist" then pose = CFrame.Angles(reeling and math.sin(t * 10) * 0.3 or 0, 0, 0)
                            elseif m.Name == "Waist" then pose = CFrame.Angles(math.rad(8 + cycle), 0, 0)
                            elseif m.Name == "Neck" then pose = CFrame.Angles(math.rad(-9), 0, 0) end
                            m.C0 = entry.base * CFrame.new():Lerp(pose, rig.blend)
                        end
                    end
                    if not stage and rig.blend &lt; 0.001 then
                        for _, entry in ipairs(rig.motors) do if entry.motor.Parent then entry.motor.C0 = entry.base end end
                        rigs[character] = nil
                    end
                end
            end
        end
        for character in pairs(rigs) do if not seen[character] then rigs[character] = nil end end
    end)
end
return Animation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX25">
          <Properties>
            <string name="Name">EquipmentPreview</string>
            <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Equipment = require(ReplicatedStorage.Shared.Equipment)
local Preview = {}
local views, dragging = {}, nil

function Preview.mount(viewport, category, id)
    local world = Instance.new("WorldModel")
    world.Parent = viewport
    local model = Equipment.build(category, id)
    model.Parent = world
    local bounds, size = model:GetBoundingBox()
    model:PivotTo(CFrame.new(-bounds.Position) * model:GetPivot())
    local base = model:GetPivot()
    local camera = Instance.new("Camera")
    camera.FieldOfView = 36
    camera.Parent, viewport.CurrentCamera = viewport, camera
    viewport.Ambient, viewport.LightColor = Color3.fromRGB(180, 198, 213), Color3.fromRGB(255, 236, 209)
    viewport.LightDirection = Vector3.new(-1, -0.6, -1)
    local view = { model = model, camera = camera, viewport = viewport, base = base,
        angle = 0.4, height = size.Y, width = math.max(size.X, size.Z), zoom = 1 }
    views[viewport] = view
    viewport.Active = true
    viewport.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = { view = view, input = input, x = input.Position.X }
        end
    end)
    viewport.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then view.zoom = math.max(0.75, math.min(1.5, view.zoom - input.Position.Z * 0.1)) end
    end)
    viewport.Destroying:Connect(function()
        views[viewport] = nil
        if dragging and dragging.view == view then dragging = nil end
    end)
end

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragging.input) then
        dragging.view.angle = dragging.view.angle + (input.Position.X - dragging.x) * 0.012
        dragging.x = input.Position.X
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if dragging and (input == dragging.input or input.UserInputType == Enum.UserInputType.MouseButton1) then dragging = nil end
end)
UserInputService.WindowFocusReleased:Connect(function() dragging = nil end)

function Preview.step(dt)
    for viewport, v in pairs(views) do
        if viewport.Parent then
            if not dragging or dragging.view ~= v then v.angle = v.angle + dt * 0.35 end
            v.model:PivotTo(CFrame.Angles(0, v.angle, 0) * v.base)
            local aspect = math.max(0.2, viewport.AbsoluteSize.X / math.max(1, viewport.AbsoluteSize.Y))
            local distance = math.max(v.height, v.width / aspect) / (2 * math.tan(math.rad(18))) * 1.22 * v.zoom
            v.camera.CFrame = CFrame.lookAt(Vector3.new(0, v.height * 0.06, distance), Vector3.new())
        end
    end
end
return Preview
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX26">
          <Properties>
            <string name="Name">Game</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Reel = require(ReplicatedStorage.Shared:WaitForChild("Reel"))
local Progression = require(ReplicatedStorage.Shared:WaitForChild("Progression"))
local Preview = require(script.Parent:WaitForChild("EquipmentPreview"))
require(script.Parent:WaitForChild("AnglerAnimation")).start()
local remotes = ReplicatedStorage:WaitForChild("FishingRemotes")
local command, event = remotes:WaitForChild("Command"), remotes:WaitForChild("Event")
local C = {
    panel = Color3.fromRGB(20, 41, 54), card = Color3.fromRGB(32, 57, 71),
    text = Color3.fromRGB(232, 245, 249), muted = Color3.fromRGB(167, 196, 208),
    mint = Color3.fromRGB(131, 230, 201), gold = Color3.fromRGB(255, 213, 136),
    red = Color3.fromRGB(248, 134, 137), dark = Color3.fromRGB(16, 33, 44),
}
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "FrostbiteUI", false, Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function make(class, parent, props)
    local object = Instance.new(class)
    for k, v in pairs(props or {}) do object[k] = v end
    object.Parent = parent
    return object
end
local function rounded(object, radius)
    make("UICorner", object, { CornerRadius = UDim.new(0, radius or 12) })
end
local function frame(parent, size, position, color)
    local f = make("Frame", parent, { Size = size, Position = position, BackgroundColor3 = color or C.panel, BorderSizePixel = 0 })
    rounded(f)
    return f
end
local function text(parent, value, size, position, fontSize, color)
    return make("TextLabel", parent, { Text = value, Size = size, Position = position,
        BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = fontSize or 15,
        TextColor3 = color or C.text, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
end
local function button(parent, value, size, position, callback, color)
    local b = make("TextButton", parent, { Text = value, Size = size, Position = position,
        BackgroundColor3 = color or C.mint, TextColor3 = C.dark, BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = true })
    rounded(b, 9)
    if callback then b.Activated:Connect(callback) end
    return b
end
local function send(action, data) command:FireServer(action, data) end
local profile, activeTab, modalMode = nil, "auger", "shop"
local fishing, token, held = false, nil, false
local reelView, jumpLock = nil, nil
local drillingInfo = nil
local keyHeld, reelPointer = false, nil

local brand = frame(gui, UDim2.fromOffset(252, 76), UDim2.fromOffset(16, 16))
text(brand, "F R O S T B I T E", UDim2.new(1, -28, 0, 28), UDim2.fromOffset(14, 10), 20, C.mint).Font = Enum.Font.GothamBold
text(brand, "ICE FISHING  /  FROZEN WILDERNESS", UDim2.new(1, -28, 0, 20), UDim2.fromOffset(14, 43), 10, C.muted)
local wallet = frame(gui, UDim2.fromOffset(190, 138), UDim2.new(1, -206, 0, 16))
local coins = text(wallet, "120 coins", UDim2.new(1, -24, 0, 30), UDim2.fromOffset(12, 9), 21, C.gold)
coins.Font = Enum.Font.GothamBold
local bagCount = text(wallet, "Loading your profile...", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 43), 13, C.muted)
local levelLabel = text(wallet, "Level 1", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 68), 11, C.mint)
local xpTrack = frame(wallet, UDim2.new(1, -24, 0, 7), UDim2.fromOffset(12, 94), C.dark)
local xpFill = frame(xpTrack, UDim2.fromScale(0, 1), UDim2.fromOffset(0, 0), C.mint)
local dataMode = text(wallet, "Loading saved progress...", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 106), 10, C.muted)
player:GetAttributeChangedSignal("DataMode"):Connect(function() dataMode.Text = player:GetAttribute("DataMode") or "Loading saved progress..." end)
local guide = frame(gui, UDim2.fromOffset(246, 167), UDim2.fromOffset(16, 108))
text(guide, "A QUIET DAY ON THE ICE", UDim2.fromOffset(218, 26), UDim2.fromOffset(14, 10), 12, C.gold).Font = Enum.Font.GothamBold
text(guide, "01  Walk onto the frozen pond\n02  Drill once, reuse your hole\n03  Hold to follow the moving fish\n04  Sell fish at the cabin for gear", UDim2.fromOffset(218, 110), UDim2.fromOffset(14, 43), 14, C.muted)

local dock = frame(gui, UDim2.fromOffset(468, 126), UDim2.new(0.5, -234, 1, -106))
local castButton = button(dock, "DRILL / CAST  [F]", UDim2.fromOffset(208, 42), UDim2.fromOffset(12, 10), function() send(fishing and "cancel" or "cast") end)
button(dock, "SHOP  [B]", UDim2.fromOffset(108, 42), UDim2.fromOffset(230, 10), function() send("shop") end, C.gold)
local openBag
button(dock, "BAG  [I]", UDim2.fromOffset(108, 42), UDim2.fromOffset(348, 10), function() if openBag then openBag() end end, Color3.fromRGB(191, 218, 232))
button(dock, "NEW HOLE  [G]  /  replaces your previous hole", UDim2.new(1, -24, 0, 27), UDim2.fromOffset(12, 59), function()
    if not fishing then send("drill") end
end, Color3.fromRGB(191, 218, 232))
local loadout = text(dock, "Walk onto the ice to begin", UDim2.new(1, -24, 0, 20), UDim2.fromOffset(12, 94), 11, C.muted)
loadout.TextXAlignment = Enum.TextXAlignment.Center

local toast = frame(gui, UDim2.new(0.8, 0, 0, 72), UDim2.new(0.1, 0, 0, 104))
toast.Visible = false
make("UISizeConstraint", toast, { MaxSize = Vector2.new(580, 90) })
toast.AnchorPoint, toast.Position = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 104)
local toastText = text(toast, "", UDim2.new(1, -28, 1, -16), UDim2.fromOffset(14, 8), 16)
toastText.TextXAlignment = Enum.TextXAlignment.Center
local toastId = 0
local function notice(message, color)
    toastId = toastId + 1
    local id = toastId
    toastText.Text, toastText.TextColor3, toast.Visible = message, color or C.text, true
    task.delay(4.5, function() if toastId == id then toast.Visible = false end end)
end

local shade = make("TextButton", gui, { Text = "", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, Visible = false, AutoButtonColor = false })
local modal = frame(shade, UDim2.fromOffset(650, 530), UDim2.fromScale(0.5, 0.5))
modal.AnchorPoint = Vector2.new(0.5, 0.5)
local modalScale = make("UIScale", modal, { Scale = 1 })
local modalTitle = text(modal, "FROSTBITE TACKLE", UDim2.fromOffset(490, 34), UDim2.fromOffset(22, 16), 23, C.gold)
modalTitle.Font = Enum.Font.GothamBold
local modalSubtitle = text(modal, "Better gear. Bigger holes. Rarer fish.", UDim2.fromOffset(540, 24), UDim2.fromOffset(22, 52), 14, C.muted)
button(modal, "X", UDim2.fromOffset(36, 36), UDim2.new(1, -54, 0, 18), function() shade.Visible = false end, Color3.fromRGB(181, 203, 213))
local tabs = frame(modal, UDim2.new(1, -44, 0, 40), UDim2.fromOffset(22, 88), C.dark)
local list = make("ScrollingFrame", modal, { Size = UDim2.new(1, -44, 1, -208), Position = UDim2.fromOffset(22, 140), BackgroundTransparency = 1,
    BorderSizePixel = 0, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ScrollBarImageColor3 = C.muted })
make("UIListLayout", list, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
make("UIPadding", list, { PaddingBottom = UDim.new(0, 6), PaddingRight = UDim.new(0, 8) })
local sell = button(modal, "SELL ALL FISH", UDim2.new(1, -44, 0, 40), UDim2.new(0, 22, 1, -54), function() send("sell") end, C.gold)
local tabButtons, render = {}, nil
for i, category in ipairs({ "auger", "rod", "bait", "lure" }) do
    tabButtons[category] = button(tabs, string.upper(category) .. "S", UDim2.new(0.25, -6, 1, -8), UDim2.new((i - 1) * 0.25, 3, 0, 4), function()
        activeTab = category
        if render then render() end
    end, C.card)
end

local inspection = frame(modal, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), C.panel)
inspection.Visible = false
local inspectTitle = text(inspection, "EQUIPMENT", UDim2.new(1, -150, 0, 32), UDim2.fromOffset(22, 18), 22, C.gold)
inspectTitle.Font = Enum.Font.GothamBold
button(inspection, "BACK", UDim2.fromOffset(90, 34), UDim2.new(1, -112, 0, 18), function() inspection.Visible = false end, C.gold)
local inspectDescription = text(inspection, "", UDim2.new(1, -44, 0, 45), UDim2.fromOffset(22, 435), 15, C.muted)
text(inspection, "Drag to rotate  /  Scroll to zoom", UDim2.new(1, -44, 0, 24), UDim2.fromOffset(22, 493), 12, C.mint).TextXAlignment = Enum.TextXAlignment.Center
local function inspect(category, item)
    local old = inspection:FindFirstChild("EquipmentView")
    if old then old:Destroy() end
    inspectTitle.Text, inspectDescription.Text = item.name, item.description
    local viewport = make("ViewportFrame", inspection, { Name = "EquipmentView", Size = UDim2.new(1, -44, 0, 355), Position = UDim2.fromOffset(22, 68),
        BackgroundColor3 = C.dark, BorderSizePixel = 0 })
    rounded(viewport)
    Preview.mount(viewport, category, item.id)
    inspection.Visible = true
end

local function bagValue()
    local sum = 0
    if profile then for _, fish in ipairs(profile.bag) do sum = sum + fish.value end end
    return sum
end

render = function()
    for _, child in ipairs(list:GetChildren()) do if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end end
    if not profile then return end
    inspection.Visible = false
    local isShop = modalMode == "shop"
    tabs.Visible = isShop
    modalTitle.Text = isShop and "FROSTBITE TACKLE" or "YOUR FISH BAG"
    modalSubtitle.Text = isShop and ("Balance: " .. profile.coins .. " coins  /  Purchases auto-equip") or "Bring your catch to the cabin to sell it."
    list.Position = UDim2.fromOffset(22, isShop and 140 or 90)
    list.Size = UDim2.new(1, -44, 1, isShop and -208 or -158)
    sell.Text = "SELL ALL FISH  /  " .. bagValue() .. " COINS"
    for category, b in pairs(tabButtons) do
        b.BackgroundColor3 = category == activeTab and C.mint or C.card
        b.TextColor3 = category == activeTab and C.dark or C.muted
    end
    if isShop then
        for i, item in ipairs(Config.Gear[activeTab]) do
            local category = activeTab
            local card = frame(list, UDim2.new(1, 0, 0, 124), UDim2.fromOffset(0, 0), C.card)
            card.LayoutOrder = i
            local viewport = make("ViewportFrame", card, { Size = UDim2.fromOffset(88, 86), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.dark, BorderSizePixel = 0 })
            rounded(viewport, 8)
            Preview.mount(viewport, category, item.id)
            button(card, "3D VIEW", UDim2.fromOffset(88, 22), UDim2.fromOffset(8, 97), function() inspect(category, item) end, C.gold)
            text(card, item.name, UDim2.new(1, -270, 0, 28), UDim2.fromOffset(110, 8), 16).Font = Enum.Font.GothamBold
            text(card, item.description, UDim2.new(1, -276, 0, 40), UDim2.fromOffset(110, 38), 12, C.muted)
            text(card, Config.gearStats(category, item), UDim2.new(1, -276, 0, 37), UDim2.fromOffset(110, 82), 10, C.mint)
            local equipped = profile.equipped[category] == item.id
            local owned = category ~= "bait" and profile.owned[category][item.id]
            local stock = category == "bait" and (profile.bait[item.id] or 0) or 0
            local hasBait = category == "bait" and (item.amount == 0 or stock &gt; 0)
            local caption = equipped and "EQUIPPED" or ((owned or hasBait) and "EQUIP" or (item.cost .. " COINS"))
            local locked = not owned and (profile.level or 1) &lt; (item.requiredLevel or 1)
            if locked then caption = "LEVEL " .. item.requiredLevel end
            if category == "bait" and equipped and item.amount &gt; 0 then caption = "+10 / " .. item.cost .. " COINS" end
            button(card, caption, UDim2.fromOffset(136, 36), UDim2.new(1, -150, 0, 22), function()
                send("buy", { category = category, id = item.id, equip = hasBait and not equipped })
            end, equipped and C.gold or C.mint)
            if category == "bait" then
                text(card, item.amount == 0 and "Unlimited" or (stock .. " casts left"), UDim2.fromOffset(136, 22), UDim2.new(1, -150, 0, 63), 12, C.muted).TextXAlignment = Enum.TextXAlignment.Center
            end
        end
    else
        if #profile.bag == 0 then text(list, "Your next great catch is under the ice.", UDim2.new(1, 0, 0, 90), UDim2.fromOffset(0, 0), 18, C.muted) end
        for i = #profile.bag, 1, -1 do
            local fish = profile.bag[i]
            local card = frame(list, UDim2.new(1, 0, 0, 72), UDim2.fromOffset(0, 0), C.card)
            card.LayoutOrder = #profile.bag - i
            text(card, fish.name, UDim2.new(1, -150, 0, 30), UDim2.fromOffset(14, 7), 17, Color3.fromRGB(fish.color[1], fish.color[2], fish.color[3])).Font = Enum.Font.GothamBold
            text(card, fish.rarity .. "  /  " .. fish.kg .. " kg", UDim2.new(1, -150, 0, 23), UDim2.fromOffset(14, 39), 13, C.muted)
            text(card, fish.value .. " coins", UDim2.fromOffset(120, 40), UDim2.new(1, -132, 0, 16), 17, C.gold).TextXAlignment = Enum.TextXAlignment.Right
        end
    end
    list.CanvasPosition = Vector2.zero
end

openBag = function() modalMode = "bag" render() shade.Visible = true end

local reel = frame(gui, UDim2.fromOffset(490, 218), UDim2.new(0.5, -245, 1, -338))
reel.Visible = false
local reelTitle = text(reel, "WAITING FOR A BITE...", UDim2.new(1, -28, 0, 28), UDim2.fromOffset(14, 10), 17, C.gold)
reelTitle.Font, reelTitle.TextXAlignment = Enum.Font.GothamBold, Enum.TextXAlignment.Center
local track = frame(reel, UDim2.new(1, -44, 0, 40), UDim2.fromOffset(22, 48), C.dark)
track.ClipsDescendants = true
local zone = frame(track, UDim2.fromScale(0.23, 1), UDim2.fromScale(0.5, 0), C.mint)
zone.BackgroundTransparency, zone.AnchorPoint = 0.3, Vector2.new(0.5, 0)
local marker = frame(track, UDim2.new(0, 6, 1, -8), UDim2.new(0.5, 0, 0, 4), C.gold)
marker.AnchorPoint = Vector2.new(0.5, 0)
local caption = text(reel, "Keep the gold fish marker inside your green zone", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 92), 12, C.muted)
caption.TextXAlignment = Enum.TextXAlignment.Center
local progressBack = frame(reel, UDim2.new(0.64, -20, 0, 8), UDim2.fromOffset(22, 123), C.dark)
local progressFill = frame(progressBack, UDim2.fromScale(0.25, 1), UDim2.fromOffset(0, 0), C.mint)
local tensionBack = frame(reel, UDim2.new(0.3, 0, 0, 8), UDim2.new(0.66, 0, 0, 123), C.dark)
local tensionFill = frame(tensionBack, UDim2.fromScale(0, 1), UDim2.fromOffset(0, 0), C.red)
local progressLabel = text(reel, "CATCH PROGRESS", UDim2.fromOffset(180, 20), UDim2.fromOffset(22, 134), 10, C.muted)
local tensionLabel = text(reel, "LINE TENSION", UDim2.fromOffset(140, 20), UDim2.new(0.66, 0, 0, 134), 10, C.red)
local holdButton = button(reel, "HOLD / SPACE TO REEL", UDim2.new(1, -44, 0, 43), UDim2.fromOffset(22, 162), nil)

local function updateHeld()
    held = keyHeld or reelPointer ~= nil
    if token then send("input", { token = token, held = held }) end
end
local function lockJump()
    if jumpLock then return end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        jumpLock = { humanoid = humanoid, enabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping) }
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        humanoid.Jump = false
    end
    ContextActionService:BindActionAtPriority("FrostbiteReel", function(_, state)
        keyHeld = state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox()
        updateHeld()
        return Enum.ContextActionResult.Sink
    end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
end
local function releaseJump()
    ContextActionService:UnbindAction("FrostbiteReel")
    if jumpLock and jumpLock.humanoid.Parent then
        jumpLock.humanoid.Jump = false
        jumpLock.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, jumpLock.enabled)
    end
    jumpLock = nil
end
holdButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        reelPointer = input
        updateHeld()
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input == reelPointer or (reelPointer and input.UserInputType == Enum.UserInputType.MouseButton1) then reelPointer = nil updateHeld() end
end)
UserInputService.WindowFocusReleased:Connect(function() keyHeld, reelPointer = false, nil updateHeld() end)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.F then send(fishing and "cancel" or "cast")
    elseif input.KeyCode == Enum.KeyCode.G and not fishing then send("drill")
    elseif input.KeyCode == Enum.KeyCode.B then send("shop")
    elseif input.KeyCode == Enum.KeyCode.I then openBag() end
end)

local function endFishing()
    fishing, token, held, reel.Visible = false, nil, false, false
    keyHeld, reelPointer, reelView, drillingInfo = false, nil, nil, nil
    releaseJump()
    castButton.Text = "DRILL / CAST  [F]"
end
player.CharacterRemoving:Connect(endFishing)
local function drawReel(data)
    zone.Position, zone.Size = UDim2.fromScale(data.bar, 0), UDim2.fromScale(data.width, 1)
    marker.Position = UDim2.new(data.target, 0, 0, 4)
    progressFill.Size, tensionFill.Size = UDim2.fromScale(data.progress, 1), UDim2.fromScale(data.tension, 1)
end

event.OnClientEvent:Connect(function(kind, data)
    if kind == "profile" then
        profile = data
        local progress = Progression.describe(data.xp)
        levelLabel.Text = "Level " .. progress.level .. "  /  " .. progress.current .. " of " .. progress.required .. " XP"
        xpFill.Size = UDim2.fromScale(progress.fraction, 1)
        dataMode.Text = player:GetAttribute("DataMode") or "Saved progression"
        coins.Text, bagCount.Text = data.coins .. " coins", #data.bag .. " fish  /  " .. bagValue() .. " coin value"
        local names = {}
        for _, category in ipairs({ "auger", "rod", "lure", "bait" }) do
            table.insert(names, Config.gearName(category, data.equipped[category]))
        end
        loadout.Text = table.concat(names, "  /  ")
        if shade.Visible then render() end
    elseif kind == "notice" then notice(data)
    elseif kind == "shop" then modalMode = "shop" render() shade.Visible = true
    elseif kind == "stage" then
        drillingInfo = data.stage == "drilling" and data or nil
        progressLabel.Text = drillingInfo and "DRILL PROGRESS" or "CATCH PROGRESS"
        tensionLabel.Visible, tensionBack.Visible = false, false
        fishing, token, held, reelView = true, data.token, false, nil
        keyHeld, reelPointer = false, nil
        lockJump()
        shade.Visible, reel.Visible, track.Visible, holdButton.Visible = false, true, false, false
        if data.stage == "drilling" then
            reelTitle.Text, caption.Text = "CUTTING THROUGH THE ICE", "Your auger is making a permanent fishing hole."
        elseif data.stage == "casting" then
            reelTitle.Text, caption.Text = data.reused and "BACK TO YOUR FISHING SPOT" or "CASTING YOUR LINE", "Getting the line ready..."
        else reelTitle.Text, caption.Text = "LINE IN. TAKE A BREATH.", "Listening beneath the ice..." end
        progressFill.Size, tensionFill.Size = UDim2.fromScale(0, 1), UDim2.fromScale(0, 1)
        castButton.Text = "CANCEL CAST  [F]"
    elseif kind == "bite" and data.token == token then
        track.Visible, holdButton.Visible = true, true
        tensionLabel.Visible, tensionBack.Visible = true, true
        reelTitle.Text = "FISH ON!"
        caption.Text = "Hold to move right. Release to drift left. Follow the gold fish."
        reelView = Reel.newView(data)
        drawReel(Reel.viewStep(reelView, 0, held, workspace:GetServerTimeNow(), Config.Fishing))
    elseif kind == "reel" and data.token == token and reelView then
        Reel.receiveView(reelView, data, workspace:GetServerTimeNow(), held, Config.Fishing)
    elseif kind == "caught" then
        endFishing()
        notice("CAUGHT  " .. data.name .. "\n" .. data.rarity .. "  /  " .. data.kg .. " kg  /  " .. data.value .. " coins\n+" .. data.xp .. " XP" .. (data.discovery and "  /  NEW SPECIES" or "") .. (data.trophy and "  /  TROPHY" or ""), Color3.fromRGB(data.color[1], data.color[2], data.color[3]))
    elseif kind == "ended" then endFishing() notice(data) end
end)

local elapsed, lastViewport = 0, Vector2.zero
RunService.RenderStepped:Connect(function(dt)
    elapsed = elapsed + dt
    if drillingInfo then
        local progress = math.max(0, math.min(1, (workspace:GetServerTimeNow() - drillingInfo.startedAt) / drillingInfo.duration))
        progressFill.Size = UDim2.fromScale(progress, 1)
        caption.Text = "Drilling  " .. math.floor(progress * 100) .. "%  /  Reuse this hole for future casts"
    end
    if reelView then drawReel(Reel.viewStep(reelView, dt, held, workspace:GetServerTimeNow(), Config.Fishing)) end
    if shade.Visible then Preview.step(dt) end
    if token and elapsed &gt; 0.12 then
        elapsed = 0
        send("input", { token = token, held = held })
    end
    local camera = workspace.CurrentCamera
    if camera and camera.ViewportSize ~= lastViewport then
        lastViewport = camera.ViewportSize
        modalScale.Scale = math.min(1, (lastViewport.X - 24) / 650, (lastViewport.Y - 60) / 530)
        local scale = math.min(1, (lastViewport.X - 20) / 490)
        local ds = dock:FindFirstChildOfClass("UIScale") or make("UIScale", dock)
        local rs = reel:FindFirstChildOfClass("UIScale") or make("UIScale", reel)
        ds.Scale, rs.Scale = scale, scale
        dock.AnchorPoint, dock.Position = Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -12)
        reel.AnchorPoint, reel.Position = Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -24 - 126 * scale)
        guide.Visible = lastViewport.X &gt; 850 and lastViewport.Y &gt; 580
        brand.Visible = lastViewport.X &gt; 490
    end
end)

require(script.Parent:WaitForChild("AdminMenu")).start(gui, remotes)

-- Retry the handshake until the server has registered this player.
task.spawn(function()
    while not profile do send("ready") task.wait(1) end
end)
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX27">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>

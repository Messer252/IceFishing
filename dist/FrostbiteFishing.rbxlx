        <Properties>
          <string name="Name">AudioConfig</string>
          <ProtectedString name="Source">-- Upload assets/audio/*.wav to your experience owner/group and replace these
-- empty IDs with rbxassetid://NUMBER. Empty IDs safely use UI-only placeholders.
return {
    useBundledPlaceholders = true,
    drill = "", reel = "", splash = "", bite = "", catch = "", coins = "",
    purchase = "", level = "", discovery = "", wind = "", music = "",
}
